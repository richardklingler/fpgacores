{
  "files" : {
    "LICENSE.txt" : "GateLab 74xx Logic is dedicated to the public domain under CC0 1.0 Universal.\nTo the extent possible under law, the authors have waived all copyright and related or\nneighboring rights to these models. https://creativecommons.org/publicdomain/zero/1.0/\n",
    "cores/ic74x00/README.md" : "# 74x00 — quad 2-input NAND gate\n\nFour independent NAND gates, `Yn = ~(An & Bn)`, as in the 74LS00, 74HC00 and\n74HCT00. Used by GateLab's KiCad import: the package pin table in `core.json` maps KiCad's pin\nnumbers to the ports. Zero-delay model — for simulation and as an FPGA starting point; synthesis maps it to LUTs.\n",
    "cores/ic74x00/core.json" : "{\n  \"description\" : \"Four 2-input NAND gates (74LS00, 74HC00 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 319,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 4\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 308.7,\n      \"resources\" : {\n\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"LUT4\" : 4\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 137.5,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 4\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic74x00\",\n  \"keywords\" : [\n    \"74xx\",\n    \"7400\",\n    \"7400\",\n    \"nand\",\n    \"gate\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Vier NAND-Gatter mit 2 Eingängen (74LS00, 74HC00 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x00 vierfach NAND mit 2 Eingängen\"\n    }\n  },\n  \"name\" : \"74x00 quad 2-input NAND\",\n  \"ports\" : [\n    {\n      \"description\" : \"Gate 1, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A1\"\n    },\n    {\n      \"description\" : \"Gate 1, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B1\"\n    },\n    {\n      \"description\" : \"Gate 1, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y1\"\n    },\n    {\n      \"description\" : \"Gate 2, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A2\"\n    },\n    {\n      \"description\" : \"Gate 2, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B2\"\n    },\n    {\n      \"description\" : \"Gate 2, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y2\"\n    },\n    {\n      \"description\" : \"Gate 3, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A3\"\n    },\n    {\n      \"description\" : \"Gate 3, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B3\"\n    },\n    {\n      \"description\" : \"Gate 3, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y3\"\n    },\n    {\n      \"description\" : \"Gate 4, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A4\"\n    },\n    {\n      \"description\" : \"Gate 4, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B4\"\n    },\n    {\n      \"description\" : \"Gate 4, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y4\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"parts\" : [\n      \"74x00\"\n    ],\n    \"pins\" : {\n      \"1\" : \"A1\",\n      \"10\" : \"B3\",\n      \"11\" : \"Y4\",\n      \"12\" : \"A4\",\n      \"13\" : \"B4\",\n      \"2\" : \"B1\",\n      \"3\" : \"Y1\",\n      \"4\" : \"A2\",\n      \"5\" : \"B2\",\n      \"6\" : \"Y2\",\n      \"8\" : \"Y3\",\n      \"9\" : \"A3\"\n    }\n  },\n  \"top\" : \"ic74x00\",\n  \"version\" : \"1.0.1\"\n}\n",
    "cores/ic74x00/rtl/ic74x00.v" : "// 74x00: quad 2-input NAND gate (74LS00, 74HC00, 74HCT00 …).\n// Zero-delay model; pins: 1A 1B 1Y = 1 2 3, 2A 2B 2Y = 4 5 6, 3Y 3A 3B = 8 9 10, 4Y 4A 4B = 11 12 13.\n\n`timescale 1ns / 1ps\n\nmodule ic74x00 (\n    input  wire A1,\n    input  wire B1,\n    output wire Y1,\n    input  wire A2,\n    input  wire B2,\n    output wire Y2,\n    input  wire A3,\n    input  wire B3,\n    output wire Y3,\n    input  wire A4,\n    input  wire B4,\n    output wire Y4\n);\n    assign Y1 = ~(A1 & B1);\n    assign Y2 = ~(A2 & B2);\n    assign Y3 = ~(A3 & B3);\n    assign Y4 = ~(A4 & B4);\nendmodule\n",
    "cores/ic74x00/tb/ic74x00_tb.v" : "// Self-checking testbench for ic74x00: all 256 combinations of the four gates' inputs.\n\n`timescale 1ns / 1ps\n\nmodule ic74x00_tb;\n    reg  [3:0] a, b;\n    wire [3:0] y;\n\n    ic74x00 dut (.A1(a[0]), .B1(b[0]), .Y1(y[0]), .A2(a[1]), .B2(b[1]), .Y2(y[1]), .A3(a[2]), .B3(b[2]), .Y3(y[2]), .A4(a[3]), .B4(b[3]), .Y4(y[3]));\n\n    integer i, errors = 0;\n    initial begin\n        for (i = 0; i < 256; i = i + 1) begin\n            {a, b} = i[7:0];\n            #1;\n            if (y !== (~(a & b))) begin\n                $display(\"FAIL: a=%b b=%b gave y=%b, expected %b\", a, b, y, ~(a & b));\n                errors = errors + 1;\n            end\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #1000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x04/README.md" : "# 74x04 — hex inverter\n\nSix independent inverters, `Yn = ~An`, as in the 74LS04 and 74HC04. Used by GateLab's KiCad\nimport (package pin table in `core.json`). Zero-delay model.\n",
    "cores/ic74x04/core.json" : "{\n  \"description\" : \"Six inverters (74LS04, 74HC04 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 325.4,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 6\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 252.1,\n      \"resources\" : {\n\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"LUT4\" : 6\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 137.5,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 5\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic74x04\",\n  \"keywords\" : [\n    \"74xx\",\n    \"7404\",\n    \"inverter\",\n    \"not\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Sechs Inverter (74LS04, 74HC04 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x04 sechsfacher Inverter\"\n    }\n  },\n  \"name\" : \"74x04 hex inverter\",\n  \"ports\" : [\n    {\n      \"description\" : \"Inverter 1, input\",\n      \"dir\" : \"in\",\n      \"name\" : \"A1\"\n    },\n    {\n      \"description\" : \"Inverter 1, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y1\"\n    },\n    {\n      \"description\" : \"Inverter 2, input\",\n      \"dir\" : \"in\",\n      \"name\" : \"A2\"\n    },\n    {\n      \"description\" : \"Inverter 2, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y2\"\n    },\n    {\n      \"description\" : \"Inverter 3, input\",\n      \"dir\" : \"in\",\n      \"name\" : \"A3\"\n    },\n    {\n      \"description\" : \"Inverter 3, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y3\"\n    },\n    {\n      \"description\" : \"Inverter 4, input\",\n      \"dir\" : \"in\",\n      \"name\" : \"A4\"\n    },\n    {\n      \"description\" : \"Inverter 4, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y4\"\n    },\n    {\n      \"description\" : \"Inverter 5, input\",\n      \"dir\" : \"in\",\n      \"name\" : \"A5\"\n    },\n    {\n      \"description\" : \"Inverter 5, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y5\"\n    },\n    {\n      \"description\" : \"Inverter 6, input\",\n      \"dir\" : \"in\",\n      \"name\" : \"A6\"\n    },\n    {\n      \"description\" : \"Inverter 6, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y6\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"parts\" : [\n      \"74x04\"\n    ],\n    \"pins\" : {\n      \"1\" : \"A1\",\n      \"10\" : \"Y5\",\n      \"11\" : \"A5\",\n      \"12\" : \"Y6\",\n      \"13\" : \"A6\",\n      \"2\" : \"Y1\",\n      \"3\" : \"A2\",\n      \"4\" : \"Y2\",\n      \"5\" : \"A3\",\n      \"6\" : \"Y3\",\n      \"8\" : \"Y4\",\n      \"9\" : \"A4\"\n    }\n  },\n  \"top\" : \"ic74x04\",\n  \"version\" : \"1.0.1\"\n}\n",
    "cores/ic74x04/rtl/ic74x04.v" : "// 74x04: hex inverter (74LS04, 74HC04 …). Zero-delay model; pins: 1A 1Y = 1 2, 2A 2Y = 3 4,\n// 3A 3Y = 5 6, 4Y 4A = 8 9, 5Y 5A = 10 11, 6Y 6A = 12 13.\n\n`timescale 1ns / 1ps\n\nmodule ic74x04 (\n    input  wire A1,\n    output wire Y1,\n    input  wire A2,\n    output wire Y2,\n    input  wire A3,\n    output wire Y3,\n    input  wire A4,\n    output wire Y4,\n    input  wire A5,\n    output wire Y5,\n    input  wire A6,\n    output wire Y6\n);\n    assign Y1 = ~A1;\n    assign Y2 = ~A2;\n    assign Y3 = ~A3;\n    assign Y4 = ~A4;\n    assign Y5 = ~A5;\n    assign Y6 = ~A6;\nendmodule\n",
    "cores/ic74x04/tb/ic74x04_tb.v" : "// Self-checking testbench for ic74x04: all 64 combinations of the six inputs.\n\n`timescale 1ns / 1ps\n\nmodule ic74x04_tb;\n    reg  [5:0] a;\n    wire [5:0] y;\n\n    ic74x04 dut (.A1(a[0]), .Y1(y[0]), .A2(a[1]), .Y2(y[1]), .A3(a[2]), .Y3(y[2]), .A4(a[3]), .Y4(y[3]), .A5(a[4]), .Y5(y[4]), .A6(a[5]), .Y6(y[5]));\n\n    integer i, errors = 0;\n    initial begin\n        for (i = 0; i < 64; i = i + 1) begin\n            a = i[5:0];\n            #1;\n            if (y !== ~a) begin\n                $display(\"FAIL: a=%b gave y=%b, expected %b\", a, y, ~a);\n                errors = errors + 1;\n            end\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #1000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x08/README.md" : "# 74x08 — quad 2-input AND gate\n\nFour independent AND gates, `Yn = An & Bn`, as in the 74LS08, 74HC08 and\n74HCT08. Used by GateLab's KiCad import: the package pin table in `core.json` maps KiCad's pin\nnumbers to the ports. Zero-delay model — for simulation and as an FPGA starting point; synthesis maps it to LUTs.\n",
    "cores/ic74x08/core.json" : "{\n  \"description\" : \"Four 2-input AND gates (74LS08, 74HC08 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 319,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 4\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 241.8,\n      \"resources\" : {\n\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"LUT4\" : 4\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 137.5,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 4\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic74x08\",\n  \"keywords\" : [\n    \"74xx\",\n    \"7400\",\n    \"7408\",\n    \"and\",\n    \"gate\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Vier UND-Gatter mit 2 Eingängen (74LS08, 74HC08 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x08 vierfach UND mit 2 Eingängen\"\n    }\n  },\n  \"name\" : \"74x08 quad 2-input AND\",\n  \"ports\" : [\n    {\n      \"description\" : \"Gate 1, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A1\"\n    },\n    {\n      \"description\" : \"Gate 1, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B1\"\n    },\n    {\n      \"description\" : \"Gate 1, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y1\"\n    },\n    {\n      \"description\" : \"Gate 2, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A2\"\n    },\n    {\n      \"description\" : \"Gate 2, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B2\"\n    },\n    {\n      \"description\" : \"Gate 2, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y2\"\n    },\n    {\n      \"description\" : \"Gate 3, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A3\"\n    },\n    {\n      \"description\" : \"Gate 3, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B3\"\n    },\n    {\n      \"description\" : \"Gate 3, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y3\"\n    },\n    {\n      \"description\" : \"Gate 4, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A4\"\n    },\n    {\n      \"description\" : \"Gate 4, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B4\"\n    },\n    {\n      \"description\" : \"Gate 4, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y4\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"parts\" : [\n      \"74x08\"\n    ],\n    \"pins\" : {\n      \"1\" : \"A1\",\n      \"10\" : \"B3\",\n      \"11\" : \"Y4\",\n      \"12\" : \"A4\",\n      \"13\" : \"B4\",\n      \"2\" : \"B1\",\n      \"3\" : \"Y1\",\n      \"4\" : \"A2\",\n      \"5\" : \"B2\",\n      \"6\" : \"Y2\",\n      \"8\" : \"Y3\",\n      \"9\" : \"A3\"\n    }\n  },\n  \"top\" : \"ic74x08\",\n  \"version\" : \"1.0.1\"\n}\n",
    "cores/ic74x08/rtl/ic74x08.v" : "// 74x08: quad 2-input AND gate (74LS08, 74HC08, 74HCT08 …).\n// Zero-delay model; pins: 1A 1B 1Y = 1 2 3, 2A 2B 2Y = 4 5 6, 3Y 3A 3B = 8 9 10, 4Y 4A 4B = 11 12 13.\n\n`timescale 1ns / 1ps\n\nmodule ic74x08 (\n    input  wire A1,\n    input  wire B1,\n    output wire Y1,\n    input  wire A2,\n    input  wire B2,\n    output wire Y2,\n    input  wire A3,\n    input  wire B3,\n    output wire Y3,\n    input  wire A4,\n    input  wire B4,\n    output wire Y4\n);\n    assign Y1 = A1 & B1;\n    assign Y2 = A2 & B2;\n    assign Y3 = A3 & B3;\n    assign Y4 = A4 & B4;\nendmodule\n",
    "cores/ic74x08/tb/ic74x08_tb.v" : "// Self-checking testbench for ic74x08: all 256 combinations of the four gates' inputs.\n\n`timescale 1ns / 1ps\n\nmodule ic74x08_tb;\n    reg  [3:0] a, b;\n    wire [3:0] y;\n\n    ic74x08 dut (.A1(a[0]), .B1(b[0]), .Y1(y[0]), .A2(a[1]), .B2(b[1]), .Y2(y[1]), .A3(a[2]), .B3(b[2]), .Y3(y[2]), .A4(a[3]), .B4(b[3]), .Y4(y[3]));\n\n    integer i, errors = 0;\n    initial begin\n        for (i = 0; i < 256; i = i + 1) begin\n            {a, b} = i[7:0];\n            #1;\n            if (y !== (a & b)) begin\n                $display(\"FAIL: a=%b b=%b gave y=%b, expected %b\", a, b, y, a & b);\n                errors = errors + 1;\n            end\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #1000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x121/README.md" : "# 74x121 — one-shot (simulation model)\n\nStarts a pulse of `PULSE_NS` nanoseconds when `(A1 or A2 low) and B high` becomes true, and\nignores further triggers until it ends. On the real part the length comes from Rext/Cext\n(about 0.7 · R · C; pins 9–11, not modelled).\n\nThis model only simulates: the delay doesn't synthesize. On an FPGA, replace the one-shot with a\ncounter that runs for the same time on the design's clock — GateLab's KiCad import points this out\nand computes the time from the schematic's resistor and capacitor.\n",
    "cores/ic74x121/core.json" : "{\n  \"description\" : \"Monostable multivibrator, not retriggerable (74LS121): a simulation model only, with the pulse length as parameter (the delay doesn't synthesize; on an FPGA a counter replaces it), with the package pin table for the KiCad import.\",\n  \"id\" : \"ic74x121\",\n  \"keywords\" : [\n    \"74xx\",\n    \"74121\",\n    \"monostable\",\n    \"one-shot\",\n    \"monoflop\",\n    \"pulse\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Monostabile Kippstufe, nicht nachtriggerbar (74LS121): nur ein Simulationsmodell, mit der Pulslänge als Parameter (die Verzögerung lässt sich nicht synthetisieren; auf einem FPGA ersetzt sie ein Zähler), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x121 Monoflop\"\n    }\n  },\n  \"name\" : \"74x121 one-shot\",\n  \"parameters\" : [\n    {\n      \"default\" : 30,\n      \"description\" : \"Pulse length in nanoseconds (30 ns: internal resistor, no capacitor)\",\n      \"name\" : \"PULSE_NS\"\n    }\n  ],\n  \"ports\" : [\n    {\n      \"description\" : \"Trigger input, falling edge, active low\",\n      \"dir\" : \"in\",\n      \"name\" : \"A1\"\n    },\n    {\n      \"description\" : \"Trigger input, falling edge, active low\",\n      \"dir\" : \"in\",\n      \"name\" : \"A2\"\n    },\n    {\n      \"description\" : \"Trigger input, rising edge (Schmitt trigger on the real part)\",\n      \"dir\" : \"in\",\n      \"name\" : \"B\"\n    },\n    {\n      \"description\" : \"Pulse output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q\"\n    },\n    {\n      \"description\" : \"Inverted pulse output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q_n\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"oneShot\" : {\n      \"capacitorPins\" : [\n        \"10\",\n        \"11\"\n      ],\n      \"internalOhms\" : 2000,\n      \"internalResistorPin\" : \"9\",\n      \"parameter\" : \"PULSE_NS\",\n      \"resistorPin\" : \"11\",\n      \"unconnectedNanoseconds\" : 30\n    },\n    \"parts\" : [\n      \"74x121\"\n    ],\n    \"pins\" : {\n      \"1\" : \"Q_n\",\n      \"3\" : \"A1\",\n      \"4\" : \"A2\",\n      \"5\" : \"B\",\n      \"6\" : \"Q\"\n    }\n  },\n  \"simulationOnly\" : true,\n  \"top\" : \"ic74x121\",\n  \"version\" : \"1.0.1\"\n}\n",
    "cores/ic74x121/rtl/ic74x121.v" : "// 74x121: monostable multivibrator (one-shot), not retriggerable (74LS121 …).\n// A pulse of PULSE_NS starts when (A1 or A2 is low) and B is high becomes true. On the real part\n// the time comes from Rext/Cext (pins 9–11, about 0.7 · R · C); these analogue pins aren't modelled.\n// Simulation model only: the delay doesn't synthesize — on an FPGA a counter replaces it (the\n// KiCad import report says so and computes the time).\n// Pins: Q_n = 1, A1 A2 B Q = 3 4 5 6.\n\n`timescale 1ns / 1ps\n\nmodule ic74x121 #(\n    parameter PULSE_NS = 30\n) (\n    input  wire A1,\n    input  wire A2,\n    input  wire B,\n    output wire Q,\n    output wire Q_n\n);\n    reg pulse = 1'b0;\n    wire trigger = B && !(A1 && A2);\n\n    always @(posedge trigger)\n        if (!pulse) begin\n            pulse = 1'b1;\n            #(PULSE_NS) pulse = 1'b0;\n        end\n\n    assign Q = pulse;\n    assign Q_n = ~pulse;\nendmodule\n",
    "cores/ic74x121/tb/ic74x121_tb.v" : "// Self-checking testbench for ic74x121: the pulse length, the three ways to trigger it, no\n// trigger while A1 and A2 are high, and no retriggering during a pulse.\n\n`timescale 1ns / 1ps\n\nmodule ic74x121_tb;\n    reg a1 = 1, a2 = 1, b = 0;\n    wire q, q_n;\n\n    ic74x121 #(.PULSE_NS(100)) dut (.A1(a1), .A2(a2), .B(b), .Q(q), .Q_n(q_n));\n\n    integer errors = 0;\n    task check(input expected, input [8*32-1:0] what);\n        begin\n            if (q !== expected || q_n !== !expected) begin\n                $display(\"FAIL: %0s: Q=%b Q_n=%b, expected Q=%b\", what, q, q_n, expected);\n                errors = errors + 1;\n            end\n        end\n    endtask\n\n    initial begin\n        #10 check(0, \"idle\");\n        // B rises while A1 and A2 are high: no pulse.\n        b = 1; #10 check(0, \"B up with A1 A2 high\");\n        b = 0; #10;\n        // B rises with A1 low.\n        a1 = 0; #10 b = 1; #1 check(1, \"B up with A1 low\");\n        #98 check(1, \"after 99 ns\");\n        #2 check(0, \"after 101 ns\");\n        b = 0; a1 = 1; #50;\n        // A2 falls while A1 and B are high.\n        b = 1; #10 a2 = 0; #1 check(1, \"A2 down with B high\");\n        // Not retriggerable: another trigger edge during the pulse doesn't extend it.\n        #30 a2 = 1; #5 a2 = 0; #66 check(0, \"no retrigger: ended at 100 ns\");\n        a2 = 1; b = 0; #50;\n        // A1 falls while A2 and B are high.\n        b = 1; #10 a1 = 0; #1 check(1, \"A1 down with B high\");\n        #100 check(0, \"pulse over\");\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #1000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x138/README.md" : "# 74x138 — 3-to-8 decoder\n\nThe selected output `Y{A2 A1 A0}_n` goes low while `E1_n` and `E2_n` are low and `E3` is high;\notherwise all outputs are high. As in the 74LS138 and 74HC138 (KiCad names the pins A0–A2,\nE1–E3, O0–O7). Used by GateLab's KiCad import (package pin table in `core.json`).\n",
    "cores/ic74x138/core.json" : "{\n  \"description\" : \"3-to-8 line decoder with active-low outputs and three enables (74LS138, 74HC138 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 334.3,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 18\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 215,\n      \"resources\" : {\n        \"CPE_BRIDGE\" : 4,\n        \"CPE_CPLINES\" : 1,\n        \"CPE_LT\" : 11\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"LUT4\" : 9\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 137.5,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 10\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic74x138\",\n  \"keywords\" : [\n    \"74xx\",\n    \"74138\",\n    \"decoder\",\n    \"demultiplexer\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"3-zu-8-Decoder mit aktiv-low Ausgängen und drei Freigaben (74LS138, 74HC138 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x138 3-zu-8-Decoder\"\n    }\n  },\n  \"name\" : \"74x138 3-to-8 decoder\",\n  \"ports\" : [\n    {\n      \"description\" : \"Address, bit 0 (A)\",\n      \"dir\" : \"in\",\n      \"name\" : \"A0\"\n    },\n    {\n      \"description\" : \"Address, bit 1 (B)\",\n      \"dir\" : \"in\",\n      \"name\" : \"A1\"\n    },\n    {\n      \"description\" : \"Address, bit 2 (C)\",\n      \"dir\" : \"in\",\n      \"name\" : \"A2\"\n    },\n    {\n      \"description\" : \"Enable, active low (G2A)\",\n      \"dir\" : \"in\",\n      \"name\" : \"E1_n\"\n    },\n    {\n      \"description\" : \"Enable, active low (G2B)\",\n      \"dir\" : \"in\",\n      \"name\" : \"E2_n\"\n    },\n    {\n      \"description\" : \"Enable, active high (G1)\",\n      \"dir\" : \"in\",\n      \"name\" : \"E3\"\n    },\n    {\n      \"description\" : \"Output 0, low when selected\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y0_n\"\n    },\n    {\n      \"description\" : \"Output 1, low when selected\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y1_n\"\n    },\n    {\n      \"description\" : \"Output 2, low when selected\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y2_n\"\n    },\n    {\n      \"description\" : \"Output 3, low when selected\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y3_n\"\n    },\n    {\n      \"description\" : \"Output 4, low when selected\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y4_n\"\n    },\n    {\n      \"description\" : \"Output 5, low when selected\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y5_n\"\n    },\n    {\n      \"description\" : \"Output 6, low when selected\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y6_n\"\n    },\n    {\n      \"description\" : \"Output 7, low when selected\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y7_n\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"parts\" : [\n      \"74x138\"\n    ],\n    \"pins\" : {\n      \"1\" : \"A0\",\n      \"10\" : \"Y5_n\",\n      \"11\" : \"Y4_n\",\n      \"12\" : \"Y3_n\",\n      \"13\" : \"Y2_n\",\n      \"14\" : \"Y1_n\",\n      \"15\" : \"Y0_n\",\n      \"2\" : \"A1\",\n      \"3\" : \"A2\",\n      \"4\" : \"E1_n\",\n      \"5\" : \"E2_n\",\n      \"6\" : \"E3\",\n      \"7\" : \"Y7_n\",\n      \"9\" : \"Y6_n\"\n    }\n  },\n  \"top\" : \"ic74x138\",\n  \"version\" : \"1.0.1\"\n}\n",
    "cores/ic74x138/rtl/ic74x138.v" : "// 74x138: 3-to-8 line decoder, outputs active low (74LS138, 74HC138 …). Zero-delay model.\n// Pins: A0 A1 A2 = 1 2 3, E1_n E2_n E3 = 4 5 6, Y7_n = 7, Y6_n … Y0_n = 9 … 15.\n\n`timescale 1ns / 1ps\n\nmodule ic74x138 (\n    input  wire A0,\n    input  wire A1,\n    input  wire A2,\n    input  wire E1_n,\n    input  wire E2_n,\n    input  wire E3,\n    output wire Y0_n,\n    output wire Y1_n,\n    output wire Y2_n,\n    output wire Y3_n,\n    output wire Y4_n,\n    output wire Y5_n,\n    output wire Y6_n,\n    output wire Y7_n\n);\n    wire enabled = !E1_n && !E2_n && E3;\n    wire [7:0] selected = enabled ? (8'b1 << {A2, A1, A0}) : 8'b0;\n    assign {Y7_n, Y6_n, Y5_n, Y4_n, Y3_n, Y2_n, Y1_n, Y0_n} = ~selected;\nendmodule\n",
    "cores/ic74x138/tb/ic74x138_tb.v" : "// Self-checking testbench for ic74x138: all 64 combinations of address and enables.\n\n`timescale 1ns / 1ps\n\nmodule ic74x138_tb;\n    reg  [2:0] a;\n    reg  e1_n, e2_n, e3;\n    wire [7:0] y_n;\n\n    ic74x138 dut (.A0(a[0]), .A1(a[1]), .A2(a[2]), .E1_n(e1_n), .E2_n(e2_n), .E3(e3),\n                  .Y0_n(y_n[0]), .Y1_n(y_n[1]), .Y2_n(y_n[2]), .Y3_n(y_n[3]),\n                  .Y4_n(y_n[4]), .Y5_n(y_n[5]), .Y6_n(y_n[6]), .Y7_n(y_n[7]));\n\n    integer i, errors = 0;\n    reg [7:0] expected;\n    initial begin\n        for (i = 0; i < 64; i = i + 1) begin\n            {e3, e2_n, e1_n, a} = i[5:0];\n            #1;\n            expected = (!e1_n && !e2_n && e3) ? ~(8'b1 << a) : 8'hFF;\n            if (y_n !== expected) begin\n                $display(\"FAIL: A=%0d E1_n=%b E2_n=%b E3=%b gave %b, expected %b\", a, e1_n, e2_n, e3, y_n, expected);\n                errors = errors + 1;\n            end\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #1000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x161/README.md" : "# 74x161 — synchronous 4-bit binary counter\n\nCounts on the rising edge of `CP` while `CEP` and `CET` are high, loads `D3…D0` while `PE_n` is\nlow, and clears while `MR_n` is low — at once, without a clock (asynchronous clear, the difference to the 74x163).\n`TC` is high at count 15 while `CET` is high, for cascading. As in the 74LS161 and 74HC161. Used by\nGateLab's KiCad import (package pin table in `core.json`).\n",
    "cores/ic74x161/core.json" : "{\n  \"description\" : \"Synchronous 4-bit binary counter with asynchronous clear, load and two enables (74LS161, 74HC161 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 327.8,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 9,\n        \"TRELLIS_FF\" : 4\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 200.6,\n      \"resources\" : {\n        \"CPE_ADDF2\" : 2,\n        \"CPE_BRIDGE\" : 6,\n        \"CPE_CPLINES\" : 34,\n        \"CPE_FF\" : 4,\n        \"CPE_LT\" : 9,\n        \"CPE_RAMIO\" : 1\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"ALU\" : 6,\n        \"DFF\" : 4\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 136,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 12,\n        \"SB_GB\" : 1\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic74x161\",\n  \"keywords\" : [\n    \"74xx\",\n    \"74161\",\n    \"counter\",\n    \"binary\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Synchroner 4-Bit-Binärzähler mit asynchronem Löschen, Laden und zwei Freigaben (74LS161, 74HC161 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x161 4-Bit-Binärzähler\"\n    }\n  },\n  \"name\" : \"74x161 4-bit binary counter\",\n  \"ports\" : [\n    {\n      \"description\" : \"Clock (rising edge)\",\n      \"dir\" : \"in\",\n      \"name\" : \"CP\"\n    },\n    {\n      \"description\" : \"Master reset, asynchronous, active low (CLR)\",\n      \"dir\" : \"in\",\n      \"name\" : \"MR_n\"\n    },\n    {\n      \"description\" : \"Parallel load, synchronous, active low (LOAD)\",\n      \"dir\" : \"in\",\n      \"name\" : \"PE_n\"\n    },\n    {\n      \"description\" : \"Count enable (ENP)\",\n      \"dir\" : \"in\",\n      \"name\" : \"CEP\"\n    },\n    {\n      \"description\" : \"Count enable, also gates TC (ENT)\",\n      \"dir\" : \"in\",\n      \"name\" : \"CET\"\n    },\n    {\n      \"description\" : \"Load data, bit 0\",\n      \"dir\" : \"in\",\n      \"name\" : \"D0\"\n    },\n    {\n      \"description\" : \"Load data, bit 1\",\n      \"dir\" : \"in\",\n      \"name\" : \"D1\"\n    },\n    {\n      \"description\" : \"Load data, bit 2\",\n      \"dir\" : \"in\",\n      \"name\" : \"D2\"\n    },\n    {\n      \"description\" : \"Load data, bit 3\",\n      \"dir\" : \"in\",\n      \"name\" : \"D3\"\n    },\n    {\n      \"description\" : \"Count, bit 0\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q0\"\n    },\n    {\n      \"description\" : \"Count, bit 1\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q1\"\n    },\n    {\n      \"description\" : \"Count, bit 2\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q2\"\n    },\n    {\n      \"description\" : \"Count, bit 3\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q3\"\n    },\n    {\n      \"description\" : \"Terminal count: high at 15 while CET is high\",\n      \"dir\" : \"out\",\n      \"name\" : \"TC\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"asyncInputs\" : [\n      \"MR_n\"\n    ],\n    \"clocks\" : [\n      \"CP\"\n    ],\n    \"parts\" : [\n      \"74x161\"\n    ],\n    \"pins\" : {\n      \"1\" : \"MR_n\",\n      \"10\" : \"CET\",\n      \"11\" : \"Q3\",\n      \"12\" : \"Q2\",\n      \"13\" : \"Q1\",\n      \"14\" : \"Q0\",\n      \"15\" : \"TC\",\n      \"2\" : \"CP\",\n      \"3\" : \"D0\",\n      \"4\" : \"D1\",\n      \"5\" : \"D2\",\n      \"6\" : \"D3\",\n      \"7\" : \"CEP\",\n      \"9\" : \"PE_n\"\n    }\n  },\n  \"top\" : \"ic74x161\",\n  \"version\" : \"1.0.1\"\n}\n",
    "cores/ic74x161/rtl/ic74x161.v" : "// 74x161: synchronous 4-bit binary counter with asynchronous clear (74LS161, 74HC161 …).\n// Clear beats load beats count; counting needs CEP and CET; TC = CET at count 15.\n// Pins: MR_n CP D0 D1 D2 D3 CEP = 1 … 7, PE_n CET = 9 10, Q3 Q2 Q1 Q0 TC = 11 … 15.\n\n`timescale 1ns / 1ps\n\nmodule ic74x161 (\n    input  wire CP,\n    input  wire MR_n,\n    input  wire PE_n,\n    input  wire CEP,\n    input  wire CET,\n    input  wire D0,\n    input  wire D1,\n    input  wire D2,\n    input  wire D3,\n    output wire Q0,\n    output wire Q1,\n    output wire Q2,\n    output wire Q3,\n    output wire TC\n);\n    reg [3:0] count = 4'd0;\n\n    always @(posedge CP or negedge MR_n)\n        if (!MR_n) count <= 4'd0;\n        else if (!PE_n) count <= {D3, D2, D1, D0};\n        else if (CEP && CET) count <= count + 4'd1;\n\n    assign {Q3, Q2, Q1, Q0} = count;\n    assign TC = CET && (count == 4'hF);\nendmodule\n",
    "cores/ic74x161/tb/ic74x161_tb.v" : "// Self-checking testbench for ic74x161: load, count with both enables, hold with either low,\n// terminal count, wrap-around and the asynchronous clear.\n\n`timescale 1ns / 1ps\n\nmodule ic74x161_tb;\n    reg cp = 0, mr_n = 1, pe_n = 1, cep = 0, cet = 0;\n    reg [3:0] d = 4'd0;\n    wire [3:0] q;\n    wire tc;\n\n    ic74x161 dut (.CP(cp), .MR_n(mr_n), .PE_n(pe_n), .CEP(cep), .CET(cet),\n              .D0(d[0]), .D1(d[1]), .D2(d[2]), .D3(d[3]),\n              .Q0(q[0]), .Q1(q[1]), .Q2(q[2]), .Q3(q[3]), .TC(tc));\n\n    integer i, errors = 0;\n    task tick; begin #5 cp = 1; #5 cp = 0; #1; end endtask\n    task check(input [3:0] count, input terminal, input [8*32-1:0] what);\n        begin\n            if (q !== count || tc !== terminal) begin\n                $display(\"FAIL: %0s: Q=%0d TC=%b, expected Q=%0d TC=%b\", what, q, tc, count, terminal);\n                errors = errors + 1;\n            end\n        end\n    endtask\n\n    initial begin\n        mr_n = 0; tick; mr_n = 1;\n        check(4'd0, 0, \"reset\");\n        d = 4'd5; pe_n = 0; tick; pe_n = 1;\n        check(4'd5, 0, \"loaded 5\");\n        tick; check(4'd5, 0, \"no enables: hold\");\n        cep = 1; tick; check(4'd5, 0, \"CEP only: hold\");\n        cep = 0; cet = 1; tick; check(4'd5, 0, \"CET only: hold\");\n        // Asynchronous clear: at once, without a clock.\n        mr_n = 0; #1;\n        check(4'd0, 0, \"MR_n low, no clock\");\n        tick; check(4'd0, 0, \"MR_n low holds against the clock\");\n        mr_n = 1;\n        d = 4'd13; pe_n = 0; tick; pe_n = 1;\n        check(4'd13, 0, \"loaded 13, CET high\");\n        cep = 1;\n        tick; check(4'd14, 0, \"count 14\");\n        tick; check(4'd15, 1, \"count 15: TC\");\n        cet = 0; #1; check(4'd15, 0, \"TC follows CET\");\n        cet = 1; tick; check(4'd0, 0, \"wrapped to 0\");\n        for (i = 1; i <= 15; i = i + 1) tick;\n        check(4'd15, 1, \"counted around to 15\");\n        pe_n = 0; d = 4'd9; tick; pe_n = 1;\n        check(4'd9, 0, \"load beats count\");\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #1000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x163/README.md" : "# 74x163 — synchronous 4-bit binary counter\n\nCounts on the rising edge of `CP` while `CEP` and `CET` are high, loads `D3…D0` while `PE_n` is\nlow, and clears while `MR_n` is low — on the next clock edge (synchronous clear, the difference to the 74x161).\n`TC` is high at count 15 while `CET` is high, for cascading. As in the 74LS163 and 74HC163. Used by\nGateLab's KiCad import (package pin table in `core.json`).\n",
    "cores/ic74x163/core.json" : "{\n  \"description\" : \"Synchronous 4-bit binary counter with synchronous clear, load and two enables (74LS163, 74HC163 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 327.8,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 9,\n        \"TRELLIS_FF\" : 4\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 200,\n      \"resources\" : {\n        \"CPE_ADDF2\" : 2,\n        \"CPE_BRIDGE\" : 3,\n        \"CPE_CPLINES\" : 4,\n        \"CPE_FF\" : 4,\n        \"CPE_LT\" : 18,\n        \"CPE_RAMIO\" : 1\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"ALU\" : 6,\n        \"DFF\" : 4\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 137,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 12,\n        \"SB_GB\" : 1\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic74x163\",\n  \"keywords\" : [\n    \"74xx\",\n    \"74163\",\n    \"counter\",\n    \"binary\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Synchroner 4-Bit-Binärzähler mit synchronem Löschen, Laden und zwei Freigaben (74LS163, 74HC163 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x163 4-Bit-Binärzähler\"\n    }\n  },\n  \"name\" : \"74x163 4-bit binary counter\",\n  \"ports\" : [\n    {\n      \"description\" : \"Clock (rising edge)\",\n      \"dir\" : \"in\",\n      \"name\" : \"CP\"\n    },\n    {\n      \"description\" : \"Master reset, synchronous, active low (CLR)\",\n      \"dir\" : \"in\",\n      \"name\" : \"MR_n\"\n    },\n    {\n      \"description\" : \"Parallel load, synchronous, active low (LOAD)\",\n      \"dir\" : \"in\",\n      \"name\" : \"PE_n\"\n    },\n    {\n      \"description\" : \"Count enable (ENP)\",\n      \"dir\" : \"in\",\n      \"name\" : \"CEP\"\n    },\n    {\n      \"description\" : \"Count enable, also gates TC (ENT)\",\n      \"dir\" : \"in\",\n      \"name\" : \"CET\"\n    },\n    {\n      \"description\" : \"Load data, bit 0\",\n      \"dir\" : \"in\",\n      \"name\" : \"D0\"\n    },\n    {\n      \"description\" : \"Load data, bit 1\",\n      \"dir\" : \"in\",\n      \"name\" : \"D1\"\n    },\n    {\n      \"description\" : \"Load data, bit 2\",\n      \"dir\" : \"in\",\n      \"name\" : \"D2\"\n    },\n    {\n      \"description\" : \"Load data, bit 3\",\n      \"dir\" : \"in\",\n      \"name\" : \"D3\"\n    },\n    {\n      \"description\" : \"Count, bit 0\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q0\"\n    },\n    {\n      \"description\" : \"Count, bit 1\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q1\"\n    },\n    {\n      \"description\" : \"Count, bit 2\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q2\"\n    },\n    {\n      \"description\" : \"Count, bit 3\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q3\"\n    },\n    {\n      \"description\" : \"Terminal count: high at 15 while CET is high\",\n      \"dir\" : \"out\",\n      \"name\" : \"TC\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"clocks\" : [\n      \"CP\"\n    ],\n    \"parts\" : [\n      \"74x163\"\n    ],\n    \"pins\" : {\n      \"1\" : \"MR_n\",\n      \"10\" : \"CET\",\n      \"11\" : \"Q3\",\n      \"12\" : \"Q2\",\n      \"13\" : \"Q1\",\n      \"14\" : \"Q0\",\n      \"15\" : \"TC\",\n      \"2\" : \"CP\",\n      \"3\" : \"D0\",\n      \"4\" : \"D1\",\n      \"5\" : \"D2\",\n      \"6\" : \"D3\",\n      \"7\" : \"CEP\",\n      \"9\" : \"PE_n\"\n    }\n  },\n  \"top\" : \"ic74x163\",\n  \"version\" : \"1.0.1\"\n}\n",
    "cores/ic74x163/rtl/ic74x163.v" : "// 74x163: synchronous 4-bit binary counter with synchronous clear (74LS163, 74HC163 …).\n// Clear beats load beats count; counting needs CEP and CET; TC = CET at count 15.\n// Pins: MR_n CP D0 D1 D2 D3 CEP = 1 … 7, PE_n CET = 9 10, Q3 Q2 Q1 Q0 TC = 11 … 15.\n\n`timescale 1ns / 1ps\n\nmodule ic74x163 (\n    input  wire CP,\n    input  wire MR_n,\n    input  wire PE_n,\n    input  wire CEP,\n    input  wire CET,\n    input  wire D0,\n    input  wire D1,\n    input  wire D2,\n    input  wire D3,\n    output wire Q0,\n    output wire Q1,\n    output wire Q2,\n    output wire Q3,\n    output wire TC\n);\n    reg [3:0] count = 4'd0;\n\n    always @(posedge CP)\n        if (!MR_n) count <= 4'd0;\n        else if (!PE_n) count <= {D3, D2, D1, D0};\n        else if (CEP && CET) count <= count + 4'd1;\n\n    assign {Q3, Q2, Q1, Q0} = count;\n    assign TC = CET && (count == 4'hF);\nendmodule\n",
    "cores/ic74x163/tb/ic74x163_tb.v" : "// Self-checking testbench for ic74x163: load, count with both enables, hold with either low,\n// terminal count, wrap-around and the synchronous clear.\n\n`timescale 1ns / 1ps\n\nmodule ic74x163_tb;\n    reg cp = 0, mr_n = 1, pe_n = 1, cep = 0, cet = 0;\n    reg [3:0] d = 4'd0;\n    wire [3:0] q;\n    wire tc;\n\n    ic74x163 dut (.CP(cp), .MR_n(mr_n), .PE_n(pe_n), .CEP(cep), .CET(cet),\n              .D0(d[0]), .D1(d[1]), .D2(d[2]), .D3(d[3]),\n              .Q0(q[0]), .Q1(q[1]), .Q2(q[2]), .Q3(q[3]), .TC(tc));\n\n    integer i, errors = 0;\n    task tick; begin #5 cp = 1; #5 cp = 0; #1; end endtask\n    task check(input [3:0] count, input terminal, input [8*32-1:0] what);\n        begin\n            if (q !== count || tc !== terminal) begin\n                $display(\"FAIL: %0s: Q=%0d TC=%b, expected Q=%0d TC=%b\", what, q, tc, count, terminal);\n                errors = errors + 1;\n            end\n        end\n    endtask\n\n    initial begin\n        mr_n = 0; tick; mr_n = 1;\n        check(4'd0, 0, \"reset\");\n        d = 4'd5; pe_n = 0; tick; pe_n = 1;\n        check(4'd5, 0, \"loaded 5\");\n        tick; check(4'd5, 0, \"no enables: hold\");\n        cep = 1; tick; check(4'd5, 0, \"CEP only: hold\");\n        cep = 0; cet = 1; tick; check(4'd5, 0, \"CET only: hold\");\n        // Synchronous clear: nothing happens until the clock.\n        mr_n = 0; #1;\n        check(4'd5, 0, \"MR_n low, before the clock\");\n        tick; check(4'd0, 0, \"MR_n low, clocked\");\n        mr_n = 1;\n        d = 4'd13; pe_n = 0; tick; pe_n = 1;\n        check(4'd13, 0, \"loaded 13, CET high\");\n        cep = 1;\n        tick; check(4'd14, 0, \"count 14\");\n        tick; check(4'd15, 1, \"count 15: TC\");\n        cet = 0; #1; check(4'd15, 0, \"TC follows CET\");\n        cet = 1; tick; check(4'd0, 0, \"wrapped to 0\");\n        for (i = 1; i <= 15; i = i + 1) tick;\n        check(4'd15, 1, \"counted around to 15\");\n        pe_n = 0; d = 4'd9; tick; pe_n = 1;\n        check(4'd9, 0, \"load beats count\");\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #1000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x32/README.md" : "# 74x32 — quad 2-input OR gate\n\nFour independent OR gates, `Yn = An | Bn`, as in the 74LS32, 74HC32 and\n74HCT32. Used by GateLab's KiCad import: the package pin table in `core.json` maps KiCad's pin\nnumbers to the ports. Zero-delay model — for simulation and as an FPGA starting point; synthesis maps it to LUTs.\n",
    "cores/ic74x32/core.json" : "{\n  \"description\" : \"Four 2-input OR gates (74LS32, 74HC32 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 319,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 4\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 241.8,\n      \"resources\" : {\n\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"LUT4\" : 4\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 137.5,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 4\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic74x32\",\n  \"keywords\" : [\n    \"74xx\",\n    \"7400\",\n    \"7432\",\n    \"or\",\n    \"gate\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Vier ODER-Gatter mit 2 Eingängen (74LS32, 74HC32 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x32 vierfach ODER mit 2 Eingängen\"\n    }\n  },\n  \"name\" : \"74x32 quad 2-input OR\",\n  \"ports\" : [\n    {\n      \"description\" : \"Gate 1, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A1\"\n    },\n    {\n      \"description\" : \"Gate 1, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B1\"\n    },\n    {\n      \"description\" : \"Gate 1, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y1\"\n    },\n    {\n      \"description\" : \"Gate 2, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A2\"\n    },\n    {\n      \"description\" : \"Gate 2, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B2\"\n    },\n    {\n      \"description\" : \"Gate 2, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y2\"\n    },\n    {\n      \"description\" : \"Gate 3, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A3\"\n    },\n    {\n      \"description\" : \"Gate 3, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B3\"\n    },\n    {\n      \"description\" : \"Gate 3, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y3\"\n    },\n    {\n      \"description\" : \"Gate 4, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A4\"\n    },\n    {\n      \"description\" : \"Gate 4, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B4\"\n    },\n    {\n      \"description\" : \"Gate 4, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y4\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"parts\" : [\n      \"74x32\"\n    ],\n    \"pins\" : {\n      \"1\" : \"A1\",\n      \"10\" : \"B3\",\n      \"11\" : \"Y4\",\n      \"12\" : \"A4\",\n      \"13\" : \"B4\",\n      \"2\" : \"B1\",\n      \"3\" : \"Y1\",\n      \"4\" : \"A2\",\n      \"5\" : \"B2\",\n      \"6\" : \"Y2\",\n      \"8\" : \"Y3\",\n      \"9\" : \"A3\"\n    }\n  },\n  \"top\" : \"ic74x32\",\n  \"version\" : \"1.0.1\"\n}\n",
    "cores/ic74x32/rtl/ic74x32.v" : "// 74x32: quad 2-input OR gate (74LS32, 74HC32, 74HCT32 …).\n// Zero-delay model; pins: 1A 1B 1Y = 1 2 3, 2A 2B 2Y = 4 5 6, 3Y 3A 3B = 8 9 10, 4Y 4A 4B = 11 12 13.\n\n`timescale 1ns / 1ps\n\nmodule ic74x32 (\n    input  wire A1,\n    input  wire B1,\n    output wire Y1,\n    input  wire A2,\n    input  wire B2,\n    output wire Y2,\n    input  wire A3,\n    input  wire B3,\n    output wire Y3,\n    input  wire A4,\n    input  wire B4,\n    output wire Y4\n);\n    assign Y1 = A1 | B1;\n    assign Y2 = A2 | B2;\n    assign Y3 = A3 | B3;\n    assign Y4 = A4 | B4;\nendmodule\n",
    "cores/ic74x32/tb/ic74x32_tb.v" : "// Self-checking testbench for ic74x32: all 256 combinations of the four gates' inputs.\n\n`timescale 1ns / 1ps\n\nmodule ic74x32_tb;\n    reg  [3:0] a, b;\n    wire [3:0] y;\n\n    ic74x32 dut (.A1(a[0]), .B1(b[0]), .Y1(y[0]), .A2(a[1]), .B2(b[1]), .Y2(y[1]), .A3(a[2]), .B3(b[2]), .Y3(y[2]), .A4(a[3]), .B4(b[3]), .Y4(y[3]));\n\n    integer i, errors = 0;\n    initial begin\n        for (i = 0; i < 256; i = i + 1) begin\n            {a, b} = i[7:0];\n            #1;\n            if (y !== (a | b)) begin\n                $display(\"FAIL: a=%b b=%b gave y=%b, expected %b\", a, b, y, a | b);\n                errors = errors + 1;\n            end\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #1000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x74/README.md" : "# 74x74 — dual D flip-flop\n\nTwo positive-edge D flip-flops, each with an asynchronous preset and clear (active low), as in the\n74LS74 and 74HC74. Preset and clear low together drive both outputs high, like the real part.\nUsed by GateLab's KiCad import (package pin table in `core.json`).\n\nOn an FPGA, asynchronous preset/clear and flip-flops clocked by logic signals are fragile: the import\nreport points them out.\n",
    "cores/ic74x74/core.json" : "{\n  \"description\" : \"Two D flip-flops with asynchronous preset and clear (74LS74, 74HC74 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"tested\" : false\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 173.6,\n      \"resources\" : {\n        \"CPE_BRIDGE\" : 2,\n        \"CPE_CPLINES\" : 3,\n        \"CPE_FF\" : 6,\n        \"CPE_LT\" : 22,\n        \"CPE_RAMIO\" : 2\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"tested\" : false\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"tested\" : false\n    }\n  },\n  \"id\" : \"ic74x74\",\n  \"keywords\" : [\n    \"74xx\",\n    \"7474\",\n    \"flip-flop\",\n    \"register\",\n    \"d\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Zwei D-Flipflops mit asynchronem Setzen und Löschen (74LS74, 74HC74 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x74 zweifaches D-Flipflop\"\n    }\n  },\n  \"name\" : \"74x74 dual D flip-flop\",\n  \"ports\" : [\n    {\n      \"description\" : \"Flip-flop 1, data\",\n      \"dir\" : \"in\",\n      \"name\" : \"D1\"\n    },\n    {\n      \"description\" : \"Flip-flop 1, clock (rising edge)\",\n      \"dir\" : \"in\",\n      \"name\" : \"CLK1\"\n    },\n    {\n      \"description\" : \"Flip-flop 1, asynchronous preset, active low\",\n      \"dir\" : \"in\",\n      \"name\" : \"PRE1_n\"\n    },\n    {\n      \"description\" : \"Flip-flop 1, asynchronous clear, active low\",\n      \"dir\" : \"in\",\n      \"name\" : \"CLR1_n\"\n    },\n    {\n      \"description\" : \"Flip-flop 1, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q1\"\n    },\n    {\n      \"description\" : \"Flip-flop 1, inverted output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q1_n\"\n    },\n    {\n      \"description\" : \"Flip-flop 2, data\",\n      \"dir\" : \"in\",\n      \"name\" : \"D2\"\n    },\n    {\n      \"description\" : \"Flip-flop 2, clock (rising edge)\",\n      \"dir\" : \"in\",\n      \"name\" : \"CLK2\"\n    },\n    {\n      \"description\" : \"Flip-flop 2, asynchronous preset, active low\",\n      \"dir\" : \"in\",\n      \"name\" : \"PRE2_n\"\n    },\n    {\n      \"description\" : \"Flip-flop 2, asynchronous clear, active low\",\n      \"dir\" : \"in\",\n      \"name\" : \"CLR2_n\"\n    },\n    {\n      \"description\" : \"Flip-flop 2, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q2\"\n    },\n    {\n      \"description\" : \"Flip-flop 2, inverted output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q2_n\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"asyncInputs\" : [\n      \"PRE1_n\",\n      \"CLR1_n\",\n      \"PRE2_n\",\n      \"CLR2_n\"\n    ],\n    \"clocks\" : [\n      \"CLK1\",\n      \"CLK2\"\n    ],\n    \"parts\" : [\n      \"74x74\"\n    ],\n    \"pins\" : {\n      \"1\" : \"CLR1_n\",\n      \"10\" : \"PRE2_n\",\n      \"11\" : \"CLK2\",\n      \"12\" : \"D2\",\n      \"13\" : \"CLR2_n\",\n      \"2\" : \"D1\",\n      \"3\" : \"CLK1\",\n      \"4\" : \"PRE1_n\",\n      \"5\" : \"Q1\",\n      \"6\" : \"Q1_n\",\n      \"8\" : \"Q2_n\",\n      \"9\" : \"Q2\"\n    }\n  },\n  \"top\" : \"ic74x74\",\n  \"version\" : \"1.0.1\"\n}\n",
    "cores/ic74x74/rtl/ic74x74.v" : "// 74x74: dual D flip-flop with asynchronous preset and clear, both active low (74LS74, 74HC74 …).\n// With preset and clear low together both outputs are high, as on the real part.\n// Pins: 1CLR 1D 1CLK 1PRE 1Q 1Q_n = 1 2 3 4 5 6, 2Q_n 2Q 2PRE 2CLK 2D 2CLR = 8 9 10 11 12 13.\n\n`timescale 1ns / 1ps\n\nmodule ic74x74 (\n    input  wire D1,\n    input  wire CLK1,\n    input  wire PRE1_n,\n    input  wire CLR1_n,\n    output wire Q1,\n    output wire Q1_n,\n    input  wire D2,\n    input  wire CLK2,\n    input  wire PRE2_n,\n    input  wire CLR2_n,\n    output wire Q2,\n    output wire Q2_n\n);\n    reg q1 = 1'b0;\n    reg q2 = 1'b0;\n\n    always @(posedge CLK1 or negedge PRE1_n or negedge CLR1_n)\n        if (!CLR1_n) q1 <= 1'b0;\n        else if (!PRE1_n) q1 <= 1'b1;\n        else q1 <= D1;\n\n    always @(posedge CLK2 or negedge PRE2_n or negedge CLR2_n)\n        if (!CLR2_n) q2 <= 1'b0;\n        else if (!PRE2_n) q2 <= 1'b1;\n        else q2 <= D2;\n\n    assign Q1   = q1 | (!PRE1_n && !CLR1_n);\n    assign Q1_n = ~q1 | (!PRE1_n && !CLR1_n);\n    assign Q2   = q2 | (!PRE2_n && !CLR2_n);\n    assign Q2_n = ~q2 | (!PRE2_n && !CLR2_n);\nendmodule\n",
    "cores/ic74x74/tb/ic74x74_tb.v" : "// Self-checking testbench for ic74x74: clocking data in, asynchronous preset and clear (also\n// between clock edges), both together, and that the two flip-flops don't influence each other.\n\n`timescale 1ns / 1ps\n\nmodule ic74x74_tb;\n    reg d1 = 0, clk1 = 0, pre1 = 1, clr1 = 1;\n    reg d2 = 0, clk2 = 0, pre2 = 1, clr2 = 1;\n    wire q1, q1_n, q2, q2_n;\n\n    ic74x74 dut (.D1(d1), .CLK1(clk1), .PRE1_n(pre1), .CLR1_n(clr1), .Q1(q1), .Q1_n(q1_n),\n                 .D2(d2), .CLK2(clk2), .PRE2_n(pre2), .CLR2_n(clr2), .Q2(q2), .Q2_n(q2_n));\n\n    integer errors = 0;\n    task check(input e1, input e1n, input e2, input e2n, input [8*24-1:0] what);\n        begin\n            #1;\n            if ({q1, q1_n, q2, q2_n} !== {e1, e1n, e2, e2n}) begin\n                $display(\"FAIL: %0s: Q1 Q1_n Q2 Q2_n = %b%b%b%b, expected %b%b%b%b\", what, q1, q1_n, q2, q2_n, e1, e1n, e2, e2n);\n                errors = errors + 1;\n            end\n        end\n    endtask\n\n    task tick1; begin #5 clk1 = 1; #5 clk1 = 0; end endtask\n    task tick2; begin #5 clk2 = 1; #5 clk2 = 0; end endtask\n\n    initial begin\n        clr1 = 0; clr2 = 0; #5 clr1 = 1; clr2 = 1;\n        check(0, 1, 0, 1, \"cleared\");\n        d1 = 1; tick1;           check(1, 0, 0, 1, \"1D=1 clocked\");\n        d2 = 1;                  check(1, 0, 0, 1, \"2D=1, no clock yet\");\n        tick2;                   check(1, 0, 1, 0, \"2D=1 clocked\");\n        d1 = 0; tick1;           check(0, 1, 1, 0, \"1D=0 clocked\");\n        #3 pre1 = 0;             check(1, 0, 1, 0, \"1PRE low, no clock\");\n        tick1;                   check(1, 0, 1, 0, \"1PRE holds against D=0\");\n        pre1 = 1;                check(1, 0, 1, 0, \"1PRE released\");\n        #3 clr2 = 0;             check(1, 0, 0, 1, \"2CLR low, no clock\");\n        clr2 = 1; pre1 = 0; clr1 = 0; check(1, 1, 0, 1, \"1PRE and 1CLR both low\");\n        pre1 = 1; clr1 = 1;\n        d1 = 1; tick1;           check(1, 0, 0, 1, \"after both released, 1D=1 clocked\");\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #1000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "pack.json" : "{\n  \"description\" : \"Verilog models of classic 7400-series logic parts for the KiCad schematic import: each with the datasheet's port names, its package pin table and a self-checking testbench. CC0 1.0: no conditions, no attribution needed.\",\n  \"documentation\" : \"https://github.com/richardklingler/fpgacores\",\n  \"id\" : \"gatelab.logic74xx\",\n  \"maintainer\" : \"GateLab\",\n  \"name\" : \"GateLab 74xx Logic\",\n  \"schema\" : 1,\n  \"type\" : \"library\",\n  \"version\" : \"1.1.0\"\n}\n"
  },
  "schema" : 1
}
