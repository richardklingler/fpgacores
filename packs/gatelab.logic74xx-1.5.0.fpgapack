{
  "files" : {
    "LICENSE.txt" : "GateLab 74xx Logic is dedicated to the public domain under CC0 1.0 Universal.\nTo the extent possible under law, the authors have waived all copyright and related or\nneighboring rights to these models. https://creativecommons.org/publicdomain/zero/1.0/\n",
    "cores/ic4001/README.md" : "# 4001 — quad 2-input NOR\n\nFour NOR gates, `Y = NOT(A OR B)`, CMOS 4000 series (CD4001B, HEF4001B …). The pinout is the 74x00's\n(gate 1 on pins 1–3, gate 2's output on 4); KiCad leaves the gate pins unnamed, so the import maps\nthem by number. Used by GateLab's KiCad import (package pin table in `core.json`).\n",
    "cores/ic4001/core.json" : "{\n  \"description\" : \"Quad 2-input NOR gate, CMOS 4000 series (CD4001B, HEF4001B …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 314.2,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 4\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 213.3,\n      \"resources\" : {\n        \"CPE_BRIDGE\" : 1\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"LUT4\" : 4\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 136,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 4\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic4001\",\n  \"keywords\" : [\n    \"4000\",\n    \"cmos\",\n    \"4001\",\n    \"nor\",\n    \"gate\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Vierfaches NOR-Gatter mit zwei Eingängen, CMOS-4000-Serie (CD4001B, HEF4001B …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"4001 vierfaches NOR-Gatter\"\n    }\n  },\n  \"name\" : \"4001 quad 2-input NOR\",\n  \"ports\" : [\n    {\n      \"description\" : \"Gate 1, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A1\"\n    },\n    {\n      \"description\" : \"Gate 1, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B1\"\n    },\n    {\n      \"description\" : \"Gate 1, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y1\"\n    },\n    {\n      \"description\" : \"Gate 2, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A2\"\n    },\n    {\n      \"description\" : \"Gate 2, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B2\"\n    },\n    {\n      \"description\" : \"Gate 2, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y2\"\n    },\n    {\n      \"description\" : \"Gate 3, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A3\"\n    },\n    {\n      \"description\" : \"Gate 3, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B3\"\n    },\n    {\n      \"description\" : \"Gate 3, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y3\"\n    },\n    {\n      \"description\" : \"Gate 4, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A4\"\n    },\n    {\n      \"description\" : \"Gate 4, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B4\"\n    },\n    {\n      \"description\" : \"Gate 4, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y4\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"parts\" : [\n      \"4001\"\n    ],\n    \"pins\" : {\n      \"1\" : \"A1\",\n      \"10\" : \"Y3\",\n      \"11\" : \"Y4\",\n      \"12\" : \"A4\",\n      \"13\" : \"B4\",\n      \"2\" : \"B1\",\n      \"3\" : \"Y1\",\n      \"4\" : \"Y2\",\n      \"5\" : \"A2\",\n      \"6\" : \"B2\",\n      \"8\" : \"A3\",\n      \"9\" : \"B3\"\n    }\n  },\n  \"top\" : \"ic4001\",\n  \"version\" : \"1.0.0\"\n}\n",
    "cores/ic4001/rtl/ic4001.v" : "// 4001: quad 2-input NOR gate, CMOS (CD4001B, HEF4001B …).\n// Pins: A1 B1 Y1 Y2 A2 B2 = 1 … 6, A3 B3 Y3 Y4 A4 B4 = 8 … 13 (the same pinout as the 74x00).\n\n`timescale 1ns / 1ps\n\nmodule ic4001 (\n    input  wire A1,\n    input  wire B1,\n    output wire Y1,\n    input  wire A2,\n    input  wire B2,\n    output wire Y2,\n    input  wire A3,\n    input  wire B3,\n    output wire Y3,\n    input  wire A4,\n    input  wire B4,\n    output wire Y4\n);\n    assign Y1 = ~(A1 | B1);\n    assign Y2 = ~(A2 | B2);\n    assign Y3 = ~(A3 | B3);\n    assign Y4 = ~(A4 | B4);\nendmodule\n",
    "cores/ic4001/tb/ic4001_tb.v" : "// Self-checking testbench for ic4001: every input combination of all four gates (256 cases), so a\n// gate wired to its neighbour's inputs fails too.\n\n`timescale 1ns / 1ps\n\nmodule ic4001_tb;\n    reg  [3:0] a, b;\n    wire [3:0] y;\n\n    ic4001 dut (.A1(a[0]), .B1(b[0]), .Y1(y[0]), .A2(a[1]), .B2(b[1]), .Y2(y[1]), .A3(a[2]), .B3(b[2]), .Y3(y[2]), .A4(a[3]), .B4(b[3]), .Y4(y[3]));\n\n    integer i, errors = 0;\n    reg [3:0] expected;\n    initial begin\n        for (i = 0; i < 256; i = i + 1) begin\n            {b, a} = i[7:0];\n            #1;\n            expected = ~(a | b);\n            if (y !== expected) begin\n                $display(\"FAIL: A=%b B=%b gave Y=%b, expected %b\", a, b, y, expected);\n                errors = errors + 1;\n            end\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #10000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic4011/README.md" : "# 4011 — quad 2-input NAND\n\nFour NAND gates, `Y = NOT(A AND B)`, CMOS 4000 series (CD4011B, HEF4011B …). The pinout is the 74x00's\n(gate 1 on pins 1–3, gate 2's output on 4); KiCad leaves the gate pins unnamed, so the import maps\nthem by number. Used by GateLab's KiCad import (package pin table in `core.json`).\n",
    "cores/ic4011/core.json" : "{\n  \"description\" : \"Quad 2-input NAND gate, CMOS 4000 series (CD4011B, HEF4011B …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 314.2,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 4\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 213.3,\n      \"resources\" : {\n        \"CPE_BRIDGE\" : 1\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"LUT4\" : 4\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 136,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 4\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic4011\",\n  \"keywords\" : [\n    \"4000\",\n    \"cmos\",\n    \"4011\",\n    \"nand\",\n    \"gate\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Vierfaches NAND-Gatter mit zwei Eingängen, CMOS-4000-Serie (CD4011B, HEF4011B …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"4011 vierfaches NAND-Gatter\"\n    }\n  },\n  \"name\" : \"4011 quad 2-input NAND\",\n  \"ports\" : [\n    {\n      \"description\" : \"Gate 1, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A1\"\n    },\n    {\n      \"description\" : \"Gate 1, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B1\"\n    },\n    {\n      \"description\" : \"Gate 1, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y1\"\n    },\n    {\n      \"description\" : \"Gate 2, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A2\"\n    },\n    {\n      \"description\" : \"Gate 2, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B2\"\n    },\n    {\n      \"description\" : \"Gate 2, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y2\"\n    },\n    {\n      \"description\" : \"Gate 3, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A3\"\n    },\n    {\n      \"description\" : \"Gate 3, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B3\"\n    },\n    {\n      \"description\" : \"Gate 3, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y3\"\n    },\n    {\n      \"description\" : \"Gate 4, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A4\"\n    },\n    {\n      \"description\" : \"Gate 4, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B4\"\n    },\n    {\n      \"description\" : \"Gate 4, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y4\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"parts\" : [\n      \"4011\"\n    ],\n    \"pins\" : {\n      \"1\" : \"A1\",\n      \"10\" : \"Y3\",\n      \"11\" : \"Y4\",\n      \"12\" : \"A4\",\n      \"13\" : \"B4\",\n      \"2\" : \"B1\",\n      \"3\" : \"Y1\",\n      \"4\" : \"Y2\",\n      \"5\" : \"A2\",\n      \"6\" : \"B2\",\n      \"8\" : \"A3\",\n      \"9\" : \"B3\"\n    }\n  },\n  \"top\" : \"ic4011\",\n  \"version\" : \"1.0.0\"\n}\n",
    "cores/ic4011/rtl/ic4011.v" : "// 4011: quad 2-input NAND gate, CMOS (CD4011B, HEF4011B …).\n// Pins: A1 B1 Y1 Y2 A2 B2 = 1 … 6, A3 B3 Y3 Y4 A4 B4 = 8 … 13 (the same pinout as the 74x00).\n\n`timescale 1ns / 1ps\n\nmodule ic4011 (\n    input  wire A1,\n    input  wire B1,\n    output wire Y1,\n    input  wire A2,\n    input  wire B2,\n    output wire Y2,\n    input  wire A3,\n    input  wire B3,\n    output wire Y3,\n    input  wire A4,\n    input  wire B4,\n    output wire Y4\n);\n    assign Y1 = ~(A1 & B1);\n    assign Y2 = ~(A2 & B2);\n    assign Y3 = ~(A3 & B3);\n    assign Y4 = ~(A4 & B4);\nendmodule\n",
    "cores/ic4011/tb/ic4011_tb.v" : "// Self-checking testbench for ic4011: every input combination of all four gates (256 cases), so a\n// gate wired to its neighbour's inputs fails too.\n\n`timescale 1ns / 1ps\n\nmodule ic4011_tb;\n    reg  [3:0] a, b;\n    wire [3:0] y;\n\n    ic4011 dut (.A1(a[0]), .B1(b[0]), .Y1(y[0]), .A2(a[1]), .B2(b[1]), .Y2(y[1]), .A3(a[2]), .B3(b[2]), .Y3(y[2]), .A4(a[3]), .B4(b[3]), .Y4(y[3]));\n\n    integer i, errors = 0;\n    reg [3:0] expected;\n    initial begin\n        for (i = 0; i < 256; i = i + 1) begin\n            {b, a} = i[7:0];\n            #1;\n            expected = ~(a & b);\n            if (y !== expected) begin\n                $display(\"FAIL: A=%b B=%b gave Y=%b, expected %b\", a, b, y, expected);\n                errors = errors + 1;\n            end\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #10000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic4013/README.md" : "# 4013 — dual D flip-flop\n\nEach flip-flop takes `D` on the rising `CLK`. Set `S` and reset `R` are asynchronous and active\n**high** (the 74x74's are active low); with both high, `Q` and `Q_n` are both high. CMOS 4000 series\n(CD4013B, HEF4013B …; KiCad names the pins D, C, S, R, Q, ~Q). Used by GateLab's KiCad import.\n",
    "cores/ic4013/core.json" : "{\n  \"description\" : \"Dual D flip-flop with asynchronous set and reset (active high), CMOS 4000 series (CD4013B, HEF4013B …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"tested\" : false\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 166.1,\n      \"resources\" : {\n        \"CPE_BRIDGE\" : 7,\n        \"CPE_CPLINES\" : 6,\n        \"CPE_FF\" : 12,\n        \"CPE_LT\" : 26\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"tested\" : false\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"tested\" : false\n    }\n  },\n  \"id\" : \"ic4013\",\n  \"keywords\" : [\n    \"4000\",\n    \"cmos\",\n    \"4013\",\n    \"flip-flop\",\n    \"d flip-flop\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Doppeltes D-Flipflop mit asynchronem Setzen und Rücksetzen (aktiv high), CMOS-4000-Serie (CD4013B, HEF4013B …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"4013 doppeltes D-Flipflop\"\n    }\n  },\n  \"name\" : \"4013 dual D flip-flop\",\n  \"ports\" : [\n    {\n      \"description\" : \"Flip-flop 1, data\",\n      \"dir\" : \"in\",\n      \"name\" : \"D1\"\n    },\n    {\n      \"description\" : \"Flip-flop 1, clock, rising edge\",\n      \"dir\" : \"in\",\n      \"name\" : \"CLK1\"\n    },\n    {\n      \"description\" : \"Flip-flop 1, set, asynchronous, active high\",\n      \"dir\" : \"in\",\n      \"name\" : \"S1\"\n    },\n    {\n      \"description\" : \"Flip-flop 1, reset, asynchronous, active high\",\n      \"dir\" : \"in\",\n      \"name\" : \"R1\"\n    },\n    {\n      \"description\" : \"Flip-flop 1, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q1\"\n    },\n    {\n      \"description\" : \"Flip-flop 1, inverted output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q1_n\"\n    },\n    {\n      \"description\" : \"Flip-flop 2, data\",\n      \"dir\" : \"in\",\n      \"name\" : \"D2\"\n    },\n    {\n      \"description\" : \"Flip-flop 2, clock, rising edge\",\n      \"dir\" : \"in\",\n      \"name\" : \"CLK2\"\n    },\n    {\n      \"description\" : \"Flip-flop 2, set, asynchronous, active high\",\n      \"dir\" : \"in\",\n      \"name\" : \"S2\"\n    },\n    {\n      \"description\" : \"Flip-flop 2, reset, asynchronous, active high\",\n      \"dir\" : \"in\",\n      \"name\" : \"R2\"\n    },\n    {\n      \"description\" : \"Flip-flop 2, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q2\"\n    },\n    {\n      \"description\" : \"Flip-flop 2, inverted output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q2_n\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"asyncInputs\" : [\n      \"S1\",\n      \"R1\",\n      \"S2\",\n      \"R2\"\n    ],\n    \"clocks\" : [\n      \"CLK1\",\n      \"CLK2\"\n    ],\n    \"parts\" : [\n      \"4013\"\n    ],\n    \"pins\" : {\n      \"1\" : \"Q1\",\n      \"10\" : \"R2\",\n      \"11\" : \"CLK2\",\n      \"12\" : \"Q2_n\",\n      \"13\" : \"Q2\",\n      \"2\" : \"Q1_n\",\n      \"3\" : \"CLK1\",\n      \"4\" : \"R1\",\n      \"5\" : \"D1\",\n      \"6\" : \"S1\",\n      \"8\" : \"S2\",\n      \"9\" : \"D2\"\n    }\n  },\n  \"top\" : \"ic4013\",\n  \"version\" : \"1.0.0\"\n}\n",
    "cores/ic4013/rtl/ic4013.v" : "// 4013: dual D flip-flop with set and reset, CMOS (CD4013B, HEF4013B …). Rising CLK takes D. Set\n// and reset are asynchronous and active HIGH (unlike the 74x74); with both high, Q and Q_n are both\n// high, as on the real part.\n// Pins: Q1 Q1_n CLK1 R1 D1 S1 = 1 … 6, S2 D2 R2 CLK2 Q2_n Q2 = 8 … 13.\n\n`timescale 1ns / 1ps\n\nmodule ic4013 (\n    input  wire D1,\n    input  wire CLK1,\n    input  wire S1,\n    input  wire R1,\n    output wire Q1,\n    output wire Q1_n,\n    input  wire D2,\n    input  wire CLK2,\n    input  wire S2,\n    input  wire R2,\n    output wire Q2,\n    output wire Q2_n\n);\n    reg q1 = 1'b0;\n    reg q2 = 1'b0;\n\n    always @(posedge CLK1 or posedge S1 or posedge R1)\n        if (R1) q1 <= 1'b0;\n        else if (S1) q1 <= 1'b1;\n        else q1 <= D1;\n\n    always @(posedge CLK2 or posedge S2 or posedge R2)\n        if (R2) q2 <= 1'b0;\n        else if (S2) q2 <= 1'b1;\n        else q2 <= D2;\n\n    assign Q1   = q1 | (S1 && R1);\n    assign Q1_n = ~q1 | (S1 && R1);\n    assign Q2   = q2 | (S2 && R2);\n    assign Q2_n = ~q2 | (S2 && R2);\nendmodule\n",
    "cores/ic4013/tb/ic4013_tb.v" : "// Self-checking testbench for ic4013: 400 steps per flip-flop of pseudo-random D, clocks, sets and\n// resets (between edges) against a reference; both flip-flops at once, on different data, so one\n// following the other's inputs fails.\n\n`timescale 1ns / 1ps\n\nmodule ic4013_tb;\n    reg d1 = 0, clk1 = 0, s1 = 0, r1 = 0, d2 = 0, clk2 = 0, s2 = 0, r2 = 0;\n    wire q1, q1_n, q2, q2_n;\n\n    ic4013 dut (.D1(d1), .CLK1(clk1), .S1(s1), .R1(r1), .Q1(q1), .Q1_n(q1_n),\n                .D2(d2), .CLK2(clk2), .S2(s2), .R2(r2), .Q2(q2), .Q2_n(q2_n));\n\n    reg e1 = 0, e2 = 0;\n    reg [15:0] lfsr = 16'h4E7B;\n    integer i, errors = 0;\n\n    task check(input [255:0] what);\n        if (q1 !== (e1 | (s1 && r1)) || q1_n !== (!e1 | (s1 && r1)) || q2 !== (e2 | (s2 && r2)) || q2_n !== (!e2 | (s2 && r2))) begin\n            $display(\"FAIL: %0s: Q1=%b Q1_n=%b Q2=%b Q2_n=%b, expected Q1=%b Q2=%b (S1 R1=%b%b S2 R2=%b%b, t=%0t)\",\n                     what, q1, q1_n, q2, q2_n, e1, e2, s1, r1, s2, r2, $time);\n            errors = errors + 1;\n        end\n    endtask\n\n    initial begin\n        // Start from a known state.\n        r1 = 1; r2 = 1; #1 r1 = 0; r2 = 0;\n        for (i = 0; i < 400; i = i + 1) begin\n            lfsr = {lfsr[14:0], lfsr[15] ^ lfsr[13] ^ lfsr[12] ^ lfsr[10]};\n            d1 = lfsr[0]; d2 = ~lfsr[4];\n            #2 clk1 = 1; clk2 = lfsr[7];\n            e1 = d1; if (clk2) e2 = d2;\n            #1 check(\"after a clock\");\n            #2 clk1 = 0; clk2 = 0;\n            if (lfsr[11:9] == 3'b011) begin        // asynchronous set, reset or both, between edges\n                s1 = lfsr[1]; r1 = lfsr[2]; s2 = lfsr[5]; r2 = lfsr[6];\n                #1;\n                if (r1) e1 = 0; else if (s1) e1 = 1;\n                if (r2) e2 = 0; else if (s2) e2 = 1;\n                check(\"set or reset\");\n                // Set released before reset: after both at once the real part's state is undefined.\n                #1 s1 = 0; s2 = 0;\n                #1 check(\"set released\");\n                #1 r1 = 0; r2 = 0;\n                #1 check(\"released\");\n            end\n        end\n        // Directed: set and reset together on each flip-flop (both outputs high), set released first.\n        s1 = 1; r1 = 1; e1 = 0; #1 check(\"both on 1\");\n        s1 = 0; #1 check(\"set 1 released\"); r1 = 0; #1 check(\"reset 1 released\");\n        s2 = 1; r2 = 1; e2 = 0; #1 check(\"both on 2\");\n        s2 = 0; #1 check(\"set 2 released\"); r2 = 0; #1 check(\"reset 2 released\");\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #10000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic4017/README.md" : "# 4017 — decade counter with decoded outputs\n\nThe count advances on the rising edge of `CLK AND NOT INH`: `INH` (the clock inhibit; KiCad calls\nit CKEN) gates the clock, so a falling `INH` while `CLK` is high counts too. `RST` high clears to 0\nat once. Exactly one of `Q0`–`Q9` is high; `COUT` is high for counts 0–4. CMOS 4000 series\n(CD4017B, HEF4017B …). The real part is a Johnson counter with the same outputs. Used by GateLab's\nKiCad import (package pin table in `core.json`).\n",
    "cores/ic4017/core.json" : "{\n  \"description\" : \"Decade (Johnson) counter with ten decoded outputs, clock inhibit and carry out, CMOS 4000 series (CD4017B, HEF4017B …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 309.7,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 16,\n        \"TRELLIS_FF\" : 4\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 180.4,\n      \"resources\" : {\n        \"CPE_ADDF2\" : 2,\n        \"CPE_BRIDGE\" : 9,\n        \"CPE_FF\" : 6,\n        \"CPE_LT\" : 23,\n        \"CPE_RAMIO\" : 1\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"fmaxMHz\" : 251.8,\n      \"resources\" : {\n        \"ALU\" : 10,\n        \"DFF\" : 4\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 100.9,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 21,\n        \"SB_GB\" : 1\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic4017\",\n  \"keywords\" : [\n    \"4000\",\n    \"cmos\",\n    \"4017\",\n    \"counter\",\n    \"decade\",\n    \"johnson\",\n    \"decoder\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Dekadenzähler (Johnson) mit zehn dekodierten Ausgängen, Takt-Sperre und Übertragsausgang, CMOS-4000-Serie (CD4017B, HEF4017B …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"4017 Dekadenzähler mit dekodierten Ausgängen\"\n    }\n  },\n  \"name\" : \"4017 decade counter with decoded outputs\",\n  \"ports\" : [\n    {\n      \"description\" : \"Clock, rising edge (gated by INH)\",\n      \"dir\" : \"in\",\n      \"name\" : \"CLK\"\n    },\n    {\n      \"description\" : \"Clock inhibit, high blocks the clock (KiCad: CKEN)\",\n      \"dir\" : \"in\",\n      \"name\" : \"INH\"\n    },\n    {\n      \"description\" : \"Reset, asynchronous, active high: count 0\",\n      \"dir\" : \"in\",\n      \"name\" : \"RST\"\n    },\n    {\n      \"description\" : \"Decoded output 0: high at count 0\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q0\"\n    },\n    {\n      \"description\" : \"Decoded output 1: high at count 1\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q1\"\n    },\n    {\n      \"description\" : \"Decoded output 2: high at count 2\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q2\"\n    },\n    {\n      \"description\" : \"Decoded output 3: high at count 3\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q3\"\n    },\n    {\n      \"description\" : \"Decoded output 4: high at count 4\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q4\"\n    },\n    {\n      \"description\" : \"Decoded output 5: high at count 5\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q5\"\n    },\n    {\n      \"description\" : \"Decoded output 6: high at count 6\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q6\"\n    },\n    {\n      \"description\" : \"Decoded output 7: high at count 7\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q7\"\n    },\n    {\n      \"description\" : \"Decoded output 8: high at count 8\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q8\"\n    },\n    {\n      \"description\" : \"Decoded output 9: high at count 9\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q9\"\n    },\n    {\n      \"description\" : \"Carry out: high for counts 0–4\",\n      \"dir\" : \"out\",\n      \"name\" : \"COUT\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"asyncInputs\" : [\n      \"RST\"\n    ],\n    \"clocks\" : [\n      \"CLK\"\n    ],\n    \"parts\" : [\n      \"4017\"\n    ],\n    \"pins\" : {\n      \"1\" : \"Q5\",\n      \"10\" : \"Q4\",\n      \"11\" : \"Q9\",\n      \"12\" : \"COUT\",\n      \"13\" : \"INH\",\n      \"14\" : \"CLK\",\n      \"15\" : \"RST\",\n      \"2\" : \"Q1\",\n      \"3\" : \"Q0\",\n      \"4\" : \"Q2\",\n      \"5\" : \"Q6\",\n      \"6\" : \"Q7\",\n      \"7\" : \"Q3\",\n      \"9\" : \"Q8\"\n    }\n  },\n  \"top\" : \"ic4017\",\n  \"version\" : \"1.0.0\"\n}\n",
    "cores/ic4017/rtl/ic4017.v" : "// 4017: decade counter with ten decoded outputs, CMOS (CD4017B, HEF4017B …). The count advances on\n// the rising edge of CLK AND NOT INH (the clock inhibit — KiCad's CKEN — is a gated clock: a falling\n// INH while CLK is high counts too). RST high clears to 0 at once. Exactly one of Q0–Q9 is high;\n// COUT is high for counts 0–4 (one pulse per ten clocks). The real part is a Johnson counter; its\n// outputs are the same.\n// Pins: Q5 Q1 Q0 Q2 Q6 Q7 Q3 = 1 … 7, Q8 Q4 Q9 COUT INH CLK RST = 9 … 15.\n\n`timescale 1ns / 1ps\n\nmodule ic4017 (\n    input  wire CLK,\n    input  wire INH,\n    input  wire RST,\n    output wire Q0,\n    output wire Q1,\n    output wire Q2,\n    output wire Q3,\n    output wire Q4,\n    output wire Q5,\n    output wire Q6,\n    output wire Q7,\n    output wire Q8,\n    output wire Q9,\n    output wire COUT\n);\n    reg [3:0] count = 4'd0;\n    wire clock = CLK & ~INH;\n\n    always @(posedge clock or posedge RST)\n        if (RST) count <= 4'd0;\n        else count <= (count == 4'd9) ? 4'd0 : count + 4'd1;\n\n    wire [9:0] q = 10'b1 << count;\n    assign {Q9, Q8, Q7, Q6, Q5, Q4, Q3, Q2, Q1, Q0} = q;\n    assign COUT = count < 4'd5;\nendmodule\n",
    "cores/ic4017/tb/ic4017_tb.v" : "// Self-checking testbench for ic4017: 500 clocks with inhibits (changed only while CLK is low) and\n// resets between edges against a reference count; exactly the one decoded output, and COUT.\n\n`timescale 1ns / 1ps\n\nmodule ic4017_tb;\n    reg clk = 0, inh = 0, rst = 1;\n    wire [9:0] q;\n    wire cout;\n\n    ic4017 dut (.CLK(clk), .INH(inh), .RST(rst),\n                .Q0(q[0]), .Q1(q[1]), .Q2(q[2]), .Q3(q[3]), .Q4(q[4]),\n                .Q5(q[5]), .Q6(q[6]), .Q7(q[7]), .Q8(q[8]), .Q9(q[9]), .COUT(cout));\n\n    integer count = 0;\n    reg [15:0] lfsr = 16'h93E1;\n    integer i, errors = 0;\n\n    task check(input [255:0] what);\n        if (q !== (10'b1 << count) || cout !== (count < 5)) begin\n            $display(\"FAIL: %0s: Q9..Q0=%b COUT=%b, expected count %0d (t=%0t)\", what, q, cout, count, $time);\n            errors = errors + 1;\n        end\n    endtask\n\n    initial begin\n        #1 check(\"reset\");\n        rst = 0;\n        for (i = 0; i < 500; i = i + 1) begin\n            lfsr = {lfsr[14:0], lfsr[15] ^ lfsr[13] ^ lfsr[12] ^ lfsr[10]};\n            inh = lfsr[3] & lfsr[8];             // inhibited now and then\n            #2 clk = 1;\n            if (!inh) count = (count + 1) % 10;\n            #1 check(\"after a clock\");\n            #2 clk = 0;\n            if (lfsr[12:10] == 3'b110) begin     // reset between edges\n                #1 rst = 1; count = 0;\n                #1 check(\"reset\");\n                #1 rst = 0;\n            end\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #10000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic4040/README.md" : "# 4040 — 12-stage binary counter\n\nThe count (`Q0` is bit 0) advances on each **falling** edge of `CP`; `MR` high clears it at once.\nCMOS 4000 series (CD4040B, HEF4040B …; KiCad names the pins CLK, Reset, Q0–Q11). The real part is a\nripple counter — its outputs settle one stage after another, which is why decoding them glitches —\nwhile the model changes them together. On an FPGA, a synchronous counter replaces it. Used by\nGateLab's KiCad import (package pin table in `core.json`).\n",
    "cores/ic4040/core.json" : "{\n  \"description\" : \"12-stage binary ripple counter with asynchronous reset, CMOS 4000 series (CD4040B, HEF4040B …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 286,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 18,\n        \"TRELLIS_FF\" : 12\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 163.7,\n      \"resources\" : {\n        \"CPE_ADDF2\" : 6,\n        \"CPE_BRIDGE\" : 2,\n        \"CPE_CPLINES\" : 27,\n        \"CPE_FF\" : 13,\n        \"CPE_LT\" : 2\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"fmaxMHz\" : 82.6,\n      \"resources\" : {\n        \"ALU\" : 14,\n        \"DFF\" : 12\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 115.6,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 14\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic4040\",\n  \"keywords\" : [\n    \"4000\",\n    \"cmos\",\n    \"4040\",\n    \"counter\",\n    \"binary\",\n    \"ripple\",\n    \"divider\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"12-stufiger asynchroner Binärzähler (Ripple) mit asynchronem Rücksetzen, CMOS-4000-Serie (CD4040B, HEF4040B …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"4040 12-stufiger Binärzähler\"\n    }\n  },\n  \"name\" : \"4040 12-stage binary counter\",\n  \"ports\" : [\n    {\n      \"description\" : \"Clock, falling edge\",\n      \"dir\" : \"in\",\n      \"name\" : \"CP\"\n    },\n    {\n      \"description\" : \"Master reset, asynchronous, active high\",\n      \"dir\" : \"in\",\n      \"name\" : \"MR\"\n    },\n    {\n      \"description\" : \"Stage 0 (bit 0 of the count)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q0\"\n    },\n    {\n      \"description\" : \"Stage 1 (bit 1 of the count)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q1\"\n    },\n    {\n      \"description\" : \"Stage 2 (bit 2 of the count)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q2\"\n    },\n    {\n      \"description\" : \"Stage 3 (bit 3 of the count)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q3\"\n    },\n    {\n      \"description\" : \"Stage 4 (bit 4 of the count)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q4\"\n    },\n    {\n      \"description\" : \"Stage 5 (bit 5 of the count)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q5\"\n    },\n    {\n      \"description\" : \"Stage 6 (bit 6 of the count)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q6\"\n    },\n    {\n      \"description\" : \"Stage 7 (bit 7 of the count)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q7\"\n    },\n    {\n      \"description\" : \"Stage 8 (bit 8 of the count)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q8\"\n    },\n    {\n      \"description\" : \"Stage 9 (bit 9 of the count)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q9\"\n    },\n    {\n      \"description\" : \"Stage 10 (bit 10 of the count)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q10\"\n    },\n    {\n      \"description\" : \"Stage 11 (bit 11 of the count)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q11\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"asyncInputs\" : [\n      \"MR\"\n    ],\n    \"clocks\" : [\n      \"CP\"\n    ],\n    \"parts\" : [\n      \"4040\"\n    ],\n    \"pins\" : {\n      \"1\" : \"Q11\",\n      \"10\" : \"CP\",\n      \"11\" : \"MR\",\n      \"12\" : \"Q8\",\n      \"13\" : \"Q7\",\n      \"14\" : \"Q9\",\n      \"15\" : \"Q10\",\n      \"2\" : \"Q5\",\n      \"3\" : \"Q4\",\n      \"4\" : \"Q6\",\n      \"5\" : \"Q3\",\n      \"6\" : \"Q2\",\n      \"7\" : \"Q1\",\n      \"9\" : \"Q0\"\n    }\n  },\n  \"top\" : \"ic4040\",\n  \"version\" : \"1.0.0\"\n}\n",
    "cores/ic4040/rtl/ic4040.v" : "// 4040: 12-stage binary ripple counter, CMOS (CD4040B, HEF4040B …). The count advances on each\n// FALLING edge of CP; MR high clears it at once. The real part ripples (each stage clocks the next,\n// so the outputs settle one after another); the model changes them together.\n// Pins: Q11 Q5 Q4 Q6 Q3 Q2 Q1 = 1 … 7, Q0 CP MR Q8 Q7 Q9 Q10 = 9 … 15.\n\n`timescale 1ns / 1ps\n\nmodule ic4040 (\n    input  wire CP,\n    input  wire MR,\n    output wire Q0,\n    output wire Q1,\n    output wire Q2,\n    output wire Q3,\n    output wire Q4,\n    output wire Q5,\n    output wire Q6,\n    output wire Q7,\n    output wire Q8,\n    output wire Q9,\n    output wire Q10,\n    output wire Q11\n);\n    reg [11:0] count = 12'd0;\n\n    always @(negedge CP or posedge MR)\n        if (MR) count <= 12'd0;\n        else count <= count + 12'd1;\n\n    assign {Q11, Q10, Q9, Q8, Q7, Q6, Q5, Q4, Q3, Q2, Q1, Q0} = count;\nendmodule\n",
    "cores/ic4040/tb/ic4040_tb.v" : "// Self-checking testbench for ic4040: 5,000 falling edges (past a wrap of the low stages and well\n// into Q12's range) with resets between edges; nothing happens on rising edges.\n\n`timescale 1ns / 1ps\n\nmodule ic4040_tb;\n    reg cp = 1, mr = 1;\n    wire [11:0] q;\n\n    ic4040 dut (.CP(cp), .MR(mr), .Q0(q[0]), .Q1(q[1]), .Q2(q[2]), .Q3(q[3]), .Q4(q[4]), .Q5(q[5]), .Q6(q[6]), .Q7(q[7]), .Q8(q[8]), .Q9(q[9]), .Q10(q[10]), .Q11(q[11]));\n\n    reg [11:0] expected = 12'd0;\n    integer i, errors = 0;\n\n    task check(input [255:0] what);\n        if (q !== expected) begin\n            $display(\"FAIL: %0s: Q=%0d, expected %0d (t=%0t)\", what, q, expected, $time);\n            errors = errors + 1;\n        end\n    endtask\n\n    initial begin\n        #1 check(\"reset\");\n        mr = 0;\n        for (i = 0; i < 5000; i = i + 1) begin\n            #1 cp = 0;\n            expected = expected + 12'd1;\n            #1 check(\"after a falling edge\");\n            #1 cp = 1;\n            #1 check(\"rising edge\");\n            if (i == 4321) begin                  // a reset between edges, once\n                mr = 1; expected = 12'd0;\n                #1 check(\"reset\");\n                mr = 0;\n            end\n        end\n        // Up to the wrap: 4,096 more counts from here.\n        repeat (4096) begin #1 cp = 0; #1 cp = 1; end\n        #1 check(\"after a full wrap\");\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #10000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x00/README.md" : "# 74x00 — quad 2-input NAND gate\n\nFour independent NAND gates, `Yn = ~(An & Bn)`, as in the 74LS00, 74HC00 and\n74HCT00. Used by GateLab's KiCad import: the package pin table in `core.json` maps KiCad's pin\nnumbers to the ports. Zero-delay model — for simulation and as an FPGA starting point; synthesis maps it to LUTs.\n",
    "cores/ic74x00/core.json" : "{\n  \"description\" : \"Four 2-input NAND gates (74LS00, 74HC00 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 314.2,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 4\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 213.3,\n      \"resources\" : {\n        \"CPE_BRIDGE\" : 1\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"LUT4\" : 4\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 136,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 4\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic74x00\",\n  \"keywords\" : [\n    \"74xx\",\n    \"7400\",\n    \"7400\",\n    \"nand\",\n    \"gate\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Vier NAND-Gatter mit 2 Eingängen (74LS00, 74HC00 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x00 vierfach NAND mit 2 Eingängen\"\n    }\n  },\n  \"name\" : \"74x00 quad 2-input NAND\",\n  \"ports\" : [\n    {\n      \"description\" : \"Gate 1, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A1\"\n    },\n    {\n      \"description\" : \"Gate 1, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B1\"\n    },\n    {\n      \"description\" : \"Gate 1, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y1\"\n    },\n    {\n      \"description\" : \"Gate 2, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A2\"\n    },\n    {\n      \"description\" : \"Gate 2, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B2\"\n    },\n    {\n      \"description\" : \"Gate 2, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y2\"\n    },\n    {\n      \"description\" : \"Gate 3, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A3\"\n    },\n    {\n      \"description\" : \"Gate 3, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B3\"\n    },\n    {\n      \"description\" : \"Gate 3, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y3\"\n    },\n    {\n      \"description\" : \"Gate 4, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A4\"\n    },\n    {\n      \"description\" : \"Gate 4, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B4\"\n    },\n    {\n      \"description\" : \"Gate 4, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y4\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"parts\" : [\n      \"74x00\"\n    ],\n    \"pins\" : {\n      \"1\" : \"A1\",\n      \"10\" : \"B3\",\n      \"11\" : \"Y4\",\n      \"12\" : \"A4\",\n      \"13\" : \"B4\",\n      \"2\" : \"B1\",\n      \"3\" : \"Y1\",\n      \"4\" : \"A2\",\n      \"5\" : \"B2\",\n      \"6\" : \"Y2\",\n      \"8\" : \"Y3\",\n      \"9\" : \"A3\"\n    }\n  },\n  \"top\" : \"ic74x00\",\n  \"version\" : \"1.0.1\"\n}\n",
    "cores/ic74x00/rtl/ic74x00.v" : "// 74x00: quad 2-input NAND gate (74LS00, 74HC00, 74HCT00 …).\n// Zero-delay model; pins: 1A 1B 1Y = 1 2 3, 2A 2B 2Y = 4 5 6, 3Y 3A 3B = 8 9 10, 4Y 4A 4B = 11 12 13.\n\n`timescale 1ns / 1ps\n\nmodule ic74x00 (\n    input  wire A1,\n    input  wire B1,\n    output wire Y1,\n    input  wire A2,\n    input  wire B2,\n    output wire Y2,\n    input  wire A3,\n    input  wire B3,\n    output wire Y3,\n    input  wire A4,\n    input  wire B4,\n    output wire Y4\n);\n    assign Y1 = ~(A1 & B1);\n    assign Y2 = ~(A2 & B2);\n    assign Y3 = ~(A3 & B3);\n    assign Y4 = ~(A4 & B4);\nendmodule\n",
    "cores/ic74x00/tb/ic74x00_tb.v" : "// Self-checking testbench for ic74x00: all 256 combinations of the four gates' inputs.\n\n`timescale 1ns / 1ps\n\nmodule ic74x00_tb;\n    reg  [3:0] a, b;\n    wire [3:0] y;\n\n    ic74x00 dut (.A1(a[0]), .B1(b[0]), .Y1(y[0]), .A2(a[1]), .B2(b[1]), .Y2(y[1]), .A3(a[2]), .B3(b[2]), .Y3(y[2]), .A4(a[3]), .B4(b[3]), .Y4(y[3]));\n\n    integer i, errors = 0;\n    initial begin\n        for (i = 0; i < 256; i = i + 1) begin\n            {a, b} = i[7:0];\n            #1;\n            if (y !== (~(a & b))) begin\n                $display(\"FAIL: a=%b b=%b gave y=%b, expected %b\", a, b, y, ~(a & b));\n                errors = errors + 1;\n            end\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #1000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x04/README.md" : "# 74x04 — hex inverter\n\nSix independent inverters, `Yn = ~An`, as in the 74LS04 and 74HC04. Used by GateLab's KiCad\nimport (package pin table in `core.json`). Zero-delay model.\n",
    "cores/ic74x04/core.json" : "{\n  \"description\" : \"Six inverters (74LS04, 74HC04 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 331,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 6\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 181.8,\n      \"resources\" : {\n\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"LUT4\" : 6\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 136,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 6\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic74x04\",\n  \"keywords\" : [\n    \"74xx\",\n    \"7404\",\n    \"inverter\",\n    \"not\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Sechs Inverter (74LS04, 74HC04 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x04 sechsfacher Inverter\"\n    }\n  },\n  \"name\" : \"74x04 hex inverter\",\n  \"ports\" : [\n    {\n      \"description\" : \"Inverter 1, input\",\n      \"dir\" : \"in\",\n      \"name\" : \"A1\"\n    },\n    {\n      \"description\" : \"Inverter 1, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y1\"\n    },\n    {\n      \"description\" : \"Inverter 2, input\",\n      \"dir\" : \"in\",\n      \"name\" : \"A2\"\n    },\n    {\n      \"description\" : \"Inverter 2, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y2\"\n    },\n    {\n      \"description\" : \"Inverter 3, input\",\n      \"dir\" : \"in\",\n      \"name\" : \"A3\"\n    },\n    {\n      \"description\" : \"Inverter 3, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y3\"\n    },\n    {\n      \"description\" : \"Inverter 4, input\",\n      \"dir\" : \"in\",\n      \"name\" : \"A4\"\n    },\n    {\n      \"description\" : \"Inverter 4, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y4\"\n    },\n    {\n      \"description\" : \"Inverter 5, input\",\n      \"dir\" : \"in\",\n      \"name\" : \"A5\"\n    },\n    {\n      \"description\" : \"Inverter 5, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y5\"\n    },\n    {\n      \"description\" : \"Inverter 6, input\",\n      \"dir\" : \"in\",\n      \"name\" : \"A6\"\n    },\n    {\n      \"description\" : \"Inverter 6, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y6\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"parts\" : [\n      \"74x04\"\n    ],\n    \"pins\" : {\n      \"1\" : \"A1\",\n      \"10\" : \"Y5\",\n      \"11\" : \"A5\",\n      \"12\" : \"Y6\",\n      \"13\" : \"A6\",\n      \"2\" : \"Y1\",\n      \"3\" : \"A2\",\n      \"4\" : \"Y2\",\n      \"5\" : \"A3\",\n      \"6\" : \"Y3\",\n      \"8\" : \"Y4\",\n      \"9\" : \"A4\"\n    }\n  },\n  \"top\" : \"ic74x04\",\n  \"version\" : \"1.0.1\"\n}\n",
    "cores/ic74x04/rtl/ic74x04.v" : "// 74x04: hex inverter (74LS04, 74HC04 …). Zero-delay model; pins: 1A 1Y = 1 2, 2A 2Y = 3 4,\n// 3A 3Y = 5 6, 4Y 4A = 8 9, 5Y 5A = 10 11, 6Y 6A = 12 13.\n\n`timescale 1ns / 1ps\n\nmodule ic74x04 (\n    input  wire A1,\n    output wire Y1,\n    input  wire A2,\n    output wire Y2,\n    input  wire A3,\n    output wire Y3,\n    input  wire A4,\n    output wire Y4,\n    input  wire A5,\n    output wire Y5,\n    input  wire A6,\n    output wire Y6\n);\n    assign Y1 = ~A1;\n    assign Y2 = ~A2;\n    assign Y3 = ~A3;\n    assign Y4 = ~A4;\n    assign Y5 = ~A5;\n    assign Y6 = ~A6;\nendmodule\n",
    "cores/ic74x04/tb/ic74x04_tb.v" : "// Self-checking testbench for ic74x04: all 64 combinations of the six inputs.\n\n`timescale 1ns / 1ps\n\nmodule ic74x04_tb;\n    reg  [5:0] a;\n    wire [5:0] y;\n\n    ic74x04 dut (.A1(a[0]), .Y1(y[0]), .A2(a[1]), .Y2(y[1]), .A3(a[2]), .Y3(y[2]), .A4(a[3]), .Y4(y[3]), .A5(a[4]), .Y5(y[4]), .A6(a[5]), .Y6(y[5]));\n\n    integer i, errors = 0;\n    initial begin\n        for (i = 0; i < 64; i = i + 1) begin\n            a = i[5:0];\n            #1;\n            if (y !== ~a) begin\n                $display(\"FAIL: a=%b gave y=%b, expected %b\", a, y, ~a);\n                errors = errors + 1;\n            end\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #1000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x08/README.md" : "# 74x08 — quad 2-input AND gate\n\nFour independent AND gates, `Yn = An & Bn`, as in the 74LS08, 74HC08 and\n74HCT08. Used by GateLab's KiCad import: the package pin table in `core.json` maps KiCad's pin\nnumbers to the ports. Zero-delay model — for simulation and as an FPGA starting point; synthesis maps it to LUTs.\n",
    "cores/ic74x08/core.json" : "{\n  \"description\" : \"Four 2-input AND gates (74LS08, 74HC08 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 328.9,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 4\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 241.5,\n      \"resources\" : {\n        \"CPE_BRIDGE\" : 1\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"LUT4\" : 4\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 136,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 4\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic74x08\",\n  \"keywords\" : [\n    \"74xx\",\n    \"7400\",\n    \"7408\",\n    \"and\",\n    \"gate\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Vier UND-Gatter mit 2 Eingängen (74LS08, 74HC08 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x08 vierfach UND mit 2 Eingängen\"\n    }\n  },\n  \"name\" : \"74x08 quad 2-input AND\",\n  \"ports\" : [\n    {\n      \"description\" : \"Gate 1, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A1\"\n    },\n    {\n      \"description\" : \"Gate 1, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B1\"\n    },\n    {\n      \"description\" : \"Gate 1, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y1\"\n    },\n    {\n      \"description\" : \"Gate 2, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A2\"\n    },\n    {\n      \"description\" : \"Gate 2, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B2\"\n    },\n    {\n      \"description\" : \"Gate 2, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y2\"\n    },\n    {\n      \"description\" : \"Gate 3, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A3\"\n    },\n    {\n      \"description\" : \"Gate 3, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B3\"\n    },\n    {\n      \"description\" : \"Gate 3, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y3\"\n    },\n    {\n      \"description\" : \"Gate 4, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A4\"\n    },\n    {\n      \"description\" : \"Gate 4, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B4\"\n    },\n    {\n      \"description\" : \"Gate 4, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y4\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"parts\" : [\n      \"74x08\"\n    ],\n    \"pins\" : {\n      \"1\" : \"A1\",\n      \"10\" : \"B3\",\n      \"11\" : \"Y4\",\n      \"12\" : \"A4\",\n      \"13\" : \"B4\",\n      \"2\" : \"B1\",\n      \"3\" : \"Y1\",\n      \"4\" : \"A2\",\n      \"5\" : \"B2\",\n      \"6\" : \"Y2\",\n      \"8\" : \"Y3\",\n      \"9\" : \"A3\"\n    }\n  },\n  \"top\" : \"ic74x08\",\n  \"version\" : \"1.0.1\"\n}\n",
    "cores/ic74x08/rtl/ic74x08.v" : "// 74x08: quad 2-input AND gate (74LS08, 74HC08, 74HCT08 …).\n// Zero-delay model; pins: 1A 1B 1Y = 1 2 3, 2A 2B 2Y = 4 5 6, 3Y 3A 3B = 8 9 10, 4Y 4A 4B = 11 12 13.\n\n`timescale 1ns / 1ps\n\nmodule ic74x08 (\n    input  wire A1,\n    input  wire B1,\n    output wire Y1,\n    input  wire A2,\n    input  wire B2,\n    output wire Y2,\n    input  wire A3,\n    input  wire B3,\n    output wire Y3,\n    input  wire A4,\n    input  wire B4,\n    output wire Y4\n);\n    assign Y1 = A1 & B1;\n    assign Y2 = A2 & B2;\n    assign Y3 = A3 & B3;\n    assign Y4 = A4 & B4;\nendmodule\n",
    "cores/ic74x08/tb/ic74x08_tb.v" : "// Self-checking testbench for ic74x08: all 256 combinations of the four gates' inputs.\n\n`timescale 1ns / 1ps\n\nmodule ic74x08_tb;\n    reg  [3:0] a, b;\n    wire [3:0] y;\n\n    ic74x08 dut (.A1(a[0]), .B1(b[0]), .Y1(y[0]), .A2(a[1]), .B2(b[1]), .Y2(y[1]), .A3(a[2]), .B3(b[2]), .Y3(y[2]), .A4(a[3]), .B4(b[3]), .Y4(y[3]));\n\n    integer i, errors = 0;\n    initial begin\n        for (i = 0; i < 256; i = i + 1) begin\n            {a, b} = i[7:0];\n            #1;\n            if (y !== (a & b)) begin\n                $display(\"FAIL: a=%b b=%b gave y=%b, expected %b\", a, b, y, a & b);\n                errors = errors + 1;\n            end\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #1000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x121/README.md" : "# 74x121 — one-shot (simulation model)\n\nStarts a pulse of `PULSE_NS` nanoseconds when `(A1 or A2 low) and B high` becomes true, and\nignores further triggers until it ends. On the real part the length comes from Rext/Cext\n(about 0.7 · R · C; pins 9–11, not modelled).\n\nThis model only simulates: the delay doesn't synthesize. On an FPGA, replace the one-shot with a\ncounter that runs for the same time on the design's clock — GateLab's KiCad import points this out\nand computes the time from the schematic's resistor and capacitor.\n",
    "cores/ic74x121/core.json" : "{\n  \"description\" : \"Monostable multivibrator, not retriggerable (74LS121): a simulation model only, with the pulse length as parameter (the delay doesn't synthesize; on an FPGA a counter replaces it), with the package pin table for the KiCad import.\",\n  \"id\" : \"ic74x121\",\n  \"keywords\" : [\n    \"74xx\",\n    \"74121\",\n    \"monostable\",\n    \"one-shot\",\n    \"monoflop\",\n    \"pulse\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Monostabile Kippstufe, nicht nachtriggerbar (74LS121): nur ein Simulationsmodell, mit der Pulslänge als Parameter (die Verzögerung lässt sich nicht synthetisieren; auf einem FPGA ersetzt sie ein Zähler), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x121 Monoflop\"\n    }\n  },\n  \"name\" : \"74x121 one-shot\",\n  \"parameters\" : [\n    {\n      \"default\" : 30,\n      \"description\" : \"Pulse length in nanoseconds (30 ns: internal resistor, no capacitor)\",\n      \"name\" : \"PULSE_NS\"\n    }\n  ],\n  \"ports\" : [\n    {\n      \"description\" : \"Trigger input, falling edge, active low\",\n      \"dir\" : \"in\",\n      \"name\" : \"A1\"\n    },\n    {\n      \"description\" : \"Trigger input, falling edge, active low\",\n      \"dir\" : \"in\",\n      \"name\" : \"A2\"\n    },\n    {\n      \"description\" : \"Trigger input, rising edge (Schmitt trigger on the real part)\",\n      \"dir\" : \"in\",\n      \"name\" : \"B\"\n    },\n    {\n      \"description\" : \"Pulse output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q\"\n    },\n    {\n      \"description\" : \"Inverted pulse output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q_n\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"oneShot\" : {\n      \"capacitorPins\" : [\n        \"10\",\n        \"11\"\n      ],\n      \"internalOhms\" : 2000,\n      \"internalResistorPin\" : \"9\",\n      \"parameter\" : \"PULSE_NS\",\n      \"resistorPin\" : \"11\",\n      \"unconnectedNanoseconds\" : 30\n    },\n    \"parts\" : [\n      \"74x121\"\n    ],\n    \"pins\" : {\n      \"1\" : \"Q_n\",\n      \"3\" : \"A1\",\n      \"4\" : \"A2\",\n      \"5\" : \"B\",\n      \"6\" : \"Q\"\n    }\n  },\n  \"simulationOnly\" : true,\n  \"top\" : \"ic74x121\",\n  \"version\" : \"1.0.1\"\n}\n",
    "cores/ic74x121/rtl/ic74x121.v" : "// 74x121: monostable multivibrator (one-shot), not retriggerable (74LS121 …).\n// A pulse of PULSE_NS starts when (A1 or A2 is low) and B is high becomes true. On the real part\n// the time comes from Rext/Cext (pins 9–11, about 0.7 · R · C); these analogue pins aren't modelled.\n// Simulation model only: the delay doesn't synthesize — on an FPGA a counter replaces it (the\n// KiCad import report says so and computes the time).\n// Pins: Q_n = 1, A1 A2 B Q = 3 4 5 6.\n\n`timescale 1ns / 1ps\n\nmodule ic74x121 #(\n    parameter PULSE_NS = 30\n) (\n    input  wire A1,\n    input  wire A2,\n    input  wire B,\n    output wire Q,\n    output wire Q_n\n);\n    reg pulse = 1'b0;\n    wire trigger = B && !(A1 && A2);\n\n    always @(posedge trigger)\n        if (!pulse) begin\n            pulse = 1'b1;\n            #(PULSE_NS) pulse = 1'b0;\n        end\n\n    assign Q = pulse;\n    assign Q_n = ~pulse;\nendmodule\n",
    "cores/ic74x121/tb/ic74x121_tb.v" : "// Self-checking testbench for ic74x121: the pulse length, the three ways to trigger it, no\n// trigger while A1 and A2 are high, and no retriggering during a pulse.\n\n`timescale 1ns / 1ps\n\nmodule ic74x121_tb;\n    reg a1 = 1, a2 = 1, b = 0;\n    wire q, q_n;\n\n    ic74x121 #(.PULSE_NS(100)) dut (.A1(a1), .A2(a2), .B(b), .Q(q), .Q_n(q_n));\n\n    integer errors = 0;\n    task check(input expected, input [8*32-1:0] what);\n        begin\n            if (q !== expected || q_n !== !expected) begin\n                $display(\"FAIL: %0s: Q=%b Q_n=%b, expected Q=%b\", what, q, q_n, expected);\n                errors = errors + 1;\n            end\n        end\n    endtask\n\n    initial begin\n        #10 check(0, \"idle\");\n        // B rises while A1 and A2 are high: no pulse.\n        b = 1; #10 check(0, \"B up with A1 A2 high\");\n        b = 0; #10;\n        // B rises with A1 low.\n        a1 = 0; #10 b = 1; #1 check(1, \"B up with A1 low\");\n        #98 check(1, \"after 99 ns\");\n        #2 check(0, \"after 101 ns\");\n        b = 0; a1 = 1; #50;\n        // A2 falls while A1 and B are high.\n        b = 1; #10 a2 = 0; #1 check(1, \"A2 down with B high\");\n        // Not retriggerable: another trigger edge during the pulse doesn't extend it.\n        #30 a2 = 1; #5 a2 = 0; #66 check(0, \"no retrigger: ended at 100 ns\");\n        a2 = 1; b = 0; #50;\n        // A1 falls while A2 and B are high.\n        b = 1; #10 a1 = 0; #1 check(1, \"A1 down with B high\");\n        #100 check(0, \"pulse over\");\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #1000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x138/README.md" : "# 74x138 — 3-to-8 decoder\n\nThe selected output `Y{A2 A1 A0}_n` goes low while `E1_n` and `E2_n` are low and `E3` is high;\notherwise all outputs are high. As in the 74LS138 and 74HC138 (KiCad names the pins A0–A2,\nE1–E3, O0–O7). Used by GateLab's KiCad import (package pin table in `core.json`).\n",
    "cores/ic74x138/core.json" : "{\n  \"description\" : \"3-to-8 line decoder with active-low outputs and three enables (74LS138, 74HC138 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 330.5,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 20\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 244.1,\n      \"resources\" : {\n        \"CPE_BRIDGE\" : 6,\n        \"CPE_CPLINES\" : 4,\n        \"CPE_FF\" : 6,\n        \"CPE_LT\" : 19\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"LUT4\" : 9\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 136,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 10\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic74x138\",\n  \"keywords\" : [\n    \"74xx\",\n    \"74138\",\n    \"decoder\",\n    \"demultiplexer\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"3-zu-8-Decoder mit aktiv-low Ausgängen und drei Freigaben (74LS138, 74HC138 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x138 3-zu-8-Decoder\"\n    }\n  },\n  \"name\" : \"74x138 3-to-8 decoder\",\n  \"ports\" : [\n    {\n      \"description\" : \"Address, bit 0 (A)\",\n      \"dir\" : \"in\",\n      \"name\" : \"A0\"\n    },\n    {\n      \"description\" : \"Address, bit 1 (B)\",\n      \"dir\" : \"in\",\n      \"name\" : \"A1\"\n    },\n    {\n      \"description\" : \"Address, bit 2 (C)\",\n      \"dir\" : \"in\",\n      \"name\" : \"A2\"\n    },\n    {\n      \"description\" : \"Enable, active low (G2A)\",\n      \"dir\" : \"in\",\n      \"name\" : \"E1_n\"\n    },\n    {\n      \"description\" : \"Enable, active low (G2B)\",\n      \"dir\" : \"in\",\n      \"name\" : \"E2_n\"\n    },\n    {\n      \"description\" : \"Enable, active high (G1)\",\n      \"dir\" : \"in\",\n      \"name\" : \"E3\"\n    },\n    {\n      \"description\" : \"Output 0, low when selected\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y0_n\"\n    },\n    {\n      \"description\" : \"Output 1, low when selected\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y1_n\"\n    },\n    {\n      \"description\" : \"Output 2, low when selected\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y2_n\"\n    },\n    {\n      \"description\" : \"Output 3, low when selected\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y3_n\"\n    },\n    {\n      \"description\" : \"Output 4, low when selected\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y4_n\"\n    },\n    {\n      \"description\" : \"Output 5, low when selected\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y5_n\"\n    },\n    {\n      \"description\" : \"Output 6, low when selected\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y6_n\"\n    },\n    {\n      \"description\" : \"Output 7, low when selected\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y7_n\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"parts\" : [\n      \"74x138\"\n    ],\n    \"pins\" : {\n      \"1\" : \"A0\",\n      \"10\" : \"Y5_n\",\n      \"11\" : \"Y4_n\",\n      \"12\" : \"Y3_n\",\n      \"13\" : \"Y2_n\",\n      \"14\" : \"Y1_n\",\n      \"15\" : \"Y0_n\",\n      \"2\" : \"A1\",\n      \"3\" : \"A2\",\n      \"4\" : \"E1_n\",\n      \"5\" : \"E2_n\",\n      \"6\" : \"E3\",\n      \"7\" : \"Y7_n\",\n      \"9\" : \"Y6_n\"\n    }\n  },\n  \"top\" : \"ic74x138\",\n  \"version\" : \"1.0.1\"\n}\n",
    "cores/ic74x138/rtl/ic74x138.v" : "// 74x138: 3-to-8 line decoder, outputs active low (74LS138, 74HC138 …). Zero-delay model.\n// Pins: A0 A1 A2 = 1 2 3, E1_n E2_n E3 = 4 5 6, Y7_n = 7, Y6_n … Y0_n = 9 … 15.\n\n`timescale 1ns / 1ps\n\nmodule ic74x138 (\n    input  wire A0,\n    input  wire A1,\n    input  wire A2,\n    input  wire E1_n,\n    input  wire E2_n,\n    input  wire E3,\n    output wire Y0_n,\n    output wire Y1_n,\n    output wire Y2_n,\n    output wire Y3_n,\n    output wire Y4_n,\n    output wire Y5_n,\n    output wire Y6_n,\n    output wire Y7_n\n);\n    wire enabled = !E1_n && !E2_n && E3;\n    wire [7:0] selected = enabled ? (8'b1 << {A2, A1, A0}) : 8'b0;\n    assign {Y7_n, Y6_n, Y5_n, Y4_n, Y3_n, Y2_n, Y1_n, Y0_n} = ~selected;\nendmodule\n",
    "cores/ic74x138/tb/ic74x138_tb.v" : "// Self-checking testbench for ic74x138: all 64 combinations of address and enables.\n\n`timescale 1ns / 1ps\n\nmodule ic74x138_tb;\n    reg  [2:0] a;\n    reg  e1_n, e2_n, e3;\n    wire [7:0] y_n;\n\n    ic74x138 dut (.A0(a[0]), .A1(a[1]), .A2(a[2]), .E1_n(e1_n), .E2_n(e2_n), .E3(e3),\n                  .Y0_n(y_n[0]), .Y1_n(y_n[1]), .Y2_n(y_n[2]), .Y3_n(y_n[3]),\n                  .Y4_n(y_n[4]), .Y5_n(y_n[5]), .Y6_n(y_n[6]), .Y7_n(y_n[7]));\n\n    integer i, errors = 0;\n    reg [7:0] expected;\n    initial begin\n        for (i = 0; i < 64; i = i + 1) begin\n            {e3, e2_n, e1_n, a} = i[5:0];\n            #1;\n            expected = (!e1_n && !e2_n && e3) ? ~(8'b1 << a) : 8'hFF;\n            if (y_n !== expected) begin\n                $display(\"FAIL: A=%0d E1_n=%b E2_n=%b E3=%b gave %b, expected %b\", a, e1_n, e2_n, e3, y_n, expected);\n                errors = errors + 1;\n            end\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #1000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x151/README.md" : "# 74x151 — 8-to-1 multiplexer\n\n`Y` is the data input `D{C B A}` while the strobe `G_n` is low; with `G_n` high, `Y` is low and\n`Y_n` (the datasheet's `W`) high. As in the 74LS151 and 74HC151 (KiCad names the pins I0–I7,\nS0–S2, ~E, Z and ~Z). Used by GateLab's KiCad import (package pin table in `core.json`).\n",
    "cores/ic74x151/core.json" : "{\n  \"description\" : \"8-to-1 data selector/multiplexer with strobe and inverted output (74LS151, 74HC151 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 299.9,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 11\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 211.1,\n      \"resources\" : {\n        \"CPE_CPLINES\" : 3\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"LUT4\" : 23,\n        \"MUX2_LUT5\" : 11,\n        \"MUX2_LUT6\" : 4,\n        \"MUX2_LUT7\" : 2,\n        \"MUX2_LUT8\" : 1\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 100.9,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 12\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic74x151\",\n  \"keywords\" : [\n    \"74xx\",\n    \"74151\",\n    \"multiplexer\",\n    \"mux\",\n    \"data selector\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"8-zu-1-Datenselektor/Multiplexer mit Strobe und invertiertem Ausgang (74LS151, 74HC151 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x151 8-zu-1-Multiplexer\"\n    }\n  },\n  \"name\" : \"74x151 8-to-1 multiplexer\",\n  \"ports\" : [\n    {\n      \"description\" : \"Data input 0\",\n      \"dir\" : \"in\",\n      \"name\" : \"D0\"\n    },\n    {\n      \"description\" : \"Data input 1\",\n      \"dir\" : \"in\",\n      \"name\" : \"D1\"\n    },\n    {\n      \"description\" : \"Data input 2\",\n      \"dir\" : \"in\",\n      \"name\" : \"D2\"\n    },\n    {\n      \"description\" : \"Data input 3\",\n      \"dir\" : \"in\",\n      \"name\" : \"D3\"\n    },\n    {\n      \"description\" : \"Data input 4\",\n      \"dir\" : \"in\",\n      \"name\" : \"D4\"\n    },\n    {\n      \"description\" : \"Data input 5\",\n      \"dir\" : \"in\",\n      \"name\" : \"D5\"\n    },\n    {\n      \"description\" : \"Data input 6\",\n      \"dir\" : \"in\",\n      \"name\" : \"D6\"\n    },\n    {\n      \"description\" : \"Data input 7\",\n      \"dir\" : \"in\",\n      \"name\" : \"D7\"\n    },\n    {\n      \"description\" : \"Select, bit 0\",\n      \"dir\" : \"in\",\n      \"name\" : \"A\"\n    },\n    {\n      \"description\" : \"Select, bit 1\",\n      \"dir\" : \"in\",\n      \"name\" : \"B\"\n    },\n    {\n      \"description\" : \"Select, bit 2\",\n      \"dir\" : \"in\",\n      \"name\" : \"C\"\n    },\n    {\n      \"description\" : \"Strobe (enable), active low\",\n      \"dir\" : \"in\",\n      \"name\" : \"G_n\"\n    },\n    {\n      \"description\" : \"Selected input (low while G_n is high)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y\"\n    },\n    {\n      \"description\" : \"Inverted output (W)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y_n\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"parts\" : [\n      \"74x151\"\n    ],\n    \"pins\" : {\n      \"1\" : \"D3\",\n      \"10\" : \"B\",\n      \"11\" : \"A\",\n      \"12\" : \"D7\",\n      \"13\" : \"D6\",\n      \"14\" : \"D5\",\n      \"15\" : \"D4\",\n      \"2\" : \"D2\",\n      \"3\" : \"D1\",\n      \"4\" : \"D0\",\n      \"5\" : \"Y\",\n      \"6\" : \"Y_n\",\n      \"7\" : \"G_n\",\n      \"9\" : \"C\"\n    }\n  },\n  \"top\" : \"ic74x151\",\n  \"version\" : \"1.0.0\"\n}\n",
    "cores/ic74x151/rtl/ic74x151.v" : "// 74x151: 8-to-1 data selector/multiplexer with strobe and both outputs (74LS151, 74HC151 …).\n// Y is the selected input D{C B A} while G_n is low; with G_n high, Y is low and Y_n high.\n// Pins: D3 D2 D1 D0 Y Y_n G_n = 1 2 3 4 5 6 7, C B A = 9 10 11, D7 D6 D5 D4 = 12 13 14 15.\n\n`timescale 1ns / 1ps\n\nmodule ic74x151 (\n    input  wire D0,\n    input  wire D1,\n    input  wire D2,\n    input  wire D3,\n    input  wire D4,\n    input  wire D5,\n    input  wire D6,\n    input  wire D7,\n    input  wire A,\n    input  wire B,\n    input  wire C,\n    input  wire G_n,\n    output wire Y,\n    output wire Y_n\n);\n    wire [7:0] d = {D7, D6, D5, D4, D3, D2, D1, D0};\n    assign Y = !G_n && d[{C, B, A}];\n    assign Y_n = !Y;\nendmodule\n",
    "cores/ic74x151/tb/ic74x151_tb.v" : "// Self-checking testbench for ic74x151: every data word, select and strobe (4,096 cases).\n\n`timescale 1ns / 1ps\n\nmodule ic74x151_tb;\n    reg  [7:0] d;\n    reg  [2:0] s;\n    reg  g_n;\n    wire y, y_n;\n\n    ic74x151 dut (.D0(d[0]), .D1(d[1]), .D2(d[2]), .D3(d[3]), .D4(d[4]), .D5(d[5]), .D6(d[6]), .D7(d[7]),\n                  .A(s[0]), .B(s[1]), .C(s[2]), .G_n(g_n), .Y(y), .Y_n(y_n));\n\n    integer i, errors = 0;\n    reg expected;\n    initial begin\n        for (i = 0; i < 4096; i = i + 1) begin\n            {g_n, s, d} = i[11:0];\n            #1;\n            expected = !g_n && d[s];\n            if (y !== expected || y_n !== !expected) begin\n                $display(\"FAIL: D=%b C B A=%0d G_n=%b gave Y=%b Y_n=%b, expected Y=%b\", d, s, g_n, y, y_n, expected);\n                errors = errors + 1;\n            end\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #1000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x153/README.md" : "# 74x153 — dual 4-to-1 multiplexer\n\nEach half's `Y` is its input `C{B A}` while its strobe is low, else low; `A` and `B` select for\nboth halves. The datasheet's `1C0` is `C1_0` (half 1, input 0), `1G` is `G1_n`, `1Y` is `Y1`. As\nin the 74LS153 and 74HC153 (KiCad names the pins I0a–I3b, S0, S1, Ea, Eb, Za, Zb). Used by\nGateLab's KiCad import (package pin table in `core.json`).\n",
    "cores/ic74x153/core.json" : "{\n  \"description\" : \"Dual 4-to-1 data selector/multiplexer with shared select and separate strobes (74LS153, 74HC153 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 308.9,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 10\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 174.6,\n      \"resources\" : {\n\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"LUT4\" : 6\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 136,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 6\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic74x153\",\n  \"keywords\" : [\n    \"74xx\",\n    \"74153\",\n    \"multiplexer\",\n    \"mux\",\n    \"data selector\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Doppelter 4-zu-1-Datenselektor/Multiplexer mit gemeinsamer Auswahl und getrennten Strobes (74LS153, 74HC153 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x153 doppelter 4-zu-1-Multiplexer\"\n    }\n  },\n  \"name\" : \"74x153 dual 4-to-1 multiplexer\",\n  \"ports\" : [\n    {\n      \"description\" : \"Select, bit 0 (both halves)\",\n      \"dir\" : \"in\",\n      \"name\" : \"A\"\n    },\n    {\n      \"description\" : \"Select, bit 1 (both halves)\",\n      \"dir\" : \"in\",\n      \"name\" : \"B\"\n    },\n    {\n      \"description\" : \"Half 1, data input 0 (1C0)\",\n      \"dir\" : \"in\",\n      \"name\" : \"C1_0\"\n    },\n    {\n      \"description\" : \"Half 1, data input 1 (1C1)\",\n      \"dir\" : \"in\",\n      \"name\" : \"C1_1\"\n    },\n    {\n      \"description\" : \"Half 1, data input 2 (1C2)\",\n      \"dir\" : \"in\",\n      \"name\" : \"C1_2\"\n    },\n    {\n      \"description\" : \"Half 1, data input 3 (1C3)\",\n      \"dir\" : \"in\",\n      \"name\" : \"C1_3\"\n    },\n    {\n      \"description\" : \"Half 1, strobe, active low (1G)\",\n      \"dir\" : \"in\",\n      \"name\" : \"G1_n\"\n    },\n    {\n      \"description\" : \"Half 1, output (low while G1_n is high)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y1\"\n    },\n    {\n      \"description\" : \"Half 2, data input 0 (2C0)\",\n      \"dir\" : \"in\",\n      \"name\" : \"C2_0\"\n    },\n    {\n      \"description\" : \"Half 2, data input 1 (2C1)\",\n      \"dir\" : \"in\",\n      \"name\" : \"C2_1\"\n    },\n    {\n      \"description\" : \"Half 2, data input 2 (2C2)\",\n      \"dir\" : \"in\",\n      \"name\" : \"C2_2\"\n    },\n    {\n      \"description\" : \"Half 2, data input 3 (2C3)\",\n      \"dir\" : \"in\",\n      \"name\" : \"C2_3\"\n    },\n    {\n      \"description\" : \"Half 2, strobe, active low (2G)\",\n      \"dir\" : \"in\",\n      \"name\" : \"G2_n\"\n    },\n    {\n      \"description\" : \"Half 2, output (low while G2_n is high)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y2\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"parts\" : [\n      \"74x153\"\n    ],\n    \"pins\" : {\n      \"1\" : \"G1_n\",\n      \"10\" : \"C2_0\",\n      \"11\" : \"C2_1\",\n      \"12\" : \"C2_2\",\n      \"13\" : \"C2_3\",\n      \"14\" : \"A\",\n      \"15\" : \"G2_n\",\n      \"2\" : \"B\",\n      \"3\" : \"C1_3\",\n      \"4\" : \"C1_2\",\n      \"5\" : \"C1_1\",\n      \"6\" : \"C1_0\",\n      \"7\" : \"Y1\",\n      \"9\" : \"Y2\"\n    }\n  },\n  \"top\" : \"ic74x153\",\n  \"version\" : \"1.0.0\"\n}\n",
    "cores/ic74x153/rtl/ic74x153.v" : "// 74x153: dual 4-to-1 data selector/multiplexer, shared select, separate strobes (74LS153,\n// 74HC153 …). Each Y is the input C{B A} of its half while its strobe is low, else low.\n// Ports: datasheet 1C0 = C1_0 (half 1, input 0) …, 1G = G1_n, 1Y = Y1.\n// Pins: G1_n B C1_3 C1_2 C1_1 C1_0 Y1 = 1 2 3 4 5 6 7, Y2 C2_0 C2_1 C2_2 C2_3 A G2_n = 9 … 15.\n\n`timescale 1ns / 1ps\n\nmodule ic74x153 (\n    input  wire A,\n    input  wire B,\n    input  wire C1_0,\n    input  wire C1_1,\n    input  wire C1_2,\n    input  wire C1_3,\n    input  wire G1_n,\n    output wire Y1,\n    input  wire C2_0,\n    input  wire C2_1,\n    input  wire C2_2,\n    input  wire C2_3,\n    input  wire G2_n,\n    output wire Y2\n);\n    wire [3:0] c1 = {C1_3, C1_2, C1_1, C1_0};\n    wire [3:0] c2 = {C2_3, C2_2, C2_1, C2_0};\n    assign Y1 = !G1_n && c1[{B, A}];\n    assign Y2 = !G2_n && c2[{B, A}];\nendmodule\n",
    "cores/ic74x153/tb/ic74x153_tb.v" : "// Self-checking testbench for ic74x153: both halves' data, the shared select and both strobes\n// (4,096 cases), so a half reading the other's inputs or strobe fails too.\n\n`timescale 1ns / 1ps\n\nmodule ic74x153_tb;\n    reg  [3:0] c1, c2;\n    reg  [1:0] s;\n    reg  g1_n, g2_n;\n    wire y1, y2;\n\n    ic74x153 dut (.A(s[0]), .B(s[1]),\n                  .C1_0(c1[0]), .C1_1(c1[1]), .C1_2(c1[2]), .C1_3(c1[3]), .G1_n(g1_n), .Y1(y1),\n                  .C2_0(c2[0]), .C2_1(c2[1]), .C2_2(c2[2]), .C2_3(c2[3]), .G2_n(g2_n), .Y2(y2));\n\n    integer i, errors = 0;\n    reg e1, e2;\n    initial begin\n        for (i = 0; i < 4096; i = i + 1) begin\n            {g2_n, g1_n, s, c2, c1} = i[11:0];\n            #1;\n            e1 = !g1_n && c1[s];\n            e2 = !g2_n && c2[s];\n            if (y1 !== e1 || y2 !== e2) begin\n                $display(\"FAIL: C1=%b C2=%b B A=%0d G1_n=%b G2_n=%b gave Y1=%b Y2=%b, expected %b %b\", c1, c2, s, g1_n, g2_n, y1, y2, e1, e2);\n                errors = errors + 1;\n            end\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #1000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x157/README.md" : "# 74x157 — quad 2-to-1 multiplexer\n\nEach section's `Y` is its `A` input with `S` low and its `B` input with `S` high (the datasheet's\n`A/B` select), and low while the strobe `G_n` is high. As in the 74LS157 and 74HC157 (KiCad names\nthe pins I0a–I1d, S, E, Za–Zd). Used by GateLab's KiCad import (package pin table in\n`core.json`).\n",
    "cores/ic74x157/core.json" : "{\n  \"description\" : \"Quad 2-to-1 data selector/multiplexer with shared select and strobe (74LS157, 74HC157 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 315.4,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 4\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 217.8,\n      \"resources\" : {\n        \"CPE_CPLINES\" : 25\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"LUT4\" : 4\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 136,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 4\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic74x157\",\n  \"keywords\" : [\n    \"74xx\",\n    \"74157\",\n    \"multiplexer\",\n    \"mux\",\n    \"data selector\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Vierfacher 2-zu-1-Datenselektor/Multiplexer mit gemeinsamer Auswahl und Strobe (74LS157, 74HC157 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x157 vierfacher 2-zu-1-Multiplexer\"\n    }\n  },\n  \"name\" : \"74x157 quad 2-to-1 multiplexer\",\n  \"ports\" : [\n    {\n      \"description\" : \"Select: low picks the A inputs, high the B inputs\",\n      \"dir\" : \"in\",\n      \"name\" : \"S\"\n    },\n    {\n      \"description\" : \"Strobe (enable), active low\",\n      \"dir\" : \"in\",\n      \"name\" : \"G_n\"\n    },\n    {\n      \"description\" : \"Section 1, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A1\"\n    },\n    {\n      \"description\" : \"Section 1, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B1\"\n    },\n    {\n      \"description\" : \"Section 1, output (low while G_n is high)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y1\"\n    },\n    {\n      \"description\" : \"Section 2, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A2\"\n    },\n    {\n      \"description\" : \"Section 2, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B2\"\n    },\n    {\n      \"description\" : \"Section 2, output (low while G_n is high)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y2\"\n    },\n    {\n      \"description\" : \"Section 3, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A3\"\n    },\n    {\n      \"description\" : \"Section 3, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B3\"\n    },\n    {\n      \"description\" : \"Section 3, output (low while G_n is high)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y3\"\n    },\n    {\n      \"description\" : \"Section 4, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A4\"\n    },\n    {\n      \"description\" : \"Section 4, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B4\"\n    },\n    {\n      \"description\" : \"Section 4, output (low while G_n is high)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y4\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"parts\" : [\n      \"74x157\"\n    ],\n    \"pins\" : {\n      \"1\" : \"S\",\n      \"10\" : \"B3\",\n      \"11\" : \"A3\",\n      \"12\" : \"Y4\",\n      \"13\" : \"B4\",\n      \"14\" : \"A4\",\n      \"15\" : \"G_n\",\n      \"2\" : \"A1\",\n      \"3\" : \"B1\",\n      \"4\" : \"Y1\",\n      \"5\" : \"A2\",\n      \"6\" : \"B2\",\n      \"7\" : \"Y2\",\n      \"9\" : \"Y3\"\n    }\n  },\n  \"top\" : \"ic74x157\",\n  \"version\" : \"1.0.0\"\n}\n",
    "cores/ic74x157/rtl/ic74x157.v" : "// 74x157: quad 2-to-1 data selector/multiplexer, shared select and strobe (74LS157, 74HC157 …).\n// Each Y is its A input with S low, its B input with S high, and low while G_n is high.\n// Pins: S A1 B1 Y1 A2 B2 Y2 = 1 … 7, Y3 B3 A3 Y4 B4 A4 G_n = 9 … 15.\n\n`timescale 1ns / 1ps\n\nmodule ic74x157 (\n    input  wire S,\n    input  wire G_n,\n    input  wire A1,\n    input  wire B1,\n    output wire Y1,\n    input  wire A2,\n    input  wire B2,\n    output wire Y2,\n    input  wire A3,\n    input  wire B3,\n    output wire Y3,\n    input  wire A4,\n    input  wire B4,\n    output wire Y4\n);\n    assign Y1 = !G_n && (S ? B1 : A1);\n    assign Y2 = !G_n && (S ? B2 : A2);\n    assign Y3 = !G_n && (S ? B3 : A3);\n    assign Y4 = !G_n && (S ? B4 : A4);\nendmodule\n",
    "cores/ic74x157/tb/ic74x157_tb.v" : "// Self-checking testbench for ic74x157: all four sections' inputs, select and strobe (1,024 cases).\n\n`timescale 1ns / 1ps\n\nmodule ic74x157_tb;\n    reg  [3:0] a, b;\n    reg  s, g_n;\n    wire [3:0] y;\n\n    ic74x157 dut (.S(s), .G_n(g_n),\n                  .A1(a[0]), .B1(b[0]), .Y1(y[0]), .A2(a[1]), .B2(b[1]), .Y2(y[1]),\n                  .A3(a[2]), .B3(b[2]), .Y3(y[2]), .A4(a[3]), .B4(b[3]), .Y4(y[3]));\n\n    integer i, errors = 0;\n    reg [3:0] expected;\n    initial begin\n        for (i = 0; i < 1024; i = i + 1) begin\n            {g_n, s, b, a} = i[9:0];\n            #1;\n            expected = g_n ? 4'b0000 : (s ? b : a);\n            if (y !== expected) begin\n                $display(\"FAIL: A=%b B=%b S=%b G_n=%b gave Y=%b, expected %b\", a, b, s, g_n, y, expected);\n                errors = errors + 1;\n            end\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #1000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x161/README.md" : "# 74x161 — synchronous 4-bit binary counter\n\nCounts on the rising edge of `CP` while `CEP` and `CET` are high, loads `D3…D0` while `PE_n` is\nlow, and clears while `MR_n` is low — at once, without a clock (asynchronous clear, the difference to the 74x163).\n`TC` is high at count 15 while `CET` is high, for cascading. As in the 74LS161 and 74HC161. Used by\nGateLab's KiCad import (package pin table in `core.json`).\n",
    "cores/ic74x161/core.json" : "{\n  \"description\" : \"Synchronous 4-bit binary counter with asynchronous clear, load and two enables (74LS161, 74HC161 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 330.5,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 9,\n        \"TRELLIS_FF\" : 4\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 179.9,\n      \"resources\" : {\n        \"CPE_ADDF2\" : 2,\n        \"CPE_BRIDGE\" : 1,\n        \"CPE_CPLINES\" : 13,\n        \"CPE_FF\" : 12,\n        \"CPE_LT\" : 16\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"ALU\" : 6,\n        \"DFF\" : 4\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 104.4,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 14\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic74x161\",\n  \"keywords\" : [\n    \"74xx\",\n    \"74161\",\n    \"counter\",\n    \"binary\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Synchroner 4-Bit-Binärzähler mit asynchronem Löschen, Laden und zwei Freigaben (74LS161, 74HC161 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x161 4-Bit-Binärzähler\"\n    }\n  },\n  \"name\" : \"74x161 4-bit binary counter\",\n  \"ports\" : [\n    {\n      \"description\" : \"Clock (rising edge)\",\n      \"dir\" : \"in\",\n      \"name\" : \"CP\"\n    },\n    {\n      \"description\" : \"Master reset, asynchronous, active low (CLR)\",\n      \"dir\" : \"in\",\n      \"name\" : \"MR_n\"\n    },\n    {\n      \"description\" : \"Parallel load, synchronous, active low (LOAD)\",\n      \"dir\" : \"in\",\n      \"name\" : \"PE_n\"\n    },\n    {\n      \"description\" : \"Count enable (ENP)\",\n      \"dir\" : \"in\",\n      \"name\" : \"CEP\"\n    },\n    {\n      \"description\" : \"Count enable, also gates TC (ENT)\",\n      \"dir\" : \"in\",\n      \"name\" : \"CET\"\n    },\n    {\n      \"description\" : \"Load data, bit 0\",\n      \"dir\" : \"in\",\n      \"name\" : \"D0\"\n    },\n    {\n      \"description\" : \"Load data, bit 1\",\n      \"dir\" : \"in\",\n      \"name\" : \"D1\"\n    },\n    {\n      \"description\" : \"Load data, bit 2\",\n      \"dir\" : \"in\",\n      \"name\" : \"D2\"\n    },\n    {\n      \"description\" : \"Load data, bit 3\",\n      \"dir\" : \"in\",\n      \"name\" : \"D3\"\n    },\n    {\n      \"description\" : \"Count, bit 0\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q0\"\n    },\n    {\n      \"description\" : \"Count, bit 1\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q1\"\n    },\n    {\n      \"description\" : \"Count, bit 2\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q2\"\n    },\n    {\n      \"description\" : \"Count, bit 3\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q3\"\n    },\n    {\n      \"description\" : \"Terminal count: high at 15 while CET is high\",\n      \"dir\" : \"out\",\n      \"name\" : \"TC\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"asyncInputs\" : [\n      \"MR_n\"\n    ],\n    \"clocks\" : [\n      \"CP\"\n    ],\n    \"parts\" : [\n      \"74x161\"\n    ],\n    \"pins\" : {\n      \"1\" : \"MR_n\",\n      \"10\" : \"CET\",\n      \"11\" : \"Q3\",\n      \"12\" : \"Q2\",\n      \"13\" : \"Q1\",\n      \"14\" : \"Q0\",\n      \"15\" : \"TC\",\n      \"2\" : \"CP\",\n      \"3\" : \"D0\",\n      \"4\" : \"D1\",\n      \"5\" : \"D2\",\n      \"6\" : \"D3\",\n      \"7\" : \"CEP\",\n      \"9\" : \"PE_n\"\n    }\n  },\n  \"top\" : \"ic74x161\",\n  \"version\" : \"1.0.1\"\n}\n",
    "cores/ic74x161/rtl/ic74x161.v" : "// 74x161: synchronous 4-bit binary counter with asynchronous clear (74LS161, 74HC161 …).\n// Clear beats load beats count; counting needs CEP and CET; TC = CET at count 15.\n// Pins: MR_n CP D0 D1 D2 D3 CEP = 1 … 7, PE_n CET = 9 10, Q3 Q2 Q1 Q0 TC = 11 … 15.\n\n`timescale 1ns / 1ps\n\nmodule ic74x161 (\n    input  wire CP,\n    input  wire MR_n,\n    input  wire PE_n,\n    input  wire CEP,\n    input  wire CET,\n    input  wire D0,\n    input  wire D1,\n    input  wire D2,\n    input  wire D3,\n    output wire Q0,\n    output wire Q1,\n    output wire Q2,\n    output wire Q3,\n    output wire TC\n);\n    reg [3:0] count = 4'd0;\n\n    always @(posedge CP or negedge MR_n)\n        if (!MR_n) count <= 4'd0;\n        else if (!PE_n) count <= {D3, D2, D1, D0};\n        else if (CEP && CET) count <= count + 4'd1;\n\n    assign {Q3, Q2, Q1, Q0} = count;\n    assign TC = CET && (count == 4'hF);\nendmodule\n",
    "cores/ic74x161/tb/ic74x161_tb.v" : "// Self-checking testbench for ic74x161: load, count with both enables, hold with either low,\n// terminal count, wrap-around and the asynchronous clear.\n\n`timescale 1ns / 1ps\n\nmodule ic74x161_tb;\n    reg cp = 0, mr_n = 1, pe_n = 1, cep = 0, cet = 0;\n    reg [3:0] d = 4'd0;\n    wire [3:0] q;\n    wire tc;\n\n    ic74x161 dut (.CP(cp), .MR_n(mr_n), .PE_n(pe_n), .CEP(cep), .CET(cet),\n              .D0(d[0]), .D1(d[1]), .D2(d[2]), .D3(d[3]),\n              .Q0(q[0]), .Q1(q[1]), .Q2(q[2]), .Q3(q[3]), .TC(tc));\n\n    integer i, errors = 0;\n    task tick; begin #5 cp = 1; #5 cp = 0; #1; end endtask\n    task check(input [3:0] count, input terminal, input [8*32-1:0] what);\n        begin\n            if (q !== count || tc !== terminal) begin\n                $display(\"FAIL: %0s: Q=%0d TC=%b, expected Q=%0d TC=%b\", what, q, tc, count, terminal);\n                errors = errors + 1;\n            end\n        end\n    endtask\n\n    initial begin\n        mr_n = 0; tick; mr_n = 1;\n        check(4'd0, 0, \"reset\");\n        d = 4'd5; pe_n = 0; tick; pe_n = 1;\n        check(4'd5, 0, \"loaded 5\");\n        tick; check(4'd5, 0, \"no enables: hold\");\n        cep = 1; tick; check(4'd5, 0, \"CEP only: hold\");\n        cep = 0; cet = 1; tick; check(4'd5, 0, \"CET only: hold\");\n        // Asynchronous clear: at once, without a clock.\n        mr_n = 0; #1;\n        check(4'd0, 0, \"MR_n low, no clock\");\n        tick; check(4'd0, 0, \"MR_n low holds against the clock\");\n        mr_n = 1;\n        d = 4'd13; pe_n = 0; tick; pe_n = 1;\n        check(4'd13, 0, \"loaded 13, CET high\");\n        cep = 1;\n        tick; check(4'd14, 0, \"count 14\");\n        tick; check(4'd15, 1, \"count 15: TC\");\n        cet = 0; #1; check(4'd15, 0, \"TC follows CET\");\n        cet = 1; tick; check(4'd0, 0, \"wrapped to 0\");\n        for (i = 1; i <= 15; i = i + 1) tick;\n        check(4'd15, 1, \"counted around to 15\");\n        pe_n = 0; d = 4'd9; tick; pe_n = 1;\n        check(4'd9, 0, \"load beats count\");\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #1000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x163/README.md" : "# 74x163 — synchronous 4-bit binary counter\n\nCounts on the rising edge of `CP` while `CEP` and `CET` are high, loads `D3…D0` while `PE_n` is\nlow, and clears while `MR_n` is low — on the next clock edge (synchronous clear, the difference to the 74x161).\n`TC` is high at count 15 while `CET` is high, for cascading. As in the 74LS163 and 74HC163. Used by\nGateLab's KiCad import (package pin table in `core.json`).\n",
    "cores/ic74x163/core.json" : "{\n  \"description\" : \"Synchronous 4-bit binary counter with synchronous clear, load and two enables (74LS163, 74HC163 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 330.8,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 9,\n        \"TRELLIS_FF\" : 4\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 108.6,\n      \"resources\" : {\n        \"CPE_ADDF2\" : 2,\n        \"CPE_BRIDGE\" : 6,\n        \"CPE_CPLINES\" : 17,\n        \"CPE_FF\" : 12,\n        \"CPE_LT\" : 28\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"ALU\" : 6,\n        \"DFF\" : 4\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 121.6,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 11\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic74x163\",\n  \"keywords\" : [\n    \"74xx\",\n    \"74163\",\n    \"counter\",\n    \"binary\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Synchroner 4-Bit-Binärzähler mit synchronem Löschen, Laden und zwei Freigaben (74LS163, 74HC163 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x163 4-Bit-Binärzähler\"\n    }\n  },\n  \"name\" : \"74x163 4-bit binary counter\",\n  \"ports\" : [\n    {\n      \"description\" : \"Clock (rising edge)\",\n      \"dir\" : \"in\",\n      \"name\" : \"CP\"\n    },\n    {\n      \"description\" : \"Master reset, synchronous, active low (CLR)\",\n      \"dir\" : \"in\",\n      \"name\" : \"MR_n\"\n    },\n    {\n      \"description\" : \"Parallel load, synchronous, active low (LOAD)\",\n      \"dir\" : \"in\",\n      \"name\" : \"PE_n\"\n    },\n    {\n      \"description\" : \"Count enable (ENP)\",\n      \"dir\" : \"in\",\n      \"name\" : \"CEP\"\n    },\n    {\n      \"description\" : \"Count enable, also gates TC (ENT)\",\n      \"dir\" : \"in\",\n      \"name\" : \"CET\"\n    },\n    {\n      \"description\" : \"Load data, bit 0\",\n      \"dir\" : \"in\",\n      \"name\" : \"D0\"\n    },\n    {\n      \"description\" : \"Load data, bit 1\",\n      \"dir\" : \"in\",\n      \"name\" : \"D1\"\n    },\n    {\n      \"description\" : \"Load data, bit 2\",\n      \"dir\" : \"in\",\n      \"name\" : \"D2\"\n    },\n    {\n      \"description\" : \"Load data, bit 3\",\n      \"dir\" : \"in\",\n      \"name\" : \"D3\"\n    },\n    {\n      \"description\" : \"Count, bit 0\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q0\"\n    },\n    {\n      \"description\" : \"Count, bit 1\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q1\"\n    },\n    {\n      \"description\" : \"Count, bit 2\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q2\"\n    },\n    {\n      \"description\" : \"Count, bit 3\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q3\"\n    },\n    {\n      \"description\" : \"Terminal count: high at 15 while CET is high\",\n      \"dir\" : \"out\",\n      \"name\" : \"TC\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"clocks\" : [\n      \"CP\"\n    ],\n    \"parts\" : [\n      \"74x163\"\n    ],\n    \"pins\" : {\n      \"1\" : \"MR_n\",\n      \"10\" : \"CET\",\n      \"11\" : \"Q3\",\n      \"12\" : \"Q2\",\n      \"13\" : \"Q1\",\n      \"14\" : \"Q0\",\n      \"15\" : \"TC\",\n      \"2\" : \"CP\",\n      \"3\" : \"D0\",\n      \"4\" : \"D1\",\n      \"5\" : \"D2\",\n      \"6\" : \"D3\",\n      \"7\" : \"CEP\",\n      \"9\" : \"PE_n\"\n    }\n  },\n  \"top\" : \"ic74x163\",\n  \"version\" : \"1.0.1\"\n}\n",
    "cores/ic74x163/rtl/ic74x163.v" : "// 74x163: synchronous 4-bit binary counter with synchronous clear (74LS163, 74HC163 …).\n// Clear beats load beats count; counting needs CEP and CET; TC = CET at count 15.\n// Pins: MR_n CP D0 D1 D2 D3 CEP = 1 … 7, PE_n CET = 9 10, Q3 Q2 Q1 Q0 TC = 11 … 15.\n\n`timescale 1ns / 1ps\n\nmodule ic74x163 (\n    input  wire CP,\n    input  wire MR_n,\n    input  wire PE_n,\n    input  wire CEP,\n    input  wire CET,\n    input  wire D0,\n    input  wire D1,\n    input  wire D2,\n    input  wire D3,\n    output wire Q0,\n    output wire Q1,\n    output wire Q2,\n    output wire Q3,\n    output wire TC\n);\n    reg [3:0] count = 4'd0;\n\n    always @(posedge CP)\n        if (!MR_n) count <= 4'd0;\n        else if (!PE_n) count <= {D3, D2, D1, D0};\n        else if (CEP && CET) count <= count + 4'd1;\n\n    assign {Q3, Q2, Q1, Q0} = count;\n    assign TC = CET && (count == 4'hF);\nendmodule\n",
    "cores/ic74x163/tb/ic74x163_tb.v" : "// Self-checking testbench for ic74x163: load, count with both enables, hold with either low,\n// terminal count, wrap-around and the synchronous clear.\n\n`timescale 1ns / 1ps\n\nmodule ic74x163_tb;\n    reg cp = 0, mr_n = 1, pe_n = 1, cep = 0, cet = 0;\n    reg [3:0] d = 4'd0;\n    wire [3:0] q;\n    wire tc;\n\n    ic74x163 dut (.CP(cp), .MR_n(mr_n), .PE_n(pe_n), .CEP(cep), .CET(cet),\n              .D0(d[0]), .D1(d[1]), .D2(d[2]), .D3(d[3]),\n              .Q0(q[0]), .Q1(q[1]), .Q2(q[2]), .Q3(q[3]), .TC(tc));\n\n    integer i, errors = 0;\n    task tick; begin #5 cp = 1; #5 cp = 0; #1; end endtask\n    task check(input [3:0] count, input terminal, input [8*32-1:0] what);\n        begin\n            if (q !== count || tc !== terminal) begin\n                $display(\"FAIL: %0s: Q=%0d TC=%b, expected Q=%0d TC=%b\", what, q, tc, count, terminal);\n                errors = errors + 1;\n            end\n        end\n    endtask\n\n    initial begin\n        mr_n = 0; tick; mr_n = 1;\n        check(4'd0, 0, \"reset\");\n        d = 4'd5; pe_n = 0; tick; pe_n = 1;\n        check(4'd5, 0, \"loaded 5\");\n        tick; check(4'd5, 0, \"no enables: hold\");\n        cep = 1; tick; check(4'd5, 0, \"CEP only: hold\");\n        cep = 0; cet = 1; tick; check(4'd5, 0, \"CET only: hold\");\n        // Synchronous clear: nothing happens until the clock.\n        mr_n = 0; #1;\n        check(4'd5, 0, \"MR_n low, before the clock\");\n        tick; check(4'd0, 0, \"MR_n low, clocked\");\n        mr_n = 1;\n        d = 4'd13; pe_n = 0; tick; pe_n = 1;\n        check(4'd13, 0, \"loaded 13, CET high\");\n        cep = 1;\n        tick; check(4'd14, 0, \"count 14\");\n        tick; check(4'd15, 1, \"count 15: TC\");\n        cet = 0; #1; check(4'd15, 0, \"TC follows CET\");\n        cet = 1; tick; check(4'd0, 0, \"wrapped to 0\");\n        for (i = 1; i <= 15; i = i + 1) tick;\n        check(4'd15, 1, \"counted around to 15\");\n        pe_n = 0; d = 4'd9; tick; pe_n = 1;\n        check(4'd9, 0, \"load beats count\");\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #1000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x164/README.md" : "# 74x164 — 8-bit serial-in shift register\n\nOn each rising `CP` edge `Q0` takes `DSA AND DSB` and every stage moves one on; `MR_n` low clears\nall outputs at once. As in the 74LS164 and 74HC164 (KiCad names the pins DSA, DSB, CP, ~MR,\nQ0–Q7; TI calls them A, B, CLK, ~CLR, QA–QH). Used by GateLab's KiCad import (package pin table\nin `core.json`).\n",
    "cores/ic74x164/core.json" : "{\n  \"description\" : \"8-bit serial-in, parallel-out shift register with gated serial input and asynchronous clear (74LS164, 74HC164 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 304,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 2,\n        \"TRELLIS_FF\" : 8\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 176.9,\n      \"resources\" : {\n        \"CPE_BRIDGE\" : 1,\n        \"CPE_CPLINES\" : 2\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"DFF\" : 8,\n        \"LUT4\" : 9\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 136,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 1\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic74x164\",\n  \"keywords\" : [\n    \"74xx\",\n    \"74164\",\n    \"shift register\",\n    \"serial to parallel\",\n    \"sipo\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"8-Bit-Schieberegister seriell ein, parallel aus, mit verknüpftem Serieneingang und asynchronem Löschen (74LS164, 74HC164 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x164 8-Bit-Schieberegister (seriell ein)\"\n    }\n  },\n  \"name\" : \"74x164 8-bit serial-in shift register\",\n  \"ports\" : [\n    {\n      \"description\" : \"Serial data input A (shifted in: DSA AND DSB)\",\n      \"dir\" : \"in\",\n      \"name\" : \"DSA\"\n    },\n    {\n      \"description\" : \"Serial data input B (shifted in: DSA AND DSB)\",\n      \"dir\" : \"in\",\n      \"name\" : \"DSB\"\n    },\n    {\n      \"description\" : \"Clock, rising edge\",\n      \"dir\" : \"in\",\n      \"name\" : \"CP\"\n    },\n    {\n      \"description\" : \"Master reset, asynchronous, active low\",\n      \"dir\" : \"in\",\n      \"name\" : \"MR_n\"\n    },\n    {\n      \"description\" : \"Stage 0 output (Q0 takes the serial input)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q0\"\n    },\n    {\n      \"description\" : \"Stage 1 output (Q0 takes the serial input)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q1\"\n    },\n    {\n      \"description\" : \"Stage 2 output (Q0 takes the serial input)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q2\"\n    },\n    {\n      \"description\" : \"Stage 3 output (Q0 takes the serial input)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q3\"\n    },\n    {\n      \"description\" : \"Stage 4 output (Q0 takes the serial input)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q4\"\n    },\n    {\n      \"description\" : \"Stage 5 output (Q0 takes the serial input)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q5\"\n    },\n    {\n      \"description\" : \"Stage 6 output (Q0 takes the serial input)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q6\"\n    },\n    {\n      \"description\" : \"Stage 7 output (Q0 takes the serial input)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q7\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"asyncInputs\" : [\n      \"MR_n\"\n    ],\n    \"clocks\" : [\n      \"CP\"\n    ],\n    \"parts\" : [\n      \"74x164\"\n    ],\n    \"pins\" : {\n      \"1\" : \"DSA\",\n      \"10\" : \"Q4\",\n      \"11\" : \"Q5\",\n      \"12\" : \"Q6\",\n      \"13\" : \"Q7\",\n      \"2\" : \"DSB\",\n      \"3\" : \"Q0\",\n      \"4\" : \"Q1\",\n      \"5\" : \"Q2\",\n      \"6\" : \"Q3\",\n      \"8\" : \"CP\",\n      \"9\" : \"MR_n\"\n    }\n  },\n  \"top\" : \"ic74x164\",\n  \"version\" : \"1.0.0\"\n}\n",
    "cores/ic74x164/rtl/ic74x164.v" : "// 74x164: 8-bit serial-in, parallel-out shift register with asynchronous clear (74LS164, 74HC164 …).\n// On each rising CP edge Q0 takes DSA AND DSB and every Qn takes Qn-1; MR_n low clears all outputs\n// at once, whatever the clock does.\n// Pins: DSA DSB Q0 Q1 Q2 Q3 = 1 … 6, CP MR_n Q4 Q5 Q6 Q7 = 8 … 13.\n\n`timescale 1ns / 1ps\n\nmodule ic74x164 (\n    input  wire DSA,\n    input  wire DSB,\n    input  wire CP,\n    input  wire MR_n,\n    output wire Q0,\n    output wire Q1,\n    output wire Q2,\n    output wire Q3,\n    output wire Q4,\n    output wire Q5,\n    output wire Q6,\n    output wire Q7\n);\n    reg [7:0] q = 8'h00;\n\n    always @(posedge CP or negedge MR_n)\n        if (!MR_n) q <= 8'h00;\n        else q <= {q[6:0], DSA & DSB};\n\n    assign {Q7, Q6, Q5, Q4, Q3, Q2, Q1, Q0} = q;\nendmodule\n",
    "cores/ic74x164/tb/ic74x164_tb.v" : "// Self-checking testbench for ic74x164: 600 clocks of pseudo-random serial data on both inputs,\n// with clears between clock edges, against a reference shift register.\n\n`timescale 1ns / 1ps\n\nmodule ic74x164_tb;\n    reg dsa = 0, dsb = 0, cp = 0, mr_n = 0;\n    wire [7:0] q;\n\n    ic74x164 dut (.DSA(dsa), .DSB(dsb), .CP(cp), .MR_n(mr_n),\n                  .Q0(q[0]), .Q1(q[1]), .Q2(q[2]), .Q3(q[3]), .Q4(q[4]), .Q5(q[5]), .Q6(q[6]), .Q7(q[7]));\n\n    reg [7:0] expected = 8'h00;\n    reg [15:0] lfsr = 16'hACE1;\n    integer i, errors = 0;\n\n    task check(input [255:0] what);\n        if (q !== expected) begin\n            $display(\"FAIL: %0s: Q7..Q0=%b, expected %b (t=%0t)\", what, q, expected, $time);\n            errors = errors + 1;\n        end\n    endtask\n\n    initial begin\n        #5 mr_n = 1;\n        for (i = 0; i < 600; i = i + 1) begin\n            lfsr = {lfsr[14:0], lfsr[15] ^ lfsr[13] ^ lfsr[12] ^ lfsr[10]};\n            dsa = lfsr[0];\n            dsb = lfsr[3] | lfsr[7];   // mostly high, so DSA shows through\n            #5 cp = 1;\n            expected = {expected[6:0], dsa & dsb};\n            #1 check(\"after a clock\");\n            #4 cp = 0;\n            // Now and then a clear between edges: immediate, without a clock.\n            if (lfsr[11:9] == 3'b101) begin\n                #2 mr_n = 0;\n                expected = 8'h00;\n                #1 check(\"clear\");\n                #2 mr_n = 1;\n            end\n        end\n        // While MR_n is low, clocks change nothing.\n        mr_n = 0; dsa = 1; dsb = 1; expected = 8'h00;\n        #5 cp = 1; #5 cp = 0;\n        #1 check(\"clock during clear\");\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #10000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x165/README.md" : "# 74x165 — 8-bit parallel-load shift register\n\n`PL_n` low loads `D0`–`D7` at once (asynchronously: `Q7` follows `D7` while it stays low). Otherwise\nthe stages shift on the rising edge of `CP` OR `CE_n` — the clock is a gated OR, so `CE_n` low\nenables `CP`, and the two pins are interchangeable: `Q0` takes `DS`, `Q7`/`Q7_n` show the last\nstage. Change `CE_n` only while `CP` is high, as the datasheet asks. As in the 74LS165 and 74HC165\n(KiCad names the pins ~PL, CP, ~CE, DS, D0–D7, Q7, ~Q7). Used by GateLab's KiCad import.\n",
    "cores/ic74x165/core.json" : "{\n  \"description\" : \"8-bit parallel-in, serial-out shift register with asynchronous load and a gated (ORed) clock (74LS165, 74HC165 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"tested\" : false\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 150.4,\n      \"resources\" : {\n        \"CPE_BRIDGE\" : 10,\n        \"CPE_CPLINES\" : 41,\n        \"CPE_FF\" : 34,\n        \"CPE_LT\" : 63\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"tested\" : false\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"tested\" : false\n    }\n  },\n  \"id\" : \"ic74x165\",\n  \"keywords\" : [\n    \"74xx\",\n    \"74165\",\n    \"shift register\",\n    \"parallel to serial\",\n    \"piso\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"8-Bit-Schieberegister parallel ein, seriell aus, mit asynchronem Laden und verknüpftem (ODER-)Takt (74LS165, 74HC165 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x165 8-Bit-Schieberegister (parallel laden)\"\n    }\n  },\n  \"name\" : \"74x165 8-bit parallel-load shift register\",\n  \"ports\" : [\n    {\n      \"description\" : \"Parallel load, asynchronous, active low\",\n      \"dir\" : \"in\",\n      \"name\" : \"PL_n\"\n    },\n    {\n      \"description\" : \"Clock, rising edge (ORed with CE_n)\",\n      \"dir\" : \"in\",\n      \"name\" : \"CP\"\n    },\n    {\n      \"description\" : \"Clock enable, active low (ORed with CP)\",\n      \"dir\" : \"in\",\n      \"name\" : \"CE_n\"\n    },\n    {\n      \"description\" : \"Serial data input (shifted into stage 0)\",\n      \"dir\" : \"in\",\n      \"name\" : \"DS\"\n    },\n    {\n      \"description\" : \"Parallel data input 0\",\n      \"dir\" : \"in\",\n      \"name\" : \"D0\"\n    },\n    {\n      \"description\" : \"Parallel data input 1\",\n      \"dir\" : \"in\",\n      \"name\" : \"D1\"\n    },\n    {\n      \"description\" : \"Parallel data input 2\",\n      \"dir\" : \"in\",\n      \"name\" : \"D2\"\n    },\n    {\n      \"description\" : \"Parallel data input 3\",\n      \"dir\" : \"in\",\n      \"name\" : \"D3\"\n    },\n    {\n      \"description\" : \"Parallel data input 4\",\n      \"dir\" : \"in\",\n      \"name\" : \"D4\"\n    },\n    {\n      \"description\" : \"Parallel data input 5\",\n      \"dir\" : \"in\",\n      \"name\" : \"D5\"\n    },\n    {\n      \"description\" : \"Parallel data input 6\",\n      \"dir\" : \"in\",\n      \"name\" : \"D6\"\n    },\n    {\n      \"description\" : \"Parallel data input 7\",\n      \"dir\" : \"in\",\n      \"name\" : \"D7\"\n    },\n    {\n      \"description\" : \"Last stage (serial output)\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q7\"\n    },\n    {\n      \"description\" : \"Last stage, inverted\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q7_n\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"asyncInputs\" : [\n      \"PL_n\"\n    ],\n    \"clocks\" : [\n      \"CP\",\n      \"CE_n\"\n    ],\n    \"parts\" : [\n      \"74x165\"\n    ],\n    \"pins\" : {\n      \"1\" : \"PL_n\",\n      \"10\" : \"DS\",\n      \"11\" : \"D0\",\n      \"12\" : \"D1\",\n      \"13\" : \"D2\",\n      \"14\" : \"D3\",\n      \"15\" : \"CE_n\",\n      \"2\" : \"CP\",\n      \"3\" : \"D4\",\n      \"4\" : \"D5\",\n      \"5\" : \"D6\",\n      \"6\" : \"D7\",\n      \"7\" : \"Q7_n\",\n      \"9\" : \"Q7\"\n    }\n  },\n  \"top\" : \"ic74x165\",\n  \"version\" : \"1.0.0\"\n}\n",
    "cores/ic74x165/rtl/ic74x165.v" : "// 74x165: 8-bit parallel-load shift register (74LS165, 74HC165 …). PL_n low loads D0–D7 at once\n// (asynchronously, the outputs follow D7 while it stays low). Otherwise the stages shift on the rising\n// edge of CP OR CE_n — the clock is a gated OR, so CE_n low enables CP (and the two are\n// interchangeable): Q0 takes DS, Q7 is the last stage.\n// Pins: PL_n CP D4 D5 D6 D7 Q7_n = 1 … 7, Q7 DS D0 D1 D2 D3 CE_n = 9 … 15.\n\n`timescale 1ns / 1ps\n\nmodule ic74x165 (\n    input  wire PL_n,\n    input  wire CP,\n    input  wire CE_n,\n    input  wire DS,\n    input  wire D0,\n    input  wire D1,\n    input  wire D2,\n    input  wire D3,\n    input  wire D4,\n    input  wire D5,\n    input  wire D6,\n    input  wire D7,\n    output wire Q7,\n    output wire Q7_n\n);\n    reg [7:0] q = 8'h00;\n    wire clock = CP | CE_n;\n\n    always @(posedge clock or negedge PL_n)\n        if (!PL_n) q <= {D7, D6, D5, D4, D3, D2, D1, D0};\n        else q <= {q[6:0], DS};\n\n    // While PL_n is low the stages follow the data inputs.\n    wire last = PL_n ? q[7] : D7;\n    assign Q7 = last;\n    assign Q7_n = ~last;\nendmodule\n",
    "cores/ic74x165/tb/ic74x165_tb.v" : "// Self-checking testbench for ic74x165: 120 rounds of a parallel load with a pseudo-random byte,\n// then shifting it out with random serial data and CE_n (changed only while CP is high, as the\n// datasheet asks), against a reference register; Q7 follows D7 while PL_n is low.\n\n`timescale 1ns / 1ps\n\nmodule ic74x165_tb;\n    reg pl_n = 1, cp = 0, ce_n = 0, ds = 0;\n    reg [7:0] d = 8'h00;\n    wire q7, q7_n;\n\n    ic74x165 dut (.PL_n(pl_n), .CP(cp), .CE_n(ce_n), .DS(ds),\n                  .D0(d[0]), .D1(d[1]), .D2(d[2]), .D3(d[3]), .D4(d[4]), .D5(d[5]), .D6(d[6]), .D7(d[7]),\n                  .Q7(q7), .Q7_n(q7_n));\n\n    reg [7:0] expected = 8'h00;\n    reg [15:0] lfsr = 16'h1D3B;\n    integer round, k, errors = 0;\n\n    task step;\n        lfsr = {lfsr[14:0], lfsr[15] ^ lfsr[13] ^ lfsr[12] ^ lfsr[10]};\n    endtask\n\n    task check(input [255:0] what);\n        if (q7 !== expected[7] || q7_n !== !expected[7]) begin\n            $display(\"FAIL: %0s: Q7=%b Q7_n=%b, expected Q7=%b (register %b, t=%0t)\", what, q7, q7_n, expected[7], expected, $time);\n            errors = errors + 1;\n        end\n    endtask\n\n    initial begin\n        for (round = 0; round < 120; round = round + 1) begin\n            // Parallel load: the bits come out D7 first.\n            step; d = lfsr[7:0] ^ 8'h36;\n            #2 pl_n = 0;\n            expected = d;\n            #1 check(\"while loading\");\n            d = d ^ 8'h80;                   // follows D7 while PL_n is low\n            expected = d;\n            #1 check(\"D7 while loading\");\n            #1 pl_n = 1;\n            for (k = 0; k < 10; k = k + 1) begin\n                step; ds = lfsr[2];\n                #2 cp = 1;\n                if (!ce_n) expected = {expected[6:0], ds};\n                #1 check(\"after a clock\");\n                ce_n = lfsr[5] & lfsr[9];    // mostly enabled; changed while CP is high\n                #2 cp = 0;\n            end\n            ce_n = 0;\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #10000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x244/README.md" : "# 74x244 — octal three-state buffer\n\nTwo sections of four buffers: each `Y` follows its `A` while the section's `OE_n` is low and floats\notherwise. Ports as TI names them: `1A1` is `A1_1` (section 1, bit 1), `1Y1` is `Y1_1`, `1OE` is\n`OE1_n`. As in the 74LS244 and 74HC244 (KiCad numbers the LS and HC symbols' pins differently —\nI0a/O0a and 1A0/1Y0 — but both pair pin 2 with 18, 11 with 9 and so on, as the datasheet does).\nUsed by GateLab's KiCad import (package pin table in `core.json`).\n",
    "cores/ic74x244/core.json" : "{\n  \"description\" : \"Octal buffer/line driver with three-state outputs in two sections of four with their own output enable (74LS244, 74HC244 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 332.9,\n      \"resources\" : {\n\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 180.7,\n      \"resources\" : {\n\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 136,\n      \"resources\" : {\n\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic74x244\",\n  \"keywords\" : [\n    \"74xx\",\n    \"74244\",\n    \"buffer\",\n    \"line driver\",\n    \"three-state\",\n    \"tri-state\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Achtfacher Puffer/Leitungstreiber mit Tri-State-Ausgängen in zwei Gruppen zu vier mit eigener Ausgangsfreigabe (74LS244, 74HC244 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x244 achtfacher Tri-State-Puffer\"\n    }\n  },\n  \"name\" : \"74x244 octal three-state buffer\",\n  \"ports\" : [\n    {\n      \"description\" : \"Section 1, input 1 (1A1)\",\n      \"dir\" : \"in\",\n      \"name\" : \"A1_1\"\n    },\n    {\n      \"description\" : \"Section 1, input 2 (1A2)\",\n      \"dir\" : \"in\",\n      \"name\" : \"A1_2\"\n    },\n    {\n      \"description\" : \"Section 1, input 3 (1A3)\",\n      \"dir\" : \"in\",\n      \"name\" : \"A1_3\"\n    },\n    {\n      \"description\" : \"Section 1, input 4 (1A4)\",\n      \"dir\" : \"in\",\n      \"name\" : \"A1_4\"\n    },\n    {\n      \"description\" : \"Section 1, output enable, active low (1OE)\",\n      \"dir\" : \"in\",\n      \"name\" : \"OE1_n\"\n    },\n    {\n      \"description\" : \"Section 1, output 1 (1Y1), three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y1_1\"\n    },\n    {\n      \"description\" : \"Section 1, output 2 (1Y2), three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y1_2\"\n    },\n    {\n      \"description\" : \"Section 1, output 3 (1Y3), three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y1_3\"\n    },\n    {\n      \"description\" : \"Section 1, output 4 (1Y4), three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y1_4\"\n    },\n    {\n      \"description\" : \"Section 2, input 1 (2A1)\",\n      \"dir\" : \"in\",\n      \"name\" : \"A2_1\"\n    },\n    {\n      \"description\" : \"Section 2, input 2 (2A2)\",\n      \"dir\" : \"in\",\n      \"name\" : \"A2_2\"\n    },\n    {\n      \"description\" : \"Section 2, input 3 (2A3)\",\n      \"dir\" : \"in\",\n      \"name\" : \"A2_3\"\n    },\n    {\n      \"description\" : \"Section 2, input 4 (2A4)\",\n      \"dir\" : \"in\",\n      \"name\" : \"A2_4\"\n    },\n    {\n      \"description\" : \"Section 2, output enable, active low (2OE)\",\n      \"dir\" : \"in\",\n      \"name\" : \"OE2_n\"\n    },\n    {\n      \"description\" : \"Section 2, output 1 (2Y1), three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y2_1\"\n    },\n    {\n      \"description\" : \"Section 2, output 2 (2Y2), three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y2_2\"\n    },\n    {\n      \"description\" : \"Section 2, output 3 (2Y3), three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y2_3\"\n    },\n    {\n      \"description\" : \"Section 2, output 4 (2Y4), three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y2_4\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"parts\" : [\n      \"74x244\"\n    ],\n    \"pins\" : {\n      \"1\" : \"OE1_n\",\n      \"11\" : \"A2_1\",\n      \"12\" : \"Y1_4\",\n      \"13\" : \"A2_2\",\n      \"14\" : \"Y1_3\",\n      \"15\" : \"A2_3\",\n      \"16\" : \"Y1_2\",\n      \"17\" : \"A2_4\",\n      \"18\" : \"Y1_1\",\n      \"19\" : \"OE2_n\",\n      \"2\" : \"A1_1\",\n      \"3\" : \"Y2_4\",\n      \"4\" : \"A1_2\",\n      \"5\" : \"Y2_3\",\n      \"6\" : \"A1_3\",\n      \"7\" : \"Y2_2\",\n      \"8\" : \"A1_4\",\n      \"9\" : \"Y2_1\"\n    }\n  },\n  \"top\" : \"ic74x244\",\n  \"version\" : \"1.0.0\"\n}\n",
    "cores/ic74x244/rtl/ic74x244.v" : "// 74x244: octal buffer with three-state outputs, two sections of four with their own output enable\n// (74LS244, 74HC244 …). Each Y follows its A while the section's OE_n is low, else floats.\n// Ports as TI names them: 1A1 = A1_1 (section 1, bit 1), 1Y1 = Y1_1, 1OE = OE1_n.\n// Pins: OE1_n A1_1 Y2_4 A1_2 Y2_3 A1_3 Y2_2 A1_4 Y2_1 = 1 … 9,\n//       A2_1 Y1_4 A2_2 Y1_3 A2_3 Y1_2 A2_4 Y1_1 OE2_n = 11 … 19.\n\n`timescale 1ns / 1ps\n\nmodule ic74x244 (\n    input  wire A1_1,\n    input  wire A1_2,\n    input  wire A1_3,\n    input  wire A1_4,\n    input  wire OE1_n,\n    output wire Y1_1,\n    output wire Y1_2,\n    output wire Y1_3,\n    output wire Y1_4,\n    input  wire A2_1,\n    input  wire A2_2,\n    input  wire A2_3,\n    input  wire A2_4,\n    input  wire OE2_n,\n    output wire Y2_1,\n    output wire Y2_2,\n    output wire Y2_3,\n    output wire Y2_4\n);\n    assign Y1_1 = OE1_n ? 1'bz : A1_1;\n    assign Y1_2 = OE1_n ? 1'bz : A1_2;\n    assign Y1_3 = OE1_n ? 1'bz : A1_3;\n    assign Y1_4 = OE1_n ? 1'bz : A1_4;\n    assign Y2_1 = OE2_n ? 1'bz : A2_1;\n    assign Y2_2 = OE2_n ? 1'bz : A2_2;\n    assign Y2_3 = OE2_n ? 1'bz : A2_3;\n    assign Y2_4 = OE2_n ? 1'bz : A2_4;\nendmodule\n",
    "cores/ic74x244/tb/ic74x244_tb.v" : "// Self-checking testbench for ic74x244: every input word with every pair of enables (1,024 cases);\n// a disabled section floats, and the two sections don't share an enable.\n\n`timescale 1ns / 1ps\n\nmodule ic74x244_tb;\n    reg  [3:0] a1, a2;\n    reg  oe1_n, oe2_n;\n    wire [3:0] y1, y2;\n\n    ic74x244 dut (.A1_1(a1[0]), .A1_2(a1[1]), .A1_3(a1[2]), .A1_4(a1[3]), .OE1_n(oe1_n),\n                  .Y1_1(y1[0]), .Y1_2(y1[1]), .Y1_3(y1[2]), .Y1_4(y1[3]),\n                  .A2_1(a2[0]), .A2_2(a2[1]), .A2_3(a2[2]), .A2_4(a2[3]), .OE2_n(oe2_n),\n                  .Y2_1(y2[0]), .Y2_2(y2[1]), .Y2_3(y2[2]), .Y2_4(y2[3]));\n\n    integer i, errors = 0;\n    reg [3:0] e1, e2;\n    initial begin\n        for (i = 0; i < 1024; i = i + 1) begin\n            {oe2_n, oe1_n, a2, a1} = i[9:0];\n            #1;\n            e1 = oe1_n ? 4'bzzzz : a1;\n            e2 = oe2_n ? 4'bzzzz : a2;\n            if (y1 !== e1 || y2 !== e2) begin\n                $display(\"FAIL: A1=%b A2=%b OE1_n=%b OE2_n=%b gave Y1=%b Y2=%b, expected %b %b\", a1, a2, oe1_n, oe2_n, y1, y2, e1, e2);\n                errors = errors + 1;\n            end\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #10000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x245/README.md" : "# 74x245 — octal bus transceiver\n\nWith `OE_n` low, `DIR` high drives the B side from the A side and `DIR` low the A side from the B\nside; with `OE_n` high both sides float. `A1`–`A8` and `B1`–`B8` are bidirectional (TI's names;\nKiCad calls them A0–A7 and B0–B7 and the enable CE). As in the 74LS245 and 74HC245. Used by GateLab's\nKiCad import (package pin table in `core.json`). Inside an FPGA there are no bidirectional\nwires: the FPGA version of a design picks one direction per signal.\n",
    "cores/ic74x245/core.json" : "{\n  \"description\" : \"Octal bus transceiver with three-state outputs, direction and enable (74LS245, 74HC245 …), with the package pin table for the KiCad import.\",\n  \"id\" : \"ic74x245\",\n  \"keywords\" : [\n    \"74xx\",\n    \"74245\",\n    \"transceiver\",\n    \"bus\",\n    \"bidirectional\",\n    \"three-state\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Achtfacher Bus-Transceiver mit Tri-State-Ausgängen, Richtung und Freigabe (74LS245, 74HC245 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x245 achtfacher Bus-Transceiver\"\n    }\n  },\n  \"name\" : \"74x245 octal bus transceiver\",\n  \"ports\" : [\n    {\n      \"description\" : \"Direction: high drives B from A, low A from B\",\n      \"dir\" : \"in\",\n      \"name\" : \"DIR\"\n    },\n    {\n      \"description\" : \"Output enable, active low (both sides float while high)\",\n      \"dir\" : \"in\",\n      \"name\" : \"OE_n\"\n    },\n    {\n      \"description\" : \"A side, bit 1\",\n      \"dir\" : \"inout\",\n      \"name\" : \"A1\"\n    },\n    {\n      \"description\" : \"A side, bit 2\",\n      \"dir\" : \"inout\",\n      \"name\" : \"A2\"\n    },\n    {\n      \"description\" : \"A side, bit 3\",\n      \"dir\" : \"inout\",\n      \"name\" : \"A3\"\n    },\n    {\n      \"description\" : \"A side, bit 4\",\n      \"dir\" : \"inout\",\n      \"name\" : \"A4\"\n    },\n    {\n      \"description\" : \"A side, bit 5\",\n      \"dir\" : \"inout\",\n      \"name\" : \"A5\"\n    },\n    {\n      \"description\" : \"A side, bit 6\",\n      \"dir\" : \"inout\",\n      \"name\" : \"A6\"\n    },\n    {\n      \"description\" : \"A side, bit 7\",\n      \"dir\" : \"inout\",\n      \"name\" : \"A7\"\n    },\n    {\n      \"description\" : \"A side, bit 8\",\n      \"dir\" : \"inout\",\n      \"name\" : \"A8\"\n    },\n    {\n      \"description\" : \"B side, bit 1\",\n      \"dir\" : \"inout\",\n      \"name\" : \"B1\"\n    },\n    {\n      \"description\" : \"B side, bit 2\",\n      \"dir\" : \"inout\",\n      \"name\" : \"B2\"\n    },\n    {\n      \"description\" : \"B side, bit 3\",\n      \"dir\" : \"inout\",\n      \"name\" : \"B3\"\n    },\n    {\n      \"description\" : \"B side, bit 4\",\n      \"dir\" : \"inout\",\n      \"name\" : \"B4\"\n    },\n    {\n      \"description\" : \"B side, bit 5\",\n      \"dir\" : \"inout\",\n      \"name\" : \"B5\"\n    },\n    {\n      \"description\" : \"B side, bit 6\",\n      \"dir\" : \"inout\",\n      \"name\" : \"B6\"\n    },\n    {\n      \"description\" : \"B side, bit 7\",\n      \"dir\" : \"inout\",\n      \"name\" : \"B7\"\n    },\n    {\n      \"description\" : \"B side, bit 8\",\n      \"dir\" : \"inout\",\n      \"name\" : \"B8\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"parts\" : [\n      \"74x245\"\n    ],\n    \"pins\" : {\n      \"1\" : \"DIR\",\n      \"11\" : \"B8\",\n      \"12\" : \"B7\",\n      \"13\" : \"B6\",\n      \"14\" : \"B5\",\n      \"15\" : \"B4\",\n      \"16\" : \"B3\",\n      \"17\" : \"B2\",\n      \"18\" : \"B1\",\n      \"19\" : \"OE_n\",\n      \"2\" : \"A1\",\n      \"3\" : \"A2\",\n      \"4\" : \"A3\",\n      \"5\" : \"A4\",\n      \"6\" : \"A5\",\n      \"7\" : \"A6\",\n      \"8\" : \"A7\",\n      \"9\" : \"A8\"\n    }\n  },\n  \"top\" : \"ic74x245\",\n  \"version\" : \"1.0.0\"\n}\n",
    "cores/ic74x245/rtl/ic74x245.v" : "// 74x245: octal bus transceiver with three-state outputs (74LS245, 74HC245 …). With OE_n low, DIR\n// high drives B from A, DIR low drives A from B; with OE_n high both sides float.\n// Pins: DIR A1 … A8 = 1 … 9, B8 … B1 OE_n = 11 … 19 (pin 18 is B1).\n\n`timescale 1ns / 1ps\n\nmodule ic74x245 (\n    input  wire DIR,\n    input  wire OE_n,\n    inout  wire A1,\n    inout  wire A2,\n    inout  wire A3,\n    inout  wire A4,\n    inout  wire A5,\n    inout  wire A6,\n    inout  wire A7,\n    inout  wire A8,\n    inout  wire B1,\n    inout  wire B2,\n    inout  wire B3,\n    inout  wire B4,\n    inout  wire B5,\n    inout  wire B6,\n    inout  wire B7,\n    inout  wire B8\n);\n    assign B1 = (!OE_n && DIR) ? A1 : 1'bz;\n    assign B2 = (!OE_n && DIR) ? A2 : 1'bz;\n    assign B3 = (!OE_n && DIR) ? A3 : 1'bz;\n    assign B4 = (!OE_n && DIR) ? A4 : 1'bz;\n    assign B5 = (!OE_n && DIR) ? A5 : 1'bz;\n    assign B6 = (!OE_n && DIR) ? A6 : 1'bz;\n    assign B7 = (!OE_n && DIR) ? A7 : 1'bz;\n    assign B8 = (!OE_n && DIR) ? A8 : 1'bz;\n    assign A1 = (!OE_n && !DIR) ? B1 : 1'bz;\n    assign A2 = (!OE_n && !DIR) ? B2 : 1'bz;\n    assign A3 = (!OE_n && !DIR) ? B3 : 1'bz;\n    assign A4 = (!OE_n && !DIR) ? B4 : 1'bz;\n    assign A5 = (!OE_n && !DIR) ? B5 : 1'bz;\n    assign A6 = (!OE_n && !DIR) ? B6 : 1'bz;\n    assign A7 = (!OE_n && !DIR) ? B7 : 1'bz;\n    assign A8 = (!OE_n && !DIR) ? B8 : 1'bz;\nendmodule\n",
    "cores/ic74x245/tb/ic74x245_tb.v" : "// Self-checking testbench for ic74x245: every byte through A to B and back through B to A, both\n// sides floating while disabled, and the receiving side never driven by the testbench.\n\n`timescale 1ns / 1ps\n\nmodule ic74x245_tb;\n    reg  dir = 1, oe_n = 1;\n    reg  [7:0] drive_a = 8'h00, drive_b = 8'h00;\n    reg  a_on = 0, b_on = 0;\n    wire [7:0] a = a_on ? drive_a : 8'bzzzzzzzz;\n    wire [7:0] b = b_on ? drive_b : 8'bzzzzzzzz;\n\n    ic74x245 dut (.DIR(dir), .OE_n(oe_n),\n                  .A1(a[0]), .A2(a[1]), .A3(a[2]), .A4(a[3]), .A5(a[4]), .A6(a[5]), .A7(a[6]), .A8(a[7]),\n                  .B1(b[0]), .B2(b[1]), .B3(b[2]), .B4(b[3]), .B5(b[4]), .B6(b[5]), .B7(b[6]), .B8(b[7]));\n\n    integer i, errors = 0;\n    initial begin\n        for (i = 0; i < 256; i = i + 1) begin\n            // A to B.\n            b_on = 0; dir = 1; oe_n = 0; drive_a = i[7:0]; a_on = 1;\n            #1 if (b !== drive_a) begin $display(\"FAIL: A=%b to B gave %b\", drive_a, b); errors = errors + 1; end\n            // Disabled: B floats.\n            oe_n = 1;\n            #1 if (b !== 8'bzzzzzzzz) begin $display(\"FAIL: disabled, B=%b\", b); errors = errors + 1; end\n            // B to A (a different byte, so a stuck A would show).\n            a_on = 0; dir = 0; drive_b = i[7:0] ^ 8'h5C; b_on = 1; oe_n = 0;\n            #1 if (a !== drive_b) begin $display(\"FAIL: B=%b to A gave %b\", drive_b, a); errors = errors + 1; end\n            oe_n = 1;\n            #1 if (a !== 8'bzzzzzzzz) begin $display(\"FAIL: disabled, A=%b\", a); errors = errors + 1; end\n            b_on = 0;\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #10000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x32/README.md" : "# 74x32 — quad 2-input OR gate\n\nFour independent OR gates, `Yn = An | Bn`, as in the 74LS32, 74HC32 and\n74HCT32. Used by GateLab's KiCad import: the package pin table in `core.json` maps KiCad's pin\nnumbers to the ports. Zero-delay model — for simulation and as an FPGA starting point; synthesis maps it to LUTs.\n",
    "cores/ic74x32/core.json" : "{\n  \"description\" : \"Four 2-input OR gates (74LS32, 74HC32 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 328.9,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 4\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 241.5,\n      \"resources\" : {\n        \"CPE_BRIDGE\" : 1\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"LUT4\" : 4\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 136,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 4\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic74x32\",\n  \"keywords\" : [\n    \"74xx\",\n    \"7400\",\n    \"7432\",\n    \"or\",\n    \"gate\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Vier ODER-Gatter mit 2 Eingängen (74LS32, 74HC32 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x32 vierfach ODER mit 2 Eingängen\"\n    }\n  },\n  \"name\" : \"74x32 quad 2-input OR\",\n  \"ports\" : [\n    {\n      \"description\" : \"Gate 1, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A1\"\n    },\n    {\n      \"description\" : \"Gate 1, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B1\"\n    },\n    {\n      \"description\" : \"Gate 1, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y1\"\n    },\n    {\n      \"description\" : \"Gate 2, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A2\"\n    },\n    {\n      \"description\" : \"Gate 2, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B2\"\n    },\n    {\n      \"description\" : \"Gate 2, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y2\"\n    },\n    {\n      \"description\" : \"Gate 3, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A3\"\n    },\n    {\n      \"description\" : \"Gate 3, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B3\"\n    },\n    {\n      \"description\" : \"Gate 3, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y3\"\n    },\n    {\n      \"description\" : \"Gate 4, input A\",\n      \"dir\" : \"in\",\n      \"name\" : \"A4\"\n    },\n    {\n      \"description\" : \"Gate 4, input B\",\n      \"dir\" : \"in\",\n      \"name\" : \"B4\"\n    },\n    {\n      \"description\" : \"Gate 4, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Y4\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"parts\" : [\n      \"74x32\"\n    ],\n    \"pins\" : {\n      \"1\" : \"A1\",\n      \"10\" : \"B3\",\n      \"11\" : \"Y4\",\n      \"12\" : \"A4\",\n      \"13\" : \"B4\",\n      \"2\" : \"B1\",\n      \"3\" : \"Y1\",\n      \"4\" : \"A2\",\n      \"5\" : \"B2\",\n      \"6\" : \"Y2\",\n      \"8\" : \"Y3\",\n      \"9\" : \"A3\"\n    }\n  },\n  \"top\" : \"ic74x32\",\n  \"version\" : \"1.0.1\"\n}\n",
    "cores/ic74x32/rtl/ic74x32.v" : "// 74x32: quad 2-input OR gate (74LS32, 74HC32, 74HCT32 …).\n// Zero-delay model; pins: 1A 1B 1Y = 1 2 3, 2A 2B 2Y = 4 5 6, 3Y 3A 3B = 8 9 10, 4Y 4A 4B = 11 12 13.\n\n`timescale 1ns / 1ps\n\nmodule ic74x32 (\n    input  wire A1,\n    input  wire B1,\n    output wire Y1,\n    input  wire A2,\n    input  wire B2,\n    output wire Y2,\n    input  wire A3,\n    input  wire B3,\n    output wire Y3,\n    input  wire A4,\n    input  wire B4,\n    output wire Y4\n);\n    assign Y1 = A1 | B1;\n    assign Y2 = A2 | B2;\n    assign Y3 = A3 | B3;\n    assign Y4 = A4 | B4;\nendmodule\n",
    "cores/ic74x32/tb/ic74x32_tb.v" : "// Self-checking testbench for ic74x32: all 256 combinations of the four gates' inputs.\n\n`timescale 1ns / 1ps\n\nmodule ic74x32_tb;\n    reg  [3:0] a, b;\n    wire [3:0] y;\n\n    ic74x32 dut (.A1(a[0]), .B1(b[0]), .Y1(y[0]), .A2(a[1]), .B2(b[1]), .Y2(y[1]), .A3(a[2]), .B3(b[2]), .Y3(y[2]), .A4(a[3]), .B4(b[3]), .Y4(y[3]));\n\n    integer i, errors = 0;\n    initial begin\n        for (i = 0; i < 256; i = i + 1) begin\n            {a, b} = i[7:0];\n            #1;\n            if (y !== (a | b)) begin\n                $display(\"FAIL: a=%b b=%b gave y=%b, expected %b\", a, b, y, a | b);\n                errors = errors + 1;\n            end\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #1000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x373/README.md" : "# 74x373 — octal transparent latch\n\nWhile `LE` is high the latches follow `D0`–`D7`; when `LE` falls they hold. The outputs show the\nlatches while `OE_n` is low and float otherwise — the latches keep working. As in the 74LS373 and\n74HC373 (KiCad names the outputs O0–O7). A latch on an FPGA is a timing hazard (many families\nhave none and build it from a LUT loop): the FPGA version of a design uses a flip-flop with an\nenable. Used by GateLab's KiCad import (package pin table in `core.json`).\n",
    "cores/ic74x373/core.json" : "{\n  \"description\" : \"Octal transparent latch with three-state outputs (74LS373, 74HC373 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"tested\" : false\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 237.2,\n      \"resources\" : {\n\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"DFF\" : 8,\n        \"LUT4\" : 8\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"tested\" : false\n    }\n  },\n  \"id\" : \"ic74x373\",\n  \"keywords\" : [\n    \"74xx\",\n    \"74373\",\n    \"latch\",\n    \"register\",\n    \"three-state\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Achtfaches transparentes Latch mit Tri-State-Ausgängen (74LS373, 74HC373 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x373 achtfaches transparentes Latch\"\n    }\n  },\n  \"name\" : \"74x373 octal transparent latch\",\n  \"ports\" : [\n    {\n      \"description\" : \"Data input 0\",\n      \"dir\" : \"in\",\n      \"name\" : \"D0\"\n    },\n    {\n      \"description\" : \"Data input 1\",\n      \"dir\" : \"in\",\n      \"name\" : \"D1\"\n    },\n    {\n      \"description\" : \"Data input 2\",\n      \"dir\" : \"in\",\n      \"name\" : \"D2\"\n    },\n    {\n      \"description\" : \"Data input 3\",\n      \"dir\" : \"in\",\n      \"name\" : \"D3\"\n    },\n    {\n      \"description\" : \"Data input 4\",\n      \"dir\" : \"in\",\n      \"name\" : \"D4\"\n    },\n    {\n      \"description\" : \"Data input 5\",\n      \"dir\" : \"in\",\n      \"name\" : \"D5\"\n    },\n    {\n      \"description\" : \"Data input 6\",\n      \"dir\" : \"in\",\n      \"name\" : \"D6\"\n    },\n    {\n      \"description\" : \"Data input 7\",\n      \"dir\" : \"in\",\n      \"name\" : \"D7\"\n    },\n    {\n      \"description\" : \"Latch enable: transparent while high, holds when it falls\",\n      \"dir\" : \"in\",\n      \"name\" : \"LE\"\n    },\n    {\n      \"description\" : \"Output enable, active low (outputs float while high)\",\n      \"dir\" : \"in\",\n      \"name\" : \"OE_n\"\n    },\n    {\n      \"description\" : \"Output 0, three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q0\"\n    },\n    {\n      \"description\" : \"Output 1, three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q1\"\n    },\n    {\n      \"description\" : \"Output 2, three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q2\"\n    },\n    {\n      \"description\" : \"Output 3, three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q3\"\n    },\n    {\n      \"description\" : \"Output 4, three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q4\"\n    },\n    {\n      \"description\" : \"Output 5, three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q5\"\n    },\n    {\n      \"description\" : \"Output 6, three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q6\"\n    },\n    {\n      \"description\" : \"Output 7, three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q7\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"parts\" : [\n      \"74x373\"\n    ],\n    \"pins\" : {\n      \"1\" : \"OE_n\",\n      \"11\" : \"LE\",\n      \"12\" : \"Q4\",\n      \"13\" : \"D4\",\n      \"14\" : \"D5\",\n      \"15\" : \"Q5\",\n      \"16\" : \"Q6\",\n      \"17\" : \"D6\",\n      \"18\" : \"D7\",\n      \"19\" : \"Q7\",\n      \"2\" : \"Q0\",\n      \"3\" : \"D0\",\n      \"4\" : \"D1\",\n      \"5\" : \"Q1\",\n      \"6\" : \"Q2\",\n      \"7\" : \"D2\",\n      \"8\" : \"D3\",\n      \"9\" : \"Q3\"\n    }\n  },\n  \"top\" : \"ic74x373\",\n  \"version\" : \"1.0.0\"\n}\n",
    "cores/ic74x373/rtl/ic74x373.v" : "// 74x373: octal transparent latch with three-state outputs (74LS373, 74HC373 …). While LE is high\n// the latches follow D; when LE falls they hold. The outputs show the latches while OE_n is low\n// and float otherwise (the latches keep working).\n// Pins: OE_n Q0 D0 D1 Q1 Q2 D2 D3 Q3 = 1 … 9, LE Q4 D4 D5 Q5 Q6 D6 D7 Q7 = 11 … 19.\n\n`timescale 1ns / 1ps\n\nmodule ic74x373 (\n    input  wire D0,\n    input  wire D1,\n    input  wire D2,\n    input  wire D3,\n    input  wire D4,\n    input  wire D5,\n    input  wire D6,\n    input  wire D7,\n    input  wire LE,\n    input  wire OE_n,\n    output wire Q0,\n    output wire Q1,\n    output wire Q2,\n    output wire Q3,\n    output wire Q4,\n    output wire Q5,\n    output wire Q6,\n    output wire Q7\n);\n    // No start value: the real part powers up undefined (and Gowin refuses initialised latches).\n    reg [7:0] q;\n    always @*\n        if (LE) q = {D7, D6, D5, D4, D3, D2, D1, D0};\n\n    assign {Q7, Q6, Q5, Q4, Q3, Q2, Q1, Q0} = OE_n ? 8'bzzzzzzzz : q;\nendmodule\n",
    "cores/ic74x373/tb/ic74x373_tb.v" : "// Self-checking testbench for ic74x373: 400 steps of pseudo-random data, latch enable and output\n// enable against a reference latch — transparent while LE is high, holding after it falls, and\n// still latching while the outputs float.\n\n`timescale 1ns / 1ps\n\nmodule ic74x373_tb;\n    reg  [7:0] d = 8'h00;\n    reg  le = 0, oe_n = 0;\n    wire [7:0] q;\n\n    ic74x373 dut (.LE(le), .OE_n(oe_n), .D0(d[0]), .D1(d[1]), .D2(d[2]), .D3(d[3]), .D4(d[4]), .D5(d[5]), .D6(d[6]), .D7(d[7]), .Q0(q[0]), .Q1(q[1]), .Q2(q[2]), .Q3(q[3]), .Q4(q[4]), .Q5(q[5]), .Q6(q[6]), .Q7(q[7]));\n\n    reg [7:0] held = 8'h00;\n    reg [15:0] lfsr = 16'h7A31;\n    integer i, errors = 0;\n\n    task check(input [255:0] what);\n        if (q !== (oe_n ? 8'bzzzzzzzz : held)) begin\n            $display(\"FAIL: %0s: Q=%b, expected %b (LE=%b OE_n=%b, t=%0t)\", what, q, oe_n ? 8'bzzzzzzzz : held, le, oe_n, $time);\n            errors = errors + 1;\n        end\n    endtask\n\n    initial begin\n        // The latches power up undefined: open them once first.\n        le = 1; d = 8'h00; held = 8'h00;\n        #1 check(\"first open\");\n        for (i = 0; i < 400; i = i + 1) begin\n            lfsr = {lfsr[14:0], lfsr[15] ^ lfsr[13] ^ lfsr[12] ^ lfsr[10]};\n            oe_n = lfsr[9] & lfsr[3];\n            le = lfsr[5];\n            d = lfsr[15:8] ^ 8'hA6;\n            if (le) held = d;\n            #1 check(\"after D or LE\");\n            d = d ^ 8'h3B;                 // D moves on: followed while LE is high, ignored after\n            if (le) held = d;\n            #1 check(\"D changed\");\n            le = 0;\n            #1 check(\"LE fell\");\n            d = d ^ 8'hC4;\n            #1 check(\"held\");\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #10000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x374/README.md" : "# 74x374 — octal D flip-flop\n\nOn each rising `CP` edge the flip-flops take `D0`–`D7`. The outputs show them while `OE_n` is low\nand float otherwise — the flip-flops keep clocking. As in the 74LS374 and 74HC374 (KiCad names the\noutputs O0–O7 and the clock Cp). Used by GateLab's KiCad import (package pin table in `core.json`).\n",
    "cores/ic74x374/core.json" : "{\n  \"description\" : \"Octal D flip-flop with three-state outputs (74LS374, 74HC374 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 326.6,\n      \"resources\" : {\n        \"TRELLIS_FF\" : 8\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 177.1,\n      \"resources\" : {\n        \"CPE_BRIDGE\" : 1,\n        \"CPE_CPLINES\" : 2\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"DFF\" : 8,\n        \"LUT4\" : 8\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 136,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 8\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic74x374\",\n  \"keywords\" : [\n    \"74xx\",\n    \"74374\",\n    \"flip-flop\",\n    \"register\",\n    \"three-state\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Achtfaches D-Flipflop mit Tri-State-Ausgängen (74LS374, 74HC374 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x374 achtfaches D-Flipflop\"\n    }\n  },\n  \"name\" : \"74x374 octal D flip-flop\",\n  \"ports\" : [\n    {\n      \"description\" : \"Data input 0\",\n      \"dir\" : \"in\",\n      \"name\" : \"D0\"\n    },\n    {\n      \"description\" : \"Data input 1\",\n      \"dir\" : \"in\",\n      \"name\" : \"D1\"\n    },\n    {\n      \"description\" : \"Data input 2\",\n      \"dir\" : \"in\",\n      \"name\" : \"D2\"\n    },\n    {\n      \"description\" : \"Data input 3\",\n      \"dir\" : \"in\",\n      \"name\" : \"D3\"\n    },\n    {\n      \"description\" : \"Data input 4\",\n      \"dir\" : \"in\",\n      \"name\" : \"D4\"\n    },\n    {\n      \"description\" : \"Data input 5\",\n      \"dir\" : \"in\",\n      \"name\" : \"D5\"\n    },\n    {\n      \"description\" : \"Data input 6\",\n      \"dir\" : \"in\",\n      \"name\" : \"D6\"\n    },\n    {\n      \"description\" : \"Data input 7\",\n      \"dir\" : \"in\",\n      \"name\" : \"D7\"\n    },\n    {\n      \"description\" : \"Clock, rising edge\",\n      \"dir\" : \"in\",\n      \"name\" : \"CP\"\n    },\n    {\n      \"description\" : \"Output enable, active low (outputs float while high)\",\n      \"dir\" : \"in\",\n      \"name\" : \"OE_n\"\n    },\n    {\n      \"description\" : \"Output 0, three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q0\"\n    },\n    {\n      \"description\" : \"Output 1, three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q1\"\n    },\n    {\n      \"description\" : \"Output 2, three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q2\"\n    },\n    {\n      \"description\" : \"Output 3, three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q3\"\n    },\n    {\n      \"description\" : \"Output 4, three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q4\"\n    },\n    {\n      \"description\" : \"Output 5, three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q5\"\n    },\n    {\n      \"description\" : \"Output 6, three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q6\"\n    },\n    {\n      \"description\" : \"Output 7, three-state\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q7\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"clocks\" : [\n      \"CP\"\n    ],\n    \"parts\" : [\n      \"74x374\"\n    ],\n    \"pins\" : {\n      \"1\" : \"OE_n\",\n      \"11\" : \"CP\",\n      \"12\" : \"Q4\",\n      \"13\" : \"D4\",\n      \"14\" : \"D5\",\n      \"15\" : \"Q5\",\n      \"16\" : \"Q6\",\n      \"17\" : \"D6\",\n      \"18\" : \"D7\",\n      \"19\" : \"Q7\",\n      \"2\" : \"Q0\",\n      \"3\" : \"D0\",\n      \"4\" : \"D1\",\n      \"5\" : \"Q1\",\n      \"6\" : \"Q2\",\n      \"7\" : \"D2\",\n      \"8\" : \"D3\",\n      \"9\" : \"Q3\"\n    }\n  },\n  \"top\" : \"ic74x374\",\n  \"version\" : \"1.0.0\"\n}\n",
    "cores/ic74x374/rtl/ic74x374.v" : "// 74x374: octal D flip-flop with three-state outputs (74LS374, 74HC374 …). On each rising CP edge\n// the flip-flops take D. The outputs show them while OE_n is low and float otherwise (the\n// flip-flops keep clocking).\n// Pins: OE_n Q0 D0 D1 Q1 Q2 D2 D3 Q3 = 1 … 9, CP Q4 D4 D5 Q5 Q6 D6 D7 Q7 = 11 … 19.\n\n`timescale 1ns / 1ps\n\nmodule ic74x374 (\n    input  wire D0,\n    input  wire D1,\n    input  wire D2,\n    input  wire D3,\n    input  wire D4,\n    input  wire D5,\n    input  wire D6,\n    input  wire D7,\n    input  wire CP,\n    input  wire OE_n,\n    output wire Q0,\n    output wire Q1,\n    output wire Q2,\n    output wire Q3,\n    output wire Q4,\n    output wire Q5,\n    output wire Q6,\n    output wire Q7\n);\n    reg [7:0] q = 8'h00;\n    always @(posedge CP)\n        q <= {D7, D6, D5, D4, D3, D2, D1, D0};\n\n    assign {Q7, Q6, Q5, Q4, Q3, Q2, Q1, Q0} = OE_n ? 8'bzzzzzzzz : q;\nendmodule\n",
    "cores/ic74x374/tb/ic74x374_tb.v" : "// Self-checking testbench for ic74x374: 400 clocks of pseudo-random data and output enable against\n// a reference register — D taken only on the rising edge, and still taken while the outputs float.\n\n`timescale 1ns / 1ps\n\nmodule ic74x374_tb;\n    reg  [7:0] d = 8'h00;\n    reg  cp = 0, oe_n = 0;\n    wire [7:0] q;\n\n    ic74x374 dut (.CP(cp), .OE_n(oe_n), .D0(d[0]), .D1(d[1]), .D2(d[2]), .D3(d[3]), .D4(d[4]), .D5(d[5]), .D6(d[6]), .D7(d[7]), .Q0(q[0]), .Q1(q[1]), .Q2(q[2]), .Q3(q[3]), .Q4(q[4]), .Q5(q[5]), .Q6(q[6]), .Q7(q[7]));\n\n    reg [7:0] stored = 8'h00;\n    reg [15:0] lfsr = 16'h2C9D;\n    integer i, errors = 0;\n\n    task check(input [255:0] what);\n        if (q !== (oe_n ? 8'bzzzzzzzz : stored)) begin\n            $display(\"FAIL: %0s: Q=%b, expected %b (OE_n=%b, t=%0t)\", what, q, oe_n ? 8'bzzzzzzzz : stored, oe_n, $time);\n            errors = errors + 1;\n        end\n    endtask\n\n    initial begin\n        for (i = 0; i < 400; i = i + 1) begin\n            lfsr = {lfsr[14:0], lfsr[15] ^ lfsr[13] ^ lfsr[12] ^ lfsr[10]};\n            oe_n = lfsr[9] & lfsr[3];\n            d = lfsr[15:8] ^ 8'h93;\n            #1 check(\"D before the edge\");  // not taken yet\n            #2 cp = 1;\n            stored = d;\n            #1 check(\"after the edge\");\n            d = d ^ 8'h5E;                  // changes while CP is high: not taken\n            #1 check(\"D while high\");\n            #2 cp = 0;\n            #1 check(\"falling edge\");\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #10000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x595/README.md" : "# 74x595 — 8-bit shift register with output latches\n\n`SRCLK` rising shifts the register on (stage A takes `SER`); `SRCLR_n` low clears it, the latches\nkeep theirs. `RCLK` rising copies the shift register into the latches, which drive `QA`–`QH` while\n`OE_n` is low and float otherwise. `QH_prime` (the datasheet's `QH'`) is the shift register's last\nstage for cascading, never three-state. As in the 74HC595 (KiCad names the pins SER, SRCLK, ~SRCLR,\nRCLK, ~OE, QA–QH and QH'). Used by GateLab's KiCad import (package pin table in `core.json`).\n",
    "cores/ic74x595/core.json" : "{\n  \"description\" : \"8-bit serial-in shift register with output latches, three-state outputs and a cascade output (74HC595, 74LS595 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"fmaxMHz\" : 388.5,\n      \"resources\" : {\n        \"TRELLIS_COMB\" : 1,\n        \"TRELLIS_FF\" : 16\n      },\n      \"tested\" : true\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 190.4,\n      \"resources\" : {\n\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"resources\" : {\n        \"DFF\" : 16,\n        \"LUT4\" : 17\n      },\n      \"tested\" : true\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"fmaxMHz\" : 131.7,\n      \"resources\" : {\n        \"ICESTORM_LC\" : 17\n      },\n      \"tested\" : true\n    }\n  },\n  \"id\" : \"ic74x595\",\n  \"keywords\" : [\n    \"74xx\",\n    \"74595\",\n    \"shift register\",\n    \"serial to parallel\",\n    \"latch\",\n    \"led driver\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"8-Bit-Schieberegister seriell ein, mit Ausgangsregister, Tri-State-Ausgängen und Kaskadenausgang (74HC595, 74LS595 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x595 8-Bit-Schieberegister mit Ausgangsregister\"\n    }\n  },\n  \"name\" : \"74x595 8-bit shift register with output latches\",\n  \"ports\" : [\n    {\n      \"description\" : \"Serial data input (into stage A)\",\n      \"dir\" : \"in\",\n      \"name\" : \"SER\"\n    },\n    {\n      \"description\" : \"Shift register clock, rising edge\",\n      \"dir\" : \"in\",\n      \"name\" : \"SRCLK\"\n    },\n    {\n      \"description\" : \"Shift register clear, asynchronous, active low (the latches keep theirs)\",\n      \"dir\" : \"in\",\n      \"name\" : \"SRCLR_n\"\n    },\n    {\n      \"description\" : \"Latch (storage register) clock, rising edge\",\n      \"dir\" : \"in\",\n      \"name\" : \"RCLK\"\n    },\n    {\n      \"description\" : \"Output enable for QA–QH, active low\",\n      \"dir\" : \"in\",\n      \"name\" : \"OE_n\"\n    },\n    {\n      \"description\" : \"Latch output A (three-state)\",\n      \"dir\" : \"out\",\n      \"name\" : \"QA\"\n    },\n    {\n      \"description\" : \"Latch output B (three-state)\",\n      \"dir\" : \"out\",\n      \"name\" : \"QB\"\n    },\n    {\n      \"description\" : \"Latch output C (three-state)\",\n      \"dir\" : \"out\",\n      \"name\" : \"QC\"\n    },\n    {\n      \"description\" : \"Latch output D (three-state)\",\n      \"dir\" : \"out\",\n      \"name\" : \"QD\"\n    },\n    {\n      \"description\" : \"Latch output E (three-state)\",\n      \"dir\" : \"out\",\n      \"name\" : \"QE\"\n    },\n    {\n      \"description\" : \"Latch output F (three-state)\",\n      \"dir\" : \"out\",\n      \"name\" : \"QF\"\n    },\n    {\n      \"description\" : \"Latch output G (three-state)\",\n      \"dir\" : \"out\",\n      \"name\" : \"QG\"\n    },\n    {\n      \"description\" : \"Latch output H (three-state)\",\n      \"dir\" : \"out\",\n      \"name\" : \"QH\"\n    },\n    {\n      \"description\" : \"Serial output QH' (the shift register's last stage), for cascading\",\n      \"dir\" : \"out\",\n      \"name\" : \"QH_prime\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"asyncInputs\" : [\n      \"SRCLR_n\"\n    ],\n    \"clocks\" : [\n      \"SRCLK\",\n      \"RCLK\"\n    ],\n    \"parts\" : [\n      \"74x595\"\n    ],\n    \"pins\" : {\n      \"1\" : \"QB\",\n      \"10\" : \"SRCLR_n\",\n      \"11\" : \"SRCLK\",\n      \"12\" : \"RCLK\",\n      \"13\" : \"OE_n\",\n      \"14\" : \"SER\",\n      \"15\" : \"QA\",\n      \"2\" : \"QC\",\n      \"3\" : \"QD\",\n      \"4\" : \"QE\",\n      \"5\" : \"QF\",\n      \"6\" : \"QG\",\n      \"7\" : \"QH\",\n      \"9\" : \"QH_prime\"\n    }\n  },\n  \"top\" : \"ic74x595\",\n  \"version\" : \"1.0.0\"\n}\n",
    "cores/ic74x595/rtl/ic74x595.v" : "// 74x595: 8-bit shift register with output latches and three-state outputs (74HC595, 74LS595 …).\n// SRCLK rising: the shift register moves on, stage A taking SER; SRCLR_n low clears it (the latches\n// keep their value). RCLK rising copies the shift register into the latches, which drive QA–QH while\n// OE_n is low (high-impedance otherwise). QH_prime (the datasheet's QH') is the shift register's\n// last stage, for cascading; it is never three-state.\n// Pins: QB … QH = 1 … 7, QH_prime SRCLR_n SRCLK RCLK OE_n SER QA = 9 … 15.\n\n`timescale 1ns / 1ps\n\nmodule ic74x595 (\n    input  wire SER,\n    input  wire SRCLK,\n    input  wire SRCLR_n,\n    input  wire RCLK,\n    input  wire OE_n,\n    output wire QA,\n    output wire QB,\n    output wire QC,\n    output wire QD,\n    output wire QE,\n    output wire QF,\n    output wire QG,\n    output wire QH,\n    output wire QH_prime\n);\n    reg [7:0] shift = 8'h00;   // bit 0 = stage A\n    reg [7:0] latch = 8'h00;\n\n    always @(posedge SRCLK or negedge SRCLR_n)\n        if (!SRCLR_n) shift <= 8'h00;\n        else shift <= {shift[6:0], SER};\n\n    always @(posedge RCLK)\n        latch <= shift;\n\n    assign {QH, QG, QF, QE, QD, QC, QB, QA} = OE_n ? 8'bzzzzzzzz : latch;\n    assign QH_prime = shift[7];\nendmodule\n",
    "cores/ic74x595/tb/ic74x595_tb.v" : "// Self-checking testbench for ic74x595: 800 steps of pseudo-random shift clocks, latch clocks,\n// clears and output enables against a reference shift register and latch; the outputs float while\n// OE_n is high, QH_prime never does.\n\n`timescale 1ns / 1ps\n\nmodule ic74x595_tb;\n    reg ser = 0, srclk = 0, srclr_n = 0, rclk = 0, oe_n = 1;\n    wire [7:0] q;\n    wire qh_prime;\n\n    ic74x595 dut (.SER(ser), .SRCLK(srclk), .SRCLR_n(srclr_n), .RCLK(rclk), .OE_n(oe_n),\n                  .QA(q[0]), .QB(q[1]), .QC(q[2]), .QD(q[3]), .QE(q[4]), .QF(q[5]), .QG(q[6]), .QH(q[7]),\n                  .QH_prime(qh_prime));\n\n    reg [7:0] shift = 8'h00, latch = 8'h00;\n    reg [15:0] lfsr = 16'hB5C3;\n    integer i, errors = 0;\n\n    task check(input [255:0] what);\n        if (q !== (oe_n ? 8'bzzzzzzzz : latch) || qh_prime !== shift[7]) begin\n            $display(\"FAIL: %0s: QH..QA=%b QH'=%b, expected %b %b (OE_n=%b, t=%0t)\", what, q, qh_prime,\n                     oe_n ? 8'bzzzzzzzz : latch, shift[7], oe_n, $time);\n            errors = errors + 1;\n        end\n    endtask\n\n    initial begin\n        #5 srclr_n = 1;\n        for (i = 0; i < 800; i = i + 1) begin\n            lfsr = {lfsr[14:0], lfsr[15] ^ lfsr[13] ^ lfsr[12] ^ lfsr[10]};\n            ser = lfsr[1];\n            oe_n = lfsr[6] & lfsr[8];          // enabled most of the time\n            #1 check(\"output enable\");\n            #2 srclk = 1;                       // a shift every step\n            shift = {shift[6:0], ser};\n            #1 check(\"after a shift\");\n            #2 srclk = 0;\n            if (lfsr[4] & lfsr[10]) begin       // a latch clock now and then\n                #1 rclk = 1;\n                latch = shift;\n                #1 check(\"after a latch\");\n                #2 rclk = 0;\n            end\n            if (lfsr[12:11] == 2'b11 && lfsr[3]) begin   // a clear between edges: the latches keep theirs\n                #1 srclr_n = 0;\n                shift = 8'h00;\n                #1 check(\"clear\");\n                #2 srclr_n = 1;\n            end\n        end\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #10000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "cores/ic74x74/README.md" : "# 74x74 — dual D flip-flop\n\nTwo positive-edge D flip-flops, each with an asynchronous preset and clear (active low), as in the\n74LS74 and 74HC74. Preset and clear low together drive both outputs high, like the real part.\nUsed by GateLab's KiCad import (package pin table in `core.json`).\n\nOn an FPGA, asynchronous preset/clear and flip-flops clocked by logic signals are fragile: the import\nreport points them out.\n",
    "cores/ic74x74/core.json" : "{\n  \"description\" : \"Two D flip-flops with asynchronous preset and clear (74LS74, 74HC74 …), with the package pin table for the KiCad import.\",\n  \"families\" : {\n    \"ecp5\" : {\n      \"device\" : \"45k\",\n      \"tested\" : false\n    },\n    \"gatemate\" : {\n      \"device\" : \"CCGM1A1\",\n      \"fmaxMHz\" : 234.5,\n      \"resources\" : {\n        \"CPE_BRIDGE\" : 3,\n        \"CPE_CPLINES\" : 8,\n        \"CPE_FF\" : 12,\n        \"CPE_LT\" : 26\n      },\n      \"tested\" : true\n    },\n    \"gowin\" : {\n      \"device\" : \"GW1NR-LV9QN88PC6/I5\",\n      \"tested\" : false\n    },\n    \"ice40\" : {\n      \"device\" : \"up5k\",\n      \"tested\" : false\n    }\n  },\n  \"id\" : \"ic74x74\",\n  \"keywords\" : [\n    \"74xx\",\n    \"7474\",\n    \"flip-flop\",\n    \"register\",\n    \"d\",\n    \"ttl\",\n    \"kicad\"\n  ],\n  \"licence\" : \"CC0-1.0\",\n  \"localized\" : {\n    \"de\" : {\n      \"description\" : \"Zwei D-Flipflops mit asynchronem Setzen und Löschen (74LS74, 74HC74 …), mit der Pin-Tabelle des Gehäuses für den KiCad-Import.\",\n      \"name\" : \"74x74 zweifaches D-Flipflop\"\n    }\n  },\n  \"name\" : \"74x74 dual D flip-flop\",\n  \"ports\" : [\n    {\n      \"description\" : \"Flip-flop 1, data\",\n      \"dir\" : \"in\",\n      \"name\" : \"D1\"\n    },\n    {\n      \"description\" : \"Flip-flop 1, clock (rising edge)\",\n      \"dir\" : \"in\",\n      \"name\" : \"CLK1\"\n    },\n    {\n      \"description\" : \"Flip-flop 1, asynchronous preset, active low\",\n      \"dir\" : \"in\",\n      \"name\" : \"PRE1_n\"\n    },\n    {\n      \"description\" : \"Flip-flop 1, asynchronous clear, active low\",\n      \"dir\" : \"in\",\n      \"name\" : \"CLR1_n\"\n    },\n    {\n      \"description\" : \"Flip-flop 1, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q1\"\n    },\n    {\n      \"description\" : \"Flip-flop 1, inverted output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q1_n\"\n    },\n    {\n      \"description\" : \"Flip-flop 2, data\",\n      \"dir\" : \"in\",\n      \"name\" : \"D2\"\n    },\n    {\n      \"description\" : \"Flip-flop 2, clock (rising edge)\",\n      \"dir\" : \"in\",\n      \"name\" : \"CLK2\"\n    },\n    {\n      \"description\" : \"Flip-flop 2, asynchronous preset, active low\",\n      \"dir\" : \"in\",\n      \"name\" : \"PRE2_n\"\n    },\n    {\n      \"description\" : \"Flip-flop 2, asynchronous clear, active low\",\n      \"dir\" : \"in\",\n      \"name\" : \"CLR2_n\"\n    },\n    {\n      \"description\" : \"Flip-flop 2, output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q2\"\n    },\n    {\n      \"description\" : \"Flip-flop 2, inverted output\",\n      \"dir\" : \"out\",\n      \"name\" : \"Q2_n\"\n    }\n  ],\n  \"schema\" : 1,\n  \"schematic\" : {\n    \"asyncInputs\" : [\n      \"PRE1_n\",\n      \"CLR1_n\",\n      \"PRE2_n\",\n      \"CLR2_n\"\n    ],\n    \"clocks\" : [\n      \"CLK1\",\n      \"CLK2\"\n    ],\n    \"parts\" : [\n      \"74x74\"\n    ],\n    \"pins\" : {\n      \"1\" : \"CLR1_n\",\n      \"10\" : \"PRE2_n\",\n      \"11\" : \"CLK2\",\n      \"12\" : \"D2\",\n      \"13\" : \"CLR2_n\",\n      \"2\" : \"D1\",\n      \"3\" : \"CLK1\",\n      \"4\" : \"PRE1_n\",\n      \"5\" : \"Q1\",\n      \"6\" : \"Q1_n\",\n      \"8\" : \"Q2_n\",\n      \"9\" : \"Q2\"\n    }\n  },\n  \"top\" : \"ic74x74\",\n  \"version\" : \"1.0.1\"\n}\n",
    "cores/ic74x74/rtl/ic74x74.v" : "// 74x74: dual D flip-flop with asynchronous preset and clear, both active low (74LS74, 74HC74 …).\n// With preset and clear low together both outputs are high, as on the real part.\n// Pins: 1CLR 1D 1CLK 1PRE 1Q 1Q_n = 1 2 3 4 5 6, 2Q_n 2Q 2PRE 2CLK 2D 2CLR = 8 9 10 11 12 13.\n\n`timescale 1ns / 1ps\n\nmodule ic74x74 (\n    input  wire D1,\n    input  wire CLK1,\n    input  wire PRE1_n,\n    input  wire CLR1_n,\n    output wire Q1,\n    output wire Q1_n,\n    input  wire D2,\n    input  wire CLK2,\n    input  wire PRE2_n,\n    input  wire CLR2_n,\n    output wire Q2,\n    output wire Q2_n\n);\n    reg q1 = 1'b0;\n    reg q2 = 1'b0;\n\n    always @(posedge CLK1 or negedge PRE1_n or negedge CLR1_n)\n        if (!CLR1_n) q1 <= 1'b0;\n        else if (!PRE1_n) q1 <= 1'b1;\n        else q1 <= D1;\n\n    always @(posedge CLK2 or negedge PRE2_n or negedge CLR2_n)\n        if (!CLR2_n) q2 <= 1'b0;\n        else if (!PRE2_n) q2 <= 1'b1;\n        else q2 <= D2;\n\n    assign Q1   = q1 | (!PRE1_n && !CLR1_n);\n    assign Q1_n = ~q1 | (!PRE1_n && !CLR1_n);\n    assign Q2   = q2 | (!PRE2_n && !CLR2_n);\n    assign Q2_n = ~q2 | (!PRE2_n && !CLR2_n);\nendmodule\n",
    "cores/ic74x74/tb/ic74x74_tb.v" : "// Self-checking testbench for ic74x74: clocking data in, asynchronous preset and clear (also\n// between clock edges), both together, and that the two flip-flops don't influence each other.\n\n`timescale 1ns / 1ps\n\nmodule ic74x74_tb;\n    reg d1 = 0, clk1 = 0, pre1 = 1, clr1 = 1;\n    reg d2 = 0, clk2 = 0, pre2 = 1, clr2 = 1;\n    wire q1, q1_n, q2, q2_n;\n\n    ic74x74 dut (.D1(d1), .CLK1(clk1), .PRE1_n(pre1), .CLR1_n(clr1), .Q1(q1), .Q1_n(q1_n),\n                 .D2(d2), .CLK2(clk2), .PRE2_n(pre2), .CLR2_n(clr2), .Q2(q2), .Q2_n(q2_n));\n\n    integer errors = 0;\n    task check(input e1, input e1n, input e2, input e2n, input [8*24-1:0] what);\n        begin\n            #1;\n            if ({q1, q1_n, q2, q2_n} !== {e1, e1n, e2, e2n}) begin\n                $display(\"FAIL: %0s: Q1 Q1_n Q2 Q2_n = %b%b%b%b, expected %b%b%b%b\", what, q1, q1_n, q2, q2_n, e1, e1n, e2, e2n);\n                errors = errors + 1;\n            end\n        end\n    endtask\n\n    task tick1; begin #5 clk1 = 1; #5 clk1 = 0; end endtask\n    task tick2; begin #5 clk2 = 1; #5 clk2 = 0; end endtask\n\n    initial begin\n        clr1 = 0; clr2 = 0; #5 clr1 = 1; clr2 = 1;\n        check(0, 1, 0, 1, \"cleared\");\n        d1 = 1; tick1;           check(1, 0, 0, 1, \"1D=1 clocked\");\n        d2 = 1;                  check(1, 0, 0, 1, \"2D=1, no clock yet\");\n        tick2;                   check(1, 0, 1, 0, \"2D=1 clocked\");\n        d1 = 0; tick1;           check(0, 1, 1, 0, \"1D=0 clocked\");\n        #3 pre1 = 0;             check(1, 0, 1, 0, \"1PRE low, no clock\");\n        tick1;                   check(1, 0, 1, 0, \"1PRE holds against D=0\");\n        pre1 = 1;                check(1, 0, 1, 0, \"1PRE released\");\n        #3 clr2 = 0;             check(1, 0, 0, 1, \"2CLR low, no clock\");\n        clr2 = 1; pre1 = 0; clr1 = 0; check(1, 1, 0, 1, \"1PRE and 1CLR both low\");\n        pre1 = 1; clr1 = 1;\n        d1 = 1; tick1;           check(1, 0, 0, 1, \"after both released, 1D=1 clocked\");\n        if (errors == 0) $display(\"PASS\");\n        $finish;\n    end\n\n    // A broken model must not hang the simulation.\n    initial begin\n        #1000000;\n        $display(\"FAIL: timeout\");\n        $finish;\n    end\nendmodule\n",
    "pack.json" : "{\n  \"description\" : \"Verilog models of classic 7400-series logic parts for the KiCad schematic import: each with the datasheet's port names, its package pin table and a self-checking testbench. CC0 1.0: no conditions, no attribution needed.\",\n  \"documentation\" : \"https://github.com/richardklingler/fpgacores\",\n  \"id\" : \"gatelab.logic74xx\",\n  \"maintainer\" : \"GateLab\",\n  \"name\" : \"GateLab 74xx Logic\",\n  \"schema\" : 1,\n  \"type\" : \"library\",\n  \"version\" : \"1.5.0\"\n}\n"
  },
  "schema" : 1
}
